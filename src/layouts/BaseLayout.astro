---
// ============================================================
// [Code 层] BaseLayout — 全站顶栏、SEO、搜索与设计系统底座
// 继承自 frontend-design 与 ui-ux-pro-max 工业级规范
// ============================================================
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import { CHANNELS } from '../config/channels';
import JsonLd from '../components/JsonLd.astro';

const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const allCodes = await getCollection('codes', ({ data }) => !data.draft);

const searchItems = [
  ...allGuides.map((g) => ({
    title: g.data.title,
    description: g.data.description,
    url: `/guide/${g.id}/`,
    category: 'Guide',
  })),
  ...allCodes.map((c) => ({
    title: c.data.title,
    description: c.data.summary ?? c.data.title,
    url: `/codes/${c.id}/`,
    category: 'Codes',
  })),
];

interface Props {
  title?: string;
  description?: string;
  /** 相对路径，如 /guide/some-topic/ */
  canonical?: string;
  lang?: string;
  /** 本页面实际存在翻译的语言（双轨 hreflang：只为物理存在的翻译输出 alternate） */
  availableLocales?: string[];
  /** 页面级 JSON-LD 对象（Article/BreadcrumbList/FAQPage…），BaseLayout 只管全站级 */
  jsonLd?: Record<string, unknown>[];
}

const defaultDesc = `The definitive evidence-led encyclopedia for ${siteConfig.gameName}: discover verified strategy guides, walkthroughs, systems, and active reward codes.`;

const {
  title,
  description = defaultDesc,
  canonical = Astro.url.pathname,
  lang = siteConfig.defaultLocale,
  availableLocales = [],
  jsonLd = [],
} = Astro.props;

const siteUrl = siteConfig.siteUrl;
const fullTitle = title
  ? (title.endsWith(siteConfig.titleSuffix.trim()) ? title : `${title} ${siteConfig.titleSuffix}`)
  : `${siteConfig.siteName}: Strategy Guides & Databases`;
const ogImage = `${siteUrl}/og-cover.jpg`;

// 双轨 hreflang：绝不生成指向 404 的备用语言标签。
const stripLocale = (path: string) =>
  path.replace(new RegExp(`^/(${availableLocales.join('|')})`), '') || '/';
const isMultiLang = availableLocales.length > 1;

// 品牌拆分（首词高亮，如 DINOBLADE + WIKI）
const brandParts = siteConfig.siteName.split(' ');
const brandFirst = brandParts[0] ?? siteConfig.siteName;
const brandRest = brandParts.slice(1).join(' ') || 'WIKI';

---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={`${siteConfig.gameName}, Pixel Lineage wiki, Pixel Lineage codes, Pixel Lineage tier list, Pixel Lineage classes, super classes, ultra sigil, Roblox RPG, Goblin Merchant`} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {siteConfig.verification.googleSiteVerification && (
      <meta name="google-site-verification" content={siteConfig.verification.googleSiteVerification} />
    )}
    <link rel="canonical" href={`${siteUrl}${canonical}`} />

    <!-- Favicon & Touch Icons (Google 48px 倍数硬性标准) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    {/* 双轨 hreflang */}
    {isMultiLang ? (
      <>
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}${stripLocale(canonical)}`} />
        {siteConfig.locales.map((loc) => (
          <link
            rel="alternate"
            hreflang={loc}
            href={loc === siteConfig.defaultLocale
              ? `${siteUrl}${stripLocale(canonical)}`
              : `${siteUrl}/${loc}${stripLocale(canonical)}`}
          />
        ))}
      </>
    ) : (
      <>
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}${canonical}`} />
        <link rel="alternate" hreflang={siteConfig.defaultLocale} href={`${siteUrl}${canonical}`} />
      </>
    )}

    {/* Open Graph & Twitter */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${canonical}`} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />

    {siteConfig.ads.adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.ads.adsenseClient}`} crossorigin="anonymous"></script>
    )}

    {siteConfig.ads.gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.ads.gaMeasurementId}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${siteConfig.ads.gaMeasurementId}');
        `} />
      </>
    )}

    {siteConfig.verification?.googleSiteVerification && (
      <meta name="google-site-verification" content={siteConfig.verification.googleSiteVerification} />
    )}

    <!-- 全站级 JSON-LD：Organization + WebSite -->
    <JsonLd data={{
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: siteConfig.siteName,
      url: siteUrl,
      ...(siteConfig.officialLinks
        ? {
            sameAs: Object.values(siteConfig.officialLinks).filter(
              (url): url is string => typeof url === 'string' && url.length > 0
            ),
          }
        : {}),
    }} />
    <JsonLd data={{
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.siteName,
      url: siteUrl,
    }} />
    {jsonLd.map((data) => <JsonLd data={data} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand">
          <svg class="brand-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.5" fill="currentColor"/><circle cx="16" cy="8" r="1.5" fill="currentColor"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/><circle cx="8" cy="16" r="1.5" fill="currentColor"/><circle cx="16" cy="16" r="1.5" fill="currentColor"/></svg>
          <span class="brand-accent">{brandFirst}</span> <span class="brand-text">{brandRest}</span>
          <span class="brand-badge">TACTICAL DOSSIER</span>
        </a>

        <!-- 移动端汉堡切换按钮 -->
        <button type="button" class="mobile-nav-toggle" id="mobile-nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
          <svg class="hamburger-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          <svg class="close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <!-- 顶级导航栏：与 CHANNELS 知识树 1:1 对齐 -->
        <nav class="nav-links" id="main-nav" aria-label="Main Navigation">
          {CHANNELS.map((ch) => {
            const isActive = canonical.startsWith(ch.url) || ch.guides.some((g) => canonical.includes(g.id));
            return (
              <div class="nav-item has-dropdown">
                <a href={ch.url} class={`nav-trigger ${isActive ? 'active' : ''}`} aria-haspopup="true">
                  <span>{ch.shortTitle}</span>
                  {ch.id === 'codes' && <span class="nav-pill-badge">ACTIVE</span>}
                  <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </a>
                <div class="dropdown-menu single-menu" role="menu">
                  <div class="dropdown-col-title">{ch.title.toUpperCase()}</div>
                  {ch.guides.map((g) => (
                    <a href={g.url} class="dropdown-card" role="menuitem">
                      <div class="card-icon-svg">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
                      </div>
                      <div class="card-body">
                        <div class="card-title">{g.title}</div>
                      </div>
                    </a>
                  ))}
                  <div class="dropdown-footer">
                    <a href={ch.url} class="dropdown-hub-link">
                      {ch.shortTitle} Hub & Database →
                    </a>
                  </div>
                </div>
              </div>
            );
          })}

          <!-- Global Search Trigger Button -->
          <button type="button" class="search-btn search-trigger-btn" id="search-trigger" aria-label="Open search dialog">
            <div class="search-btn-left">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <span>Search</span>
            </div>
            <kbd class="search-kbd">⌘K</kbd>
          </button>

          {siteConfig.officialLinks?.roblox && (
            <a href={siteConfig.officialLinks.roblox} target="_blank" rel="noopener noreferrer" class="steam-link" aria-label="Play Pixel Lineage on Roblox">
              <span class="steam-link-full">Play on Roblox ↗</span>
              <span class="steam-link-short">Play ↗</span>
            </a>
          )}
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- 全局 Footer 对称深层矩阵 (Mega Footer) -->
    <footer class="site-mega-footer">
      <div class="footer-inner">
        <div class="footer-grid">
          <!-- Col 1: 站点描述与合规免责声明 -->
          <div class="footer-col brand-col">
            <a href="/" class="footer-brand">
              <svg class="brand-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.5" fill="currentColor"/><circle cx="16" cy="8" r="1.5" fill="currentColor"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/><circle cx="8" cy="16" r="1.5" fill="currentColor"/><circle cx="16" cy="16" r="1.5" fill="currentColor"/></svg>
              <span class="brand-accent">{brandFirst}</span> <span class="brand-text">{brandRest}</span>
            </a>
            <p class="footer-desc">
              The definitive evidence-led encyclopedia and tactical database for {siteConfig.gameName}. Verified strategy guides, mechanics, and game data.
            </p>
            <p class="footer-disclaimer">
              *{siteConfig.siteName} is an independent, fan-made resource. Not affiliated with or endorsed by official game developers or publishers. Game content and materials are trademarks of their respective owners.*
            </p>
          </div>

          <!-- Col 2: 全站频道分类 (Categories) -->
          <div class="footer-col">
            <h4 class="footer-heading">CATEGORIES</h4>
            <ul class="footer-nav-list">
              {CHANNELS.map((ch) => (
                <li><a href={ch.url}>{ch.title}</a></li>
              ))}
            </ul>
          </div>

          <!-- Col 3: 重点攻略平铺 (Featured Guides) -->
          <div class="footer-col">
            <h4 class="footer-heading">FEATURED GUIDES</h4>
            <ul class="footer-nav-list">
              {allGuides.slice(0, 6).map((g) => (
                <li><a href={`/guide/${g.id}/`}>{g.data.title}</a></li>
              ))}
              {allCodes.slice(0, 1).map((c) => (
                <li><a href={`/codes/${c.id}/`}>{c.data.title}</a></li>
              ))}
            </ul>
          </div>

          <!-- Col 4: 资源与官方社区 (Resources & Community) -->
          <div class="footer-col">
            <h4 class="footer-heading">RESOURCES & OFFICIAL</h4>
            <ul class="footer-nav-list">
              <li><a href="/about/">About This Wiki</a></li>
              <li><a href="/contact/">Editorial Contact</a></li>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/sitemap-index.xml">XML Sitemap</a></li>
              {siteConfig.officialLinks && Object.values(siteConfig.officialLinks).some(Boolean) && (
                <li class="footer-divider-item"></li>
              )}
              {siteConfig.officialLinks?.steam && (
                <li><a href={siteConfig.officialLinks.steam} target="_blank" rel="noopener noreferrer">Steam Store Page ↗</a></li>
              )}
              {siteConfig.officialLinks?.discord && (
                <li><a href={siteConfig.officialLinks.discord} target="_blank" rel="noopener noreferrer">Official Discord ↗</a></li>
              )}
              {siteConfig.officialLinks?.youtube && (
                <li><a href={siteConfig.officialLinks.youtube} target="_blank" rel="noopener noreferrer">Official YouTube ↗</a></li>
              )}
            </ul>
          </div>
        </div>

        <div class="footer-bottom-bar">
          <p class="copyright-text">© {new Date().getFullYear()} {siteConfig.siteName}. All verified guides and database content are evidence-led.</p>
        </div>
      </div>
    </footer>

    <!-- Search Modal Dialog -->
    <div class="search-modal-backdrop" id="search-modal" role="dialog" aria-modal="true" aria-label="Search Wiki">
      <div class="search-modal">
        <div class="search-modal-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="search-input" class="search-input" placeholder="Search guides, bosses, weapons, codes..." autocomplete="off" />
          <button type="button" class="search-close-btn" id="search-close" aria-label="Close search">✕</button>
        </div>
        <div class="search-results-list" id="search-results">
          <!-- Injected via client script -->
        </div>
        <div class="search-footer-hints">
          <span>Navigate with arrows · Press ESC to close</span>
          <span>{searchItems.length} verified items indexed</span>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ searchItems }}>
      const modal = document.getElementById('search-modal');
      const trigger = document.getElementById('search-trigger');
      const closeBtn = document.getElementById('search-close');
      const input = document.getElementById('search-input');
      const resultsContainer = document.getElementById('search-results');

      function renderResults(q) {
        const query = (q || '').toLowerCase().trim();
        const filtered = query
          ? searchItems.filter(item => item.title.toLowerCase().includes(query) || item.description.toLowerCase().includes(query))
          : searchItems;

        if (filtered.length === 0) {
          resultsContainer.innerHTML = '<div style="padding: 24px; text-align: center; color: var(--muted); font-size: 0.9rem;">No matching guides found</div>';
          return;
        }

        resultsContainer.innerHTML = filtered.map(item => `
          <a href="${item.url}" class="search-result-item">
            <div class="search-result-title">${item.title}</div>
            <div class="search-result-desc">${item.description}</div>
          </a>
        `).join('');
      }

      function openSearch() {
        if (!modal) return;
        modal.classList.add('is-open');
        input?.focus();
        renderResults(input ? input.value : '');
      }

      function closeSearch() {
        if (!modal) return;
        modal.classList.remove('is-open');
        if (input) input.value = '';
      }

      trigger?.addEventListener('click', openSearch);
      document.querySelectorAll('.search-trigger-btn').forEach(btn => btn.addEventListener('click', openSearch));
      closeBtn?.addEventListener('click', closeSearch);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeSearch();
      });
      input?.addEventListener('input', (e) => renderResults(e.target.value));

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          modal?.classList.contains('is-open') ? closeSearch() : openSearch();
        } else if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
          closeSearch();
        }
      });

      // 移动端菜单切换
      const navToggle = document.getElementById('mobile-nav-toggle');
      const mainNav = document.getElementById('main-nav');
      if (navToggle && mainNav) {
        navToggle.addEventListener('click', () => {
          const isOpen = mainNav.classList.toggle('mobile-open');
          navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          const hamburger = navToggle.querySelector('.hamburger-icon');
          const close = navToggle.querySelector('.close-icon');
          if (hamburger && close) {
            hamburger.style.display = isOpen ? 'none' : 'block';
            close.style.display = isOpen ? 'block' : 'none';
          }
        });
      }
    </script>
  </body>
</html>
