---
export interface Props {
  id: string;
  title: string;
  description?: string;
  uploadDate?: string;
  channelTitle?: string;
  channel?: string;
  captionLabel?: string;
  eager?: boolean;
}

const {
  id,
  title,
  description = "Verified Pixel Lineage gameplay walkthrough and strategy showcase footage.",
  uploadDate = "2026-10-18T12:00:00+00:00",
  channelTitle = Astro.props.channel || "OyO",
  captionLabel = "Official Video Reference",
  eager = true
} = Astro.props;

// Google VideoObject requires full ISO 8601 datetime WITH timezone
const rawUploadDate = uploadDate;
const uploadDateIso = /^\d{4}-\d{2}-\d{2}$/.test(rawUploadDate.trim())
  ? `${rawUploadDate.trim()}T00:00:00+00:00`
  : rawUploadDate;

const embedParams = `autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&modestbranding=1&playsinline=1`;
const embedUrl = `https://www.youtube.com/embed/${id}?${embedParams}`;
const thumbnailUrl = `https://img.youtube.com/vi/${id}/maxresdefault.jpg`;

const schema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": title,
  "description": description,
  "thumbnailUrl": [thumbnailUrl],
  "uploadDate": uploadDateIso,
  "embedUrl": `https://www.youtube.com/embed/${id}`
};
---

<div class="video-embed-wrapper" data-video-id={id} style="margin: 24px 0 32px;">
  <!-- 16:9 Zero-CLS Aspect Ratio Container with Standard Autoplay -->
  <div
    class="video-container"
    style="position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); background: #000; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);"
  >
    <iframe
      src={embedUrl}
      title={title}
      width="100%"
      height="100%"
      style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading={eager ? "eager" : "lazy"}
    ></iframe>
  </div>
  <p class="video-embed-caption" style="font-size: 0.82rem; color: var(--muted); margin: 8px 0 0; text-align: center;">
    {captionLabel}: <span class="video-title" style="color: #f5f3ff; font-weight: 600;">{title}</span> <span class="video-channel" style="color: var(--accent);">· {channelTitle}</span>
  </p>

  <!-- VideoObject JSON-LD for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</div>
