---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
}

const {
  items,
  title = "Frequently Asked Questions"
} = Astro.props;
---

<section id="faq" class="guide-section" style="margin-top: 3rem;">
  <h2 style="margin-bottom: 1rem; font-size: 1.3rem; color: var(--ink);">{title}</h2>
  <div class="faq-accordion" style="display: flex; flex-direction: column; gap: 1rem;">
    {items.map((item) => (
      <details class="faq-card" style="padding: 1rem 1.25rem; background: var(--panel-card); border: 1px solid var(--line); border-radius: 6px;">
        <summary style="font-weight: 600; cursor: pointer; color: var(--ink); font-size: 1rem; list-style-position: inside;">
          {item.question}
        </summary>
        <p style="margin: 0.75rem 0 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6;">
          {item.answer}
        </p>
      </details>
    ))}
  </div>
</section>
