---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";

const energyCosts = [
  {
    action: "Basic Strike / Weapon Swing",
    cost: "1 Energy Point",
    tacticalUse: "Standard filler turn; generates 5% Poise damage and 10 MP on spellcaster builds.",
  },
  {
    action: "Core Super Class Skill (e.g. Shield Bash, Backstab)",
    cost: "2 Energy Points",
    tacticalUse: "Primary combat action dealing 1.8x to 2.4x weapon damage and applying status ailments.",
  },
  {
    action: "Heavy Cleave / AoE Ultimate Spell (e.g. Arcane Nova)",
    cost: "3 Energy Points",
    tacticalUse: "High-impact turn decider; consumes full energy reserve unless running Arcane Spark or Thief refunds.",
  },
  {
    action: "Consumable Potion Use",
    cost: "1 Energy Point",
    tacticalUse: "Drinking health or mana potions consumes 1 Energy, allowing players to heal and still execute a basic strike.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Energy Guide: Turn Economy & Action Costs",
    description: "Complete Pixel Lineage energy guide: starting energy pools, skill action costs, energy regen formulas, and turn economy optimization for all 6 classes.",
    url: `${siteConfig.siteUrl}/combat/energy/`,
    datePublished: "2026-10-18T12:00:00Z",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Combat", item: `${siteConfig.siteUrl}/combat/` },
      { "@type": "ListItem", position: 3, name: "Energy System", item: `${siteConfig.siteUrl}/combat/energy/` },
    ],
  },
];

import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);
---


<BaseLayout
  title="Pixel Lineage Energy: Turn Economy"
  description="Complete Pixel Lineage energy guide: starting energy pools, skill action costs, energy regen formulas, and turn economy optimization for all 6 classes."
  canonical="/combat/energy/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Energy System</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(56, 189, 248, 0.15); border: 1px solid #38bdf8; color: #38bdf8; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Core Turn-Based Action Resource
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Energy Guide: Turn Economy & Action Costs
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        Authoritative manual on Energy points and turn economy in Pixel Lineage on Roblox. We analyze starting energy budgets, skill activation thresholds, refund talents, and how to execute multi-action turns in Torment dungeons.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />

    <!-- Unique Hero Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/features/feature_energy.webp"
        alt="Pixel Lineage Combat Energy System Action Costs and Turn Economy Multipliers"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
      <!-- Summary Callout -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #38bdf8; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="energy-the-core-currency-of-battle-turns" style="font-size: 1.25rem; color: #38bdf8; margin: 0 0 12px;">Energy: The Core Currency of Battle Turns</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          Unlike real-time action games where cooldowns govern skill rotations, Pixel Lineage operates on a discrete <strong>Energy Pool</strong>. Characters begin every standard turn with 3 Energy Points (EP). Every action—from drinking a health potion to casting a 3-cost ultimate spell—deducts points from this pool. Once energy reaches 0, your turn automatically ends.
        </p>
      </section>

      <!-- Energy Costs Table -->
      <section style="margin-bottom: 40px;">
        <h2 id="action-costs-resource-allocation" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">Action Costs & Resource Allocation</h2>
        <div style="overflow-x: auto; background: #161022; border: 1px solid var(--line); border-radius: 8px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead>
              <tr style="border-bottom: 1px solid var(--line); background: #1d152c;">
                <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Combat Action</th>
                <th style="padding: 14px 16px; color: #38bdf8; font-weight: 600;">Energy Cost</th>
                <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Strategic Purpose</th>
              </tr>
            </thead>
            <tbody>
              {energyCosts.map((e) => (
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                  <td style="padding: 14px 16px; font-weight: 700; color: #fff;">{e.action}</td>
                  <td style="padding: 14px 16px; font-family: var(--font-mono); color: #34d399; font-weight: 700;">{e.cost}</td>
                  <td style="padding: 14px 16px; color: var(--muted); font-size: 0.88rem;">{e.tacticalUse}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Advanced Turn Manipulation: Action Surges & Refunds -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="mastering-action-economy-gaining-extra-energy" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Mastering Action Economy: Gaining Extra Energy</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Top players conquer high-Torment dungeons by manipulating the energy engine to exceed the standard 3-energy cap:
        </p>
        <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 0;">
          <li style="margin-bottom: 10px;">
            <strong style="color: #38bdf8;">Arcane Spark Talent (+1 Starting Energy):</strong> Starting each battle with 4 Energy allows Mages to cast an immediate Tier-2 Shield (1 EP) and an AoE Flame Burst (3 EP) on turn one before enemies can spread out.
          </li>
          <li style="margin-bottom: 10px;">
            <strong style="color: #34d399;">Thief Critical Refund (Shadowstalker Set):</strong> Landing critical strikes has a 10% chance to immediately refund 1 Energy point, enabling chain-combo turns of up to 5 consecutive strikes.
          </li>
          <li>
            <strong style="color: #eab308;">Bard Anthem Acceleration:</strong> Troubadour bards can cast Hymn of Haste, granting adjacent allies +1 bonus Energy point on their next action phase.
          </li>
        </ul>
      </section>

      <!-- Navigation -->
      <section style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
        <h3 id="explore-further-combat-systems" style="font-size: 1.1rem; color: #fff; margin: 0 0 10px;">Explore Further Combat Systems</h3>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="/calculator/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → Simulate Action Turn Cycles in Calculator
          </a>
          <a href="/classes/super-classes/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → 18 Super Class Skill Energy Costs
          </a>
          <a href="/traits/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → Traits & Talents Full Drop Rates
          </a>
        </div>
      </section>
    </article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/combat/energy/" />
    </div>
  </div>
</BaseLayout>
