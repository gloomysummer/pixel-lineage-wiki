---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import FaqSection from "../../components/FaqSection.astro";

const oaths = [
  {
    name: "Oath of the Vanguard",
    affinity: "Warrior / Fist Archetypes",
    pledgeCost: "1,500 Gold & 100 Guild Tokens",
    permanentBuff: "+15% Physical DR when within 2 tiles of guild allies; 10% Chance to counter melee attacks.",
    drawback: "-10% Movement speed in open exploration maps.",
  },
  {
    name: "Oath of the Arcanum",
    affinity: "Mage / Bard Archetypes",
    pledgeCost: "2,000 Gold & 120 Guild Tokens",
    permanentBuff: "+20% Maximum Mana Pool; spells restore 5% HP to lowest-health ally upon critical cast.",
    drawback: "Takes 15% increased physical damage from brute enemies.",
  },
  {
    name: "Oath of the Shadowveil",
    affinity: "Thief / Archer Archetypes",
    pledgeCost: "1,800 Gold & 110 Guild Tokens",
    permanentBuff: "+12% Critical Strike Rate and immunity to movement-impairing snares in guild dungeons.",
    drawback: "Healing received from external potions reduced by 25%.",
  },
];

const faqItems = [
  {
    question: "What are Oaths in Pixel Lineage?",
    answer: "Oaths are permanent guild pledges sworn at the Guild Hall altar upon reaching Reputation Tier 2. Each Oath grants distinct combat passives—like Vanguard's +15% Physical DR or Shadowveil's +12% Crit—at the expense of a tactical drawback."
  },
  {
    question: "Can you change or renounce an Oath in Pixel Lineage?",
    answer: "Yes. Players can renounce their active Oath at the Guild Altar by paying a renunciation fee of 1,000 Gold. Once renounced, character stats revert to baseline, and you may pledge to a different oath immediately provided you have sufficient tokens."
  },
  {
    question: "How do you earn Guild Tokens to pledge an Oath?",
    answer: "Guild Tokens are awarded by participating in weekly Guild Raids, completing daily Castle Repair supply turn-ins, and winning ranked matches in the Castle Arena."
  },
  {
    question: "Do Guild Oath buffs apply in solo Torment dungeons?",
    answer: "Yes. Passive stat bonuses from sworn Oaths remain permanently active across both solo exploration and co-op dungeons, though proximity-based auras like Vanguard require nearby allies to trigger full damage reduction."
  }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    datePublished: "2026-10-18T12:00:00+00:00",
    headline: "Pixel Lineage Oaths Guide: Guild Pledges & Buffs",
    description: "Complete Pixel Lineage Oaths guide: pledge costs, permanent character stat buffs, trade-offs, and optimal class alignment in guild raids.",
    url: `${siteConfig.siteUrl}/guilds/oaths/`,
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Guilds", item: `${siteConfig.siteUrl}/guilds/` },
      { "@type": "ListItem", position: 3, name: "Oaths", item: `${siteConfig.siteUrl}/guilds/oaths/` },
    ],
  },
];

import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);
---


<BaseLayout
  title="Pixel Lineage Oaths Guide: Guild Pledges & Buffs"
  description="Complete Pixel Lineage Oaths guide: pledge costs, permanent character stat buffs, trade-offs, and optimal class alignment in guild raids."
  canonical="/guilds/oaths/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/guilds/" style="color: var(--accent); text-decoration: none;">Guilds</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Oaths</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(201, 162, 39, 0.15); border: 1px solid #c9a227; color: #c9a227; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Guild Alignment & Blood Pledges
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Guild Oaths & Pledges Guide
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0 0 16px;">
        Guild Oaths provide permanent passives and role specializations in Pixel Lineage. Sworn at the Guild Hall altar, each Oath grants potent raid buffs accompanied by tactical trade-offs.
      </p>

      <!-- Direct Answer Summary Box -->
      <div style="background: rgba(201, 162, 39, 0.1); border-left: 4px solid #c9a227; padding: 14px 18px; border-radius: 0 8px 8px 0; margin-bottom: 8px;">
        <div style="font-size: 0.82rem; font-family: var(--font-mono); color: #c9a227; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">
          ⚡ Direct Answer · Guild Oaths Overview
        </div>
        <p style="margin: 0; font-size: 0.94rem; color: #f0eaf4; line-height: 1.6;">
          <strong>Pixel Lineage Oaths</strong> are permanent character pledges sworn at the Guild Hall altar upon reaching Reputation Tier 2. Pledging costs 1,500–2,000 Gold plus 100–120 Guild Tokens. The three oaths (<strong>Vanguard</strong> for physical tanks, <strong>Arcanum</strong> for mana casters, and <strong>Shadowveil</strong> for crit assassins) grant encounter-defining buffs balanced with targeted tactical drawbacks.
        </p>
      </div>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
      <!-- Mechanics Summary -->
      

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" /><section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #c9a227; border-radius: 8px; padding: 20px; margin-bottom: 32px;">
        <h2 id="how-oaths-function-in-guild-warfare" style="margin: 0 0 8px; font-size: 1.2rem; color: #c9a227;">How Oaths Function in Guild Warfare</h2>
        <p style="color: var(--muted); font-size: 0.95rem; margin: 0;">
          Upon reaching Guild Reputation Tier 2, characters can bind their lineage to one of three ancient oaths. Swearing an oath requires contributing gold and raid tokens earned from Castle Sieges and Guild Raids. An oath remains active until explicitly renounced at the Guild Altar for a penalty fee.
        </p>
      </section>

      <!-- 3 Oaths Breakdown -->
      <section style="margin-bottom: 36px;">
        <h2 id="the-three-ancient-guild-oaths" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">The Three Ancient Guild Oaths</h2>
        <div style="display: flex; flex-direction: column; gap: 20px;">
          {oaths.map((o) => (
            <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
                <h3 id="o-name" style="font-size: 1.25rem; color: #fff; margin: 0;">{o.name}</h3>
                <span style="font-size: 0.8rem; background: #0d0a14; color: var(--accent); padding: 3px 10px; border-radius: 4px; border: 1px solid var(--line);">
                  {o.affinity}
                </span>
              </div>
              <div style="font-size: 0.88rem; color: #c9a227; margin-bottom: 8px;">
                <strong>Pledge Cost:</strong> {o.pledgeCost}
              </div>
              <div style="font-size: 0.92rem; color: #34d399; margin-bottom: 6px;">
                <strong>Permanent Buff:</strong> {o.permanentBuff}
              </div>
              <div style="font-size: 0.88rem; color: #f43f5e; background: #0d0a14; padding: 8px 12px; border-radius: 6px;">
                <strong>Tactical Drawback:</strong> {o.drawback}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Tactical Advice -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="guild-oath-optimization-strategies" style="font-size: 1.3rem; color: var(--ink); margin: 0 0 14px;">Guild Oath Optimization Strategies</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
          To maximize party raid effectiveness, guilds should maintain a balanced distribution of oaths across their 4-player raid teams:
        </p>
        <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 0;">
          <li><strong>Frontline Tanks:</strong> Sentinel Warriors should pledge Oath of the Vanguard to stack physical damage reduction.</li>
          <li><strong>Dedicated Healers:</strong> Clerics benefit most from Oath of the Arcanum, as bonus mana extends healing duration against high-HP raid bosses.</li>
          <li><strong>Burst DPS:</strong> Assassins and Snipers should pledge Oath of the Shadowveil to lock in critical strike thresholds.</li>
        </ul>
      </section>

      <!-- Navigation & Links -->
      <section style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
        <h3 id="guild-system-navigation" style="font-size: 1.1rem; color: var(--ink); margin: 0 0 10px;">Guild System Navigation</h3>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="/guilds/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            ← Return to Guilds & Castle Overview
          </a>
          <a href="/classes/super-classes/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → 18 Super Class Synergies
          </a>
          <a href="/adventures/torment/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → Torment Mode Challenge Guide
          </a>
        </div>
      </section>
      <!-- Frequently Asked Questions Accordion -->
      <FaqSection items={faqItems} />

      <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/guilds/oaths/" />
    </div>
  </div>
</BaseLayout>
