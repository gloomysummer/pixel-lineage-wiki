---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";

const castleWings = [
  {
    wing: "Priority 1: The Guild Altar & Sanctum",
    repairCost: "1,200 Timber, 800 Stone Blocks, 2,500 Guild Gold",
    unlockedBuffs: "Unlocks Guild Oaths (Vanguard, Arcanum, Shadowveil) granting permanent role passives.",
    whyFirst: "Oaths provide immediate character stat multipliers that make all subsequent dungeon crawling 20% faster.",
  },
  {
    wing: "Priority 2: The Castle Forge & Anvil",
    repairCost: "2,000 Iron Ingots, 1,000 Stone Blocks, 4,000 Guild Gold",
    unlockedBuffs: "Enables Tier-2 and Tier-3 equipment reinforcement up to +5 Quality; unlocks gem slotting.",
    whyFirst: "Allows party members to upgrade armor defense to 65+ DEF, hitting the 50% physical mitigation soft cap.",
  },
  {
    wing: "Priority 3: The Guild Vault & Treasury",
    repairCost: "3,000 Hardwood, 2,500 Granite Blocks, 8,000 Guild Gold",
    unlockedBuffs: "Expands shared guild bank to 50 slots; unlocks the Ultra Sigil Shard exchange merchant.",
    whyFirst: "Crucial for hoarding raid loot and allowing members to pool resources for high-tier crafting.",
  },
  {
    wing: "Priority 4: The Colosseum & Dueling Arena",
    repairCost: "4,500 Marble Blocks, 3,000 Iron Ingots, 12,000 Guild Gold",
    unlockedBuffs: "Restores the 1v1 PvP Arena; unlocks seasonal rating brackets and the Glory Shop.",
    whyFirst: "Endgame feature intended for max-level characters seeking competitive duels and vanity auras.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Castle Repair: Upgrade Order & Costs",
    description: "Complete Pixel Lineage castle repair guide: priority upgrade order, material costs, Guild Hall buffs, Arena restoration, and vault expansion benefits.",
    url: `${siteConfig.siteUrl}/guilds/castle-repair/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Guilds", item: `${siteConfig.siteUrl}/guilds/` },
      { "@type": "ListItem", position: 3, name: "Castle Repair", item: `${siteConfig.siteUrl}/guilds/castle-repair/` },
    ],
  },
];

import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);
---


<BaseLayout
  title="Pixel Lineage Castle Repair: Priority Order"
  description="Complete Pixel Lineage castle repair guide: priority upgrade order, material costs, Guild Hall buffs, Arena restoration, and vault expansion benefits."
  canonical="/guilds/castle-repair/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/guilds/" style="color: var(--accent); text-decoration: none;">Guilds</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Castle Repair</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(234, 88, 12, 0.15); border: 1px solid #ea580c; color: #ea580c; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Guild Territory Restoration Strategy
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Castle Repair: Upgrade Order & Costs
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        Optimal building restoration sequence for the Guild Castle in Pixel Lineage on Roblox. We analyze resource investment costs, material farming locations, facility unlocking orders, and guild-wide passive benefits.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


    <!-- Unique Hero Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/features/feature_castle.webp"
        alt="Pixel Lineage Guild Castle Repair Order Material Costs and Facility Buffs"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
      <!-- Summary Callout -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #ea580c; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="why-castle-repair-order-dictates-guild-success" style="font-size: 1.25rem; color: #ea580c; margin: 0 0 12px;">Why Castle Repair Order Dictates Guild Success</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          Upon forming or claiming a Guild Castle, all interior wings start in ruined states. Repairing castle facilities requires massive communal contributions of Timber, Stone, and Gold. Spending resources on low-priority wings (like the Arena) before securing the Altar or Forge severely slows down your guild's progression through Torment raids.
        </p>
      </section>

      <!-- Repair Sequence Breakdown -->
      <section style="margin-bottom: 40px;">
        <h2 id="prescribed-castle-wing-upgrade-order" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 20px;">Prescribed Castle Wing Upgrade Order</h2>
        <div style="display: flex; flex-direction: column; gap: 24px;">
          {castleWings.map((w) => (
            <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px;">
              <h3 id="w-wing" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">{w.wing}</h3>
              <div style="font-size: 0.88rem; color: #c9a227; margin-bottom: 10px;">
                <strong>Restoration Cost:</strong> {w.repairCost}
              </div>

              <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px; margin-bottom: 10px; font-size: 0.88rem;">
                <strong style="color: #34d399; display: block; margin-bottom: 4px;">Unlocked Facilities & Buffs:</strong>
                <span style="color: var(--muted);">{w.unlockedBuffs}</span>
              </div>

              <p style="color: var(--ink); font-size: 0.88rem; line-height: 1.5; margin: 0;">
                <strong style="color: #38bdf8;">Priority Rationale:</strong> {w.whyFirst}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Material Farming Locations -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="where-to-farm-castle-building-materials" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Where to Farm Castle Building Materials</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          To accelerate guild repairs, assign party members to target these specific resource farming hubs:
        </p>
        <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 0;">
          <li style="margin-bottom: 8px;"><strong style="color: #fff;">Timber & Hardwood:</strong> Harvested from the Ancient Forest nodes located in the Act 1 Overworld.</li>
          <li style="margin-bottom: 8px;"><strong style="color: #fff;">Granite & Marble Blocks:</strong> Mined inside Act 2 Dungeon Depths and mountain cave caverns.</li>
          <li><strong style="color: #fff;">Guild Gold:</strong> Earned collectively by clearing weekly Guild Raids and Castle Siege defense waves.</li>
        </ul>
      </section>

      <!-- Navigation -->
      <section style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
        <h3 id="explore-further-guild-systems" style="font-size: 1.1rem; color: #fff; margin: 0 0 10px;">Explore Further Guild Systems</h3>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="/guilds/guild-raids/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            ← 4-Player Guild Raids Guide
          </a>
          <a href="/guilds/oaths/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → Guild Oaths & Blood Pledges Guide
          </a>
          <a href="/guilds/arena/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → Guild Arena PvP Guide
          </a>
        </div>
      </section>
          <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/guilds/castle-repair/" />
    </div>
  </div>

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" />
</BaseLayout>
