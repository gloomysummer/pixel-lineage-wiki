---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";

const raidEncounters = [
  {
    name: "The Shadow Gate (Raid Tier 1)",
    requiredRank: "Guild Level 2 / Player Level 18+",
    bossName: "Malakor the Abyssal Binder",
    mechanics: "Malakor summons two Void Pillars that shield him from all incoming damage until destroyed. Applies party-wide Torment Rot dealing 5% Max HP every turn.",
    lootDrops: "Malakor's Shadow Band, Tier-2 Arcane Weaver Silks, 150 Guild Tokens, 5% Ultra Sigil Shard.",
    teamComp: "1 Sentinel Tank, 1 Cleric Healer, 2 Burst DPS (Hexer / Berserk).",
  },
  {
    name: "Fortress of the Iron Colossus (Raid Tier 2)",
    requiredRank: "Guild Level 4 / Player Level 25+",
    bossName: "Ancient Siege Automaton",
    mechanics: "Channels an arena-wide Overcharge Blast every 4 turns. Frontline tank must utilize Shield Wall to intercept the blast, preventing total party wipe.",
    lootDrops: "Dragonbone Cestus, Dwarven Colossus Plate, 300 Guild Tokens, 12% Ultra Sigil Shard.",
    teamComp: "1 Dwarf Sentinel, 1 Celestine Cleric, 1 Troubadour Bard, 1 Sniper Archer.",
  },
  {
    name: "The Pinnacle Vault (Raid Tier 3)",
    requiredRank: "Guild Level 6 / Player Level 30+",
    bossName: "Echo of the First Lineage",
    mechanics: "Mirrors party composition and casts inverted spells. When players cast healing prayers, the boss absorbs 50% of the value as temporary shields.",
    lootDrops: "Guaranteed Ultra Sigil, Eclipse Netherplate Blueprints, Mythic Weapon Cache.",
    teamComp: "Highly coordinated 4-player static team with maximum Level 30 equipment.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Guild Raids: Boss Mechanics & Loot Guide",
    description: "Complete Pixel Lineage guild raids guide: 4-player team composition, Shadow Gate boss mechanics, Ultra Sigil drop tables, and raid token rewards.",
    url: `${siteConfig.siteUrl}/guilds/guild-raids/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Guilds", item: `${siteConfig.siteUrl}/guilds/` },
      { "@type": "ListItem", position: 3, name: "Guild Raids", item: `${siteConfig.siteUrl}/guilds/guild-raids/` },
    ],
  },
];

import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);
---


<BaseLayout
  title="Pixel Lineage Guild Raids: Boss Guide"
  description="Complete Pixel Lineage guild raids guide: 4-player team composition, Shadow Gate boss mechanics, Ultra Sigil drop tables, and raid token rewards."
  canonical="/guilds/guild-raids/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/guilds/" style="color: var(--accent); text-decoration: none;">Guilds</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Guild Raids</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(168, 85, 247, 0.15); border: 1px solid #a855f7; color: #a855f7; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Cooperative 4-Player Endgame Dungeon Encounters
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Guild Raids: Boss Mechanics & Loot Guide
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        Detailed walkthrough for 4-player cooperative Guild Raids in Pixel Lineage on Roblox. We analyze raid boss mechanics, team turn-rotation strategies, party wipe counters, and Ultra Sigil drop odds.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />

        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

    <!-- Unique Hero Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/features/feature_raids.webp"
        alt="Pixel Lineage Guild Raids 4-Player Boss Mechanics and Ultra Sigil Drop Tables"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
      <!-- Summary Callout -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #a855f7; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="the-core-rule-of-4-player-guild-warfare" style="font-size: 1.25rem; color: #a855f7; margin: 0 0 12px;">The Core Rule of 4-Player Guild Warfare</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          Guild Raids in Pixel Lineage scale enemy boss HP by 350% and introduce multi-stage enrage timers. Unlike standard solo dungeon crawling where raw damage can overcome boss mechanics, raid bosses execute unblockable party-wide wipe attacks if specific stage phases are ignored.
        </p>
      </section>

      <!-- Encounters Breakdown -->
      <section style="margin-bottom: 40px;">
        <h2 id="raid-tiers-boss-strategy-walkthrough" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 20px;">Raid Tiers & Boss Strategy Walkthrough</h2>
        <div style="display: flex; flex-direction: column; gap: 24px;">
          {raidEncounters.map((r) => (
            <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
                <h3 id="r-name" style="font-size: 1.3rem; color: #fff; margin: 0;">{r.name}</h3>
                <span style="font-size: 0.8rem; background: #0d0a14; color: #c9a227; padding: 3px 10px; border-radius: 4px; border: 1px solid var(--line);">
                  {r.requiredRank}
                </span>
              </div>

              <div style="font-size: 0.88rem; color: #f43f5e; margin-bottom: 12px; font-weight: 600;">
                Boss Entity: {r.bossName}
              </div>

              <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px; margin-bottom: 12px; font-size: 0.88rem; line-height: 1.5;">
                <strong style="color: #38bdf8; display: block; margin-bottom: 4px;">Phase Mechanics & Wipe Triggers:</strong>
                <span style="color: var(--muted);">{r.mechanics}</span>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; font-size: 0.85rem;">
                <div style="background: #0d0a14; padding: 10px 12px; border-radius: 6px;">
                  <span style="color: var(--muted); font-size: 0.75rem; display: block;">Loot & Drops</span>
                  <strong style="color: #34d399;">{r.lootDrops}</strong>
                </div>
                <div style="background: #0d0a14; padding: 10px 12px; border-radius: 6px;">
                  <span style="color: var(--muted); font-size: 0.75rem; display: block;">Optimal Team Composition</span>
                  <strong style="color: #c9a227;">{r.teamComp}</strong>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Raid Tokens & Castle Integration -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="spending-guild-tokens-the-vault-merchant" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Spending Guild Tokens: The Vault Merchant</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Completing raid encounters awards Guild Tokens to every participating member. These tokens are exchanged at the Guild Castle Vault NPC for exclusive benefits:
        </p>
        <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 0;">
          <li style="margin-bottom: 8px;"><strong style="color: #fff;">Ultra Sigil Shards (200 Tokens):</strong> Combine 5 shards to forge a complete Ultra Sigil without relying on 0.5% boss drop RNG.</li>
          <li style="margin-bottom: 8px;"><strong style="color: #fff;">Castle Repair Supplies (100 Tokens):</strong> Contributes towards unlocking the Tier 3 Guild Arena and Inn buffs.</li>
          <li><strong style="color: #fff;">Oath Renunciation Tokens (50 Tokens):</strong> Allows resetting character guild oaths without paying the standard gold penalty.</li>
        </ul>
      </section>

      <!-- Navigation -->
      <section style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
        <h3 id="explore-further-guild-content" style="font-size: 1.1rem; color: #fff; margin: 0 0 10px;">Explore Further Guild Content</h3>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="/guilds/oaths/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            ← Guild Oaths & Blood Pledges Guide
          </a>
          <a href="/guilds/arena/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → Guild Arena PvP & Rewards Guide
          </a>
          <a href="/adventures/torment/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → Torment Mode Challenge Guide
          </a>
        </div>
      </section>
          <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/guilds/guild-raids/" />
    </div>
  </div>
</BaseLayout>
