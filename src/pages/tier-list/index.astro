---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


// Master synergy matrix — evaluating tri-system builds across Torment difficulty
const synergyMatrix = [
  {
    archetype: "Vampiric Berserk",
    baseClass: "Warrior → Berserk",
    recommendedRace: "Orc (+12% ATK, +5% Tenacity)",
    recommendedTalent: "Bloodthirst (12% Lifesteal on Critical)",
    playstyleFocus: "Solo Torment Boss Farming",
    tacticalRationale: "Berserk thrives at 20-35% HP where its passive boosts ATK by up to +70%. The Orc racial trait ensures fatal hits leave 1 HP intact once per encounter, while Bloodthirst sustains the health buffer without wasting turns on potions.",
  },
  {
    archetype: "Void Caster Hexer",
    baseClass: "Mage → Hexer",
    recommendedRace: "Nightborn (+15% Mana Regen, +8% Dark DMG)",
    recommendedTalent: "Arcane Flow (15% Mana Refund on Kill)",
    playstyleFocus: "Guild Raids & Torment Dungeon Clears",
    tacticalRationale: "Hexer consumes massive mana (45 MP per Curse). Nightborn's passive mana regeneration combined with Arcane Flow ensures 100% uptime on the 2.4x MAG multiplier without ever dropping out of the turn rotation.",
  },
  {
    archetype: "Phantom Shadow Assassin",
    baseClass: "Thief → Assassin",
    recommendedRace: "Elf (+10% SPD, +5% Crit Rate)",
    recommendedTalent: "Swift Step (Turn Priority +20%)",
    playstyleFocus: "Fast Act 1-3 Speedrunning",
    tacticalRationale: "High Speed stat grants double-action turns against slow dungeon mobs. Elf racial bonus pushes baseline crit rate to 25%, allowing the Assassin to chain stealth executions with 2.8x crit multipliers.",
  },
  {
    archetype: "Aegis Paladin Sentinel",
    baseClass: "Warrior → Sentinel",
    recommendedRace: "Dwarf (+15% Max HP, +10% Physical DR)",
    recommendedTalent: "Iron Bastion (+20% Shield Absorption)",
    playstyleFocus: "Multiplayer Guild Raids & Tanking",
    tacticalRationale: "Dwarf passive reduces boss physical cleave damage while Iron Bastion elevates party barrier durability to withstand Act 3 wipe mechanics.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Pixel Lineage Tier List Hub: Builds & Synergies",
    description: "Master tier list hub for Pixel Lineage on Roblox: explore overall progression rankings, high-Torment tri-system synergies, race passives, and talent drop odds.",
    url: `${siteConfig.siteUrl}/tier-list/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Tier List", item: `${siteConfig.siteUrl}/tier-list/` },
    ],
  },
];
---

<BaseLayout
  title="Pixel Lineage Tier List Hub: Builds & Synergies"
  description="Master tier list hub for Pixel Lineage on Roblox: explore overall progression rankings, high-Torment tri-system synergies, race passives, and talent drop odds."
  canonical="/tier-list/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Tier List</span>
    </nav>
    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
      <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(244, 63, 94, 0.15); border: 1px solid #f43f5e; color: #f43f5e; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Empirical Meta Evaluation · Weekly Build
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Tier List Hub & Meta Rankings
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0 0 16px;">
        Authoritative meta tier list for Pixel Lineage on Roblox. We analyze 6+1 base classes, 21 Super Classes, racial bloodlines, and talent spin odds based on empirical Act 2 & 3 dungeon clear logs, Torment survival benchmarks, and turn-action efficiency.
      </p>

      <!-- Direct Answer Box for Pixel Lineage Tier List -->
      <div style="background: rgba(244, 63, 94, 0.08); border: 1px solid rgba(244, 63, 94, 0.35); border-left: 4px solid #f43f5e; border-radius: 6px; padding: 14px 18px; margin: 0; font-size: 0.92rem; line-height: 1.6; color: var(--ink);">
        <strong style="color: #f43f5e;">Pixel Lineage Meta Rankings Overview:</strong> Pixel Lineage endgame viability is governed by the tri-system synergy between your irreversible Super Class, racial Bloodline passives, and equipped Talent traits. Solo Torment clears and Guild Raid dominance demand harmonizing survivability buffers (such as Fortress Stance or Undying Rage) with burst multipliers (Assassin stealth crits or Hexer true damage DoTs).
      </div>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


    <!-- Sub-navigation for Tier List Cluster -->
    <div style="display: flex; gap: 12px; margin-bottom: 32px; flex-wrap: wrap;">
      <a href="/tier-list/" style="background: var(--line); color: var(--ink); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--accent);">
        Meta Overview
      </a>
      <a href="/tier-list/class-tier-list/" style="background: #161022; color: var(--muted); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--line);">
        Class Tier List
      </a>
      <a href="/tier-list/race-tier-list/" style="background: #161022; color: var(--muted); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--line);">
        Race Tier List
      </a>
      <a href="/tier-list/talent-tier-list/" style="background: #161022; color: var(--muted); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--line);">
        Talent Probabilities
      </a>
    </div>

    <!-- 3 Core Tier Categories Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px;">
      <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; display: flex; flex-direction: column;">
        <span style="color: #a855f7; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Core Combat Engine</span>
        <h3 id="class-super-class-directory" style="font-size: 1.3rem; margin: 0 0 12px; color: var(--ink);">Class & Super Class Directory</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; flex-grow: 1; margin: 0 0 20px;">
          Rankings for all 6+1 base archetypes and their 21 irreversible Super Class specializations evaluated across Solo Dungeon and Guild Raid performance.
        </p>
        <a href="/tier-list/class-tier-list/" style="background: rgba(168, 85, 247, 0.2); border: 1px solid #a855f7; color: #f5f3ff; padding: 10px 16px; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-decoration: none; text-align: center;">
          View Class Tier List →
        </a>
      </div>

      <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; display: flex; flex-direction: column;">
        <span style="color: #c9a227; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Bloodline Synergy</span>
        <h3 id="races-passives-directory" style="font-size: 1.3rem; margin: 0 0 12px; color: var(--ink);">Races & Passives Directory</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; flex-grow: 1; margin: 0 0 20px;">
          Detailed breakdown of racial spin rarities and passive trait buffs, highlighting top-tier synergies like Nightborn and Draconic lineages.
        </p>
        <a href="/tier-list/race-tier-list/" style="background: rgba(201, 162, 39, 0.2); border: 1px solid #c9a227; color: #f5f3ff; padding: 10px 16px; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-decoration: none; text-align: center;">
          View Race Tier List →
        </a>
      </div>

      <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; display: flex; flex-direction: column;">
        <span style="color: #38bdf8; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Drop Rate Mathematics</span>
        <h3 id="talents-traits-directory" style="font-size: 1.3rem; margin: 0 0 12px; color: var(--ink);">Talents & Traits Directory</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; flex-grow: 1; margin: 0 0 20px;">
          Empirical spin probability tables covering common to legendary traits, from Survivor (30%) down to Fortune's Favor (5%) and Prodigy.
        </p>
        <a href="/tier-list/talent-tier-list/" style="background: rgba(56, 189, 248, 0.2); border: 1px solid #38bdf8; color: #f5f3ff; padding: 10px 16px; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-decoration: none; text-align: center;">
          View Talent Tier List →
        </a>
      </div>
    </div>

    <!-- In-Depth Meta Tiers Justification Breakdown -->
            <!-- Video Showcase (Tactical Walkthrough) -->
        <section id="official-video-showcase" style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px; margin-bottom: 36px;">
          <h2 id="official-video-showcase" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">Official Video Reference: Tier List Guide</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
            Verified breakdown of S-tier classes, top bloodline synergies, and high-Torment progression rankings.
          </p>
          <VideoEmbed
            id="_Tx_aM0w1bE"
            title="Pixel Lineage Meta Rankings & Tier List Breakdown"
            channelTitle="OyO"
            uploadDate="2026-10-18T12:00:00+00:00"
            description="Verified breakdown of S-tier classes, top bloodline synergies, and high-Torment progression rankings."
          />
        </section>

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

<section style="margin-bottom: 40px; background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px;">
      <h2 id="tri-system-meta-evaluation-framework" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">Tri-System Meta Evaluation Framework</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
        Unlike standard RPGs where progression relies purely on equipment rarity, Pixel Lineage calculates endgame combat power through three interlocking layers:
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 20px;">
        <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.05);">
          <strong style="color: #a855f7; display: block; margin-bottom: 6px;">1. Super Class Architecture</strong>
          <span style="color: var(--muted); font-size: 0.88rem; line-height: 1.5;">21 irreversible combat paths across 6+1 base archetypes defining baseline action turn economy and skill multipliers.</span>
        </div>
        <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.05);">
          <strong style="color: #c9a227; display: block; margin-bottom: 6px;">2. Bloodline Passives</strong>
          <span style="color: var(--muted); font-size: 0.88rem; line-height: 1.5;">7 racial lineages from Mythic Seraph to Legendary Nightborn providing permanent elemental scaling and cheat-death mechanics.</span>
        </div>
        <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.05);">
          <strong style="color: #38bdf8; display: block; margin-bottom: 6px;">3. Talent Card Modifiers</strong>
          <span style="color: var(--muted); font-size: 0.88rem; line-height: 1.5;">Empirical roll probabilities from Prodigy (1.5%) to Bloodthirst (12% lifesteal) that finalize sustain in Torment Acts.</span>
        </div>
      </div>

      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
        Looking for individual class tier placements, stat scalings, and Torment viability verdicts? Explore our dedicated
        <a href="/tier-list/class-tier-list/" style="color: var(--accent); font-weight: 600;">Definitive Class & Super Class Tier List</a>.
      </p>
    </section>

    <!-- Meta Synergy Combinations Table -->
    <section style="margin-bottom: 40px; background: #161022; border: 1px solid var(--line); border-radius: 10px; padding: 24px;">
      <h2 id="top-meta-build-synergies-class-race-talent" style="font-size: 1.3rem; color: var(--ink); margin: 0 0 16px;">Top Meta Build Synergies (Class + Race + Talent)</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 20px;">
        True meta dominance requires harmonizing your irreversible Super Class with complementary racial passives and talent rolls. The following 4 archetypes represent the pinnacle of current high-Torment clears:
      </p>

      <div style="display: flex; flex-direction: column; gap: 16px;">
        {synergyMatrix.map((syn) => (
          <div style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 18px;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
              <h3 style="font-size: 1.15rem; color: #a855f7; margin: 0;">
                {syn.archetype} ({syn.baseClass})
              </h3>
              <span style="font-size: 0.75rem; background: rgba(52, 211, 153, 0.15); border: 1px solid #34d399; color: #34d399; padding: 2px 8px; border-radius: 4px; font-weight: 600;">
                {syn.playstyleFocus}
              </span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 12px; font-size: 0.88rem;">
              <div style="background: #161022; padding: 8px 12px; border-radius: 6px;">
                <span style="color: var(--muted); font-size: 0.75rem; display: block;">Optimal Race</span>
                <strong style="color: #c9a227;">{syn.recommendedRace}</strong>
              </div>
              <div style="background: #161022; padding: 8px 12px; border-radius: 6px;">
                <span style="color: var(--muted); font-size: 0.75rem; display: block;">Optimal Talent</span>
                <strong style="color: #38bdf8;">{syn.recommendedTalent}</strong>
              </div>
            </div>

            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              <strong style="color: var(--ink);">Tactical Rationale:</strong> {syn.tacticalRationale}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Solo vs Multiplayer Meta Dynamics -->
    <section style="margin-bottom: 40px; background: #161022; border: 1px solid var(--line); border-radius: 10px; padding: 24px;">
      <h2 id="solo-crawler-vs-multiplayer-guild-raid-meta-dynamics" style="font-size: 1.3rem; color: var(--ink); margin: 0 0 16px;">Solo Crawler vs Multiplayer Guild Raid Meta Dynamics</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
        A frequent pitfall for beginners is assuming tier rankings are identical across game modes. In Pixel Lineage, turn economy fundamentally changes depending on party size:
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
        <div style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 18px;">
          <h3 id="solo-crawler-priority" style="font-size: 1rem; color: #34d399; margin: 0 0 8px;">Solo Crawler Priority</h3>
          <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
            Solo crawlers cannot rely on external healing or aggro management. Self-sustain (Lifesteal), high baseline Dodge/Speed, and burst damage to eliminate high-threat minions before they act are mandatory. Berserk, Hexer, and Assassin excel here.
          </p>
        </div>
        <div style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 18px;">
          <h3 id="multiplayer-raid-priority" style="font-size: 1rem; color: #38bdf8; margin: 0 0 8px;">Multiplayer Raid Priority</h3>
          <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
            In 4-player Guild Raids, enemy boss HP scales by 350%. Pure DPS classes will wipe the team if a dedicated Sentinel does not hold aggro and a Cleric does not cleanse party debuffs. Sentinel and Cleric surge to mandatory S+ picks in group content.
          </p>
        </div>
      </div>
    </section>

    <!-- Tier Methodology Statement -->
    <section style="background: #1d152c; border: 1px solid var(--line); border-radius: 8px; padding: 24px;">
      <h3 id="ranking-methodology-verification-protocol" style="margin: 0 0 12px; font-size: 1.2rem; color: #c9a227;">Ranking Methodology & Verification Protocol</h3>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
        Every tier evaluation on this wiki undergoes strict validation across multiple criteria:
      </p>
      <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 0;">
        <li style="margin-bottom: 6px;"><strong>Act 2 Clear Speed:</strong> Timed performance metrics against the Dungeon Warden boss at Trainer's Shrine.</li>
        <li style="margin-bottom: 6px;"><strong>Survivability in Torment Mode:</strong> Effective HP, damage mitigation shields, and dodge reliability against fatal enemy crits.</li>
        <li style="margin-bottom: 6px;"><strong>Resource Efficiency:</strong> Mana consumption and Potion dependence during extended multi-stage boss encounters.</li>
        <li><strong>Team Utility:</strong> AoE debuff coverage, stun capabilities, and turn order manipulation for cooperative raids.</li>
      </ul>
    </section>
              <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/tier-list/" />
    </div>
  </div>
</BaseLayout>
