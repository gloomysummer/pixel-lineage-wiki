---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";

const raceTiers = [
  {
    tier: "S",
    color: "#f43f5e",
    note: "All three are 0.72% Mythic rolls except Celestine. If you roll one, keep it.",
    races: [
      {
        name: "Seraph",
        rarity: "Mythic · 0.72%",
        passives: "Angelic Blessing — on the first turn all allies take 10% less damage, and healing is 25% stronger for 2 rounds.",
        synergy: "The support pick. Best on Cleric and anything with party healing; its value scales with party size, not with its own damage.",
      },
      {
        name: "Nightborne",
        rarity: "Mythic · 0.72%",
        passives: "Bloodthirst — each attack heals you for 15% of the damage dealt, capped at roughly 7% of maximum HP per move.",
        synergy: "Strongest all-round race. Makes Mage and Hexer self-sustaining, and stabilises low-HP Berserk builds. Players also spell it \"Nightborn\".",
      },
      {
        name: "Dragonborn",
        rarity: "Mythic · 0.72%",
        passives: "Scaled Hide (+15% max HP, -30% Fire damage taken, -20% damage from Burn-afflicted enemies) plus Dragonfire, an AoE Burn attack.",
        synergy: "Defensive Mythic. Documented pairing is the Dragonlord Ultra Class, since Dragonlord applies Burn that Scaled Hide then resists.",
      },
    ],
  },
  {
    tier: "A",
    color: "#a855f7",
    note: "Worth keeping on a fresh character. Both improve noticeably once evolved to Kindled.",
    races: [
      {
        name: "Celestine",
        rarity: "Mythic · 1.44%",
        passives: "+6% Critical chance, +4% Dodge, +6% Magic.",
        synergy: "The offensive Mythic. Best on Mage, and the race most players chase after Seraph because 1.44% is twice the odds of the 0.72% tier.",
      },
      {
        name: "Tideborn",
        rarity: "Mythic · 0.72%",
        passives: "Tidal Grace — restores 5% of maximum HP at the start of each of your turns.",
        synergy: "Sustain race for long Torment runs. Weaker than Nightborne on damage races but far more forgiving on a fresh save.",
      },
    ],
  },
  {
    tier: "B",
    color: "#38bdf8",
    note: "These are the races evolution actually rescues — a Kindled Stonekin or Sylvan plays above its rarity.",
    races: [
      {
        name: "Stonekin",
        rarity: "Uncommon · 7.91%",
        passives: "+20 maximum HP, and Fist attacks deal +15% damage.",
        synergy: "The only race with a direct Fist bonus. Best-in-slot for Fist, mediocre for everything else.",
      },
      {
        name: "Sylvan",
        rarity: "Rare · 7.19%",
        passives: "+12% Nature damage, and unlocks Call Sylph — summons a fairy ally that fights and heals.",
        synergy: "Magic and support builds. The free summon adds a body that most races do not get.",
      },
      {
        name: "Slime",
        rarity: "Rare · 6.47%",
        passives: "Resistant to physical attacks, restores extra HP after combat. Takes increased Fire damage.",
        synergy: "Low-risk physical-content race. Avoid it against fire-heavy bosses — which is exactly what Dragonborn resists.",
      },
      {
        name: "Vesper",
        rarity: "Rare · 5.76%",
        passives: "+8% Magic damage, a small Energy boost, and a chance to evade ability attacks.",
        synergy: "The budget magic race. Fills the same slot as Celestine at eight times the drop rate.",
      },
      {
        name: "Dullahan",
        rarity: "Event race · 10,000 Candy, not in the spin pool",
        passives: "+5% max HP, +5% DEF, +3% Crit. Unlocks Headless Ride — 4 Energy, 5-turn cooldown, deals 50% more damage to enemies at or below 30% HP.",
        synergy: "Halloween event pick bought from the Candy Witch shop. Cannot be rolled, so treat it as a purchase decision, not a reroll.",
      },
    ],
  },
  {
    tier: "C",
    color: "#c9a227",
    note: "Functionally filler. Keep only if it matches your class; otherwise reroll while you still have free spins.",
    races: [
      {
        name: "Ashborn",
        rarity: "Uncommon · 9.35%",
        passives: "+8% max HP, +6% Attack.",
        synergy: "Bland but usable on Warrior and Thief. No mechanic, just stats.",
      },
      {
        name: "Goblin",
        rarity: "Uncommon · 8.63%",
        passives: "+8% Gold earned, 6% chance of bonus loot.",
        synergy: "Farming race, not a combat race. Worth keeping on a dedicated farm character and nothing else.",
      },
      {
        name: "Dwarf",
        rarity: "Uncommon · 8.63%",
        passives: "+15% max HP, +6% DEF.",
        synergy: "Identical drop rate to Goblin but built for surviving rather than farming. Fine on Warrior and Fist.",
      },
      {
        name: "Mushroom",
        rarity: "Rare · 4.32%",
        passives: "16% chance to poison an attacker with spores when hit.",
        synergy: "Reactive defensive race for long fights. Its value depends entirely on how often you get hit.",
      },
    ],
  },
  {
    tier: "D",
    color: "#94a3b8",
    note: "The default roll. Nothing wrong with it, nothing to build around either.",
    races: [
      {
        name: "Human",
        rarity: "Common · ~37%",
        passives: "+10% XP and +10% Class Mastery from battles.",
        synergy: "Leveling race. Genuinely useful on a first character because Class Mastery gates Super Class progress — then reroll it once you are established.",
      },
    ],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    datePublished: "2026-10-18T12:00:00+00:00",
    headline: "Pixel Lineage Race Tier List: All 14 Races Ranked",
    description: "All 14 Pixel Lineage races ranked with exact roll odds and passive numbers, from 0.72% Mythic bloodlines down to Human.",
    url: `${siteConfig.siteUrl}/tier-list/race-tier-list/`,
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Tier List", item: `${siteConfig.siteUrl}/tier-list/` },
      { "@type": "ListItem", position: 3, name: "Races Tier List", item: `${siteConfig.siteUrl}/tier-list/race-tier-list/` },
    ],
  },
];

import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const faqItems = [
  {
    "question": "How are races tiered in Pixel Lineage?",
    "answer": "By three things: the passive's actual numbers, how the passive interacts with class mechanics, and the roll chance you have to beat to get it. Rarity alone is not the ranking — Celestine at 1.44% out-damages Seraph at 0.72% in a solo Mage build, and Stonekin at 7.91% is the best race in the game for one specific class."
  },
  {
    "question": "Why is Human at the bottom if the drop rate is the most common?",
    "answer": "Human gives +10% XP and +10% Class Mastery — no combat stat at all. That makes it genuinely useful on a first character, because Class Mastery gates Super Class progress, but once you are past that gate there is no reason to keep it. It is a leveling race, not a weak race."
  },
  {
    "question": "Do you need a Mythic race to clear Act 2 or Torment?",
    "answer": "No. Race evolution closes most of the gap: a Kindled or Exalted Uncommon race plays well above its roll rarity, which is why a Stonekin or Sylvan roll is often worth keeping instead of rerolling. Turn mechanics, class choice and talent rolls matter far more than gacha luck in this game."
  },
  {
    "question": "How many times do you need to spin for a 0.72% Mythic race?",
    "answer": "Roughly 96 spins for a coin-flip chance at any single 0.72% race — and there are four of them. Bank Race Spins from codes before spending Robux, and remember that the same spins also fund Talent Spins through most code rewards."
  },
  {
    "question": "Is Dullahan better than the Mythic races for tanking?",
    "answer": "Not better, different. Dullahan gives +5% max HP, +5% DEF and +3% Crit plus Headless Ride, and it is a guaranteed 10,000 Candy purchase during the Halloween event rather than a roll. Dragonborn resists fire and Burn but gives no DEF; Stonekin gives raw HP and a Fist bonus at eight times Dullahan's accessibility."
  }
];
---



<BaseLayout
  title="Pixel Lineage Race Tier List: All 14 Races"
description="All 14 Pixel Lineage races ranked with exact roll odds and passive numbers, from 0.72% Mythic bloodlines down to Human, and which class each fits."
  canonical="/tier-list/race-tier-list/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/tier-list/" style="color: var(--accent); text-decoration: none;">Tier List</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Races</span>
    </nav>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">

    <header style="margin-bottom: 32px;">
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Race Tier List: All 14 Races Ranked
      </h1>
      <p style="color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0;">
        Every race in Pixel Lineage is a permanent passive that either amplifies or fights your class choice. There are fourteen rollable bloodlines plus the event-only Dullahan, and the gaps between them are smaller than the rarity labels suggest — which is why this list ranks by the passive's real numbers, not by the colour of the roll.
      </p>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 12px 0 0;">
        Roll odds below are the published bloodline chances. Race evolution (Heirloom then Heartblood) lifts almost every race one or two tiers, so read the <a href="/races/evolution/" style="color: var(--accent); text-decoration: none;">Heirloom &amp; Heartblood locations</a> page before you decide to reroll anything.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


    <!-- Race Tiers -->
    <div style="display: flex; flex-direction: column; gap: 32px; margin-bottom: 40px;">
      {raceTiers.map((rt) => (
        

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" /><section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; overflow: hidden;">
          <div style={`background: #1d152c; border-left: 6px solid ${rt.color}; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between;`}>
            <span style={`font-size: 1.4rem; font-weight: 800; color: ${rt.color};`}>
              {rt.tier} TIER — {rt.tier === "S" ? "Game-Altering Passives" : rt.tier === "A" ? "Strong Competitive Viability" : rt.tier === "B" ? "Evolution Rescues These" : rt.tier === "C" ? "Filler Until You Reroll" : "The Default Roll"}
            </span>
          </div>
          {rt.note && (
            <p style="margin: 0; padding: 10px 20px; background: #0d0a14; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; line-height: 1.5;">
              {rt.note}
            </p>
          )}

          <div style="padding: 20px; display: flex; flex-direction: column; gap: 20px;">
            {rt.races.map((r) => (
              <div style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 16px;">
                <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; flex-wrap: wrap;">
                  <h3 id={`race-${r.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`} style="margin: 0; font-size: 1.2rem; color: var(--ink);">{r.name}</h3>
                  <span style="font-size: 0.8rem; font-family: var(--font-mono); color: #c9a227; background: rgba(201, 162, 39, 0.15); padding: 1px 6px; border-radius: 3px;">
                    {r.rarity}
                  </span>
                </div>
                <div style="color: #f5f3ff; font-size: 0.9rem; margin-bottom: 6px;">
                  <strong>Passive Effects:</strong> {r.passives}
                </div>
                <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
                  <strong>Class Synergy:</strong> {r.synergy}
                </p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Spin Strategy Guide -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 40px;">
      <h2 id="when-should-you-reroll-your-race" style="font-size: 1.3rem; color: var(--ink); margin: 0 0 12px;">When Should You Reroll Your Race?</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
        Race Spins are an extremely valuable resource obtained from active promo codes (like <code style="color: #34d399;">TORMENT</code>) and high-level Guild Raid drops. Follow these guidelines:
      </p>
      <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 0;">
        <li style="margin-bottom: 8px;"><strong style="color: #f5f3ff;">Never reroll a Mythic.</strong> Seraph, Nightborne, Dragonborn and Tideborn are all 0.72%; Celestine is 1.44%. Anything in that band stays.</li>
        <li style="margin-bottom: 8px;"><strong style="color: #f5f3ff;">Check evolution before rerolling an Uncommon or Rare.</strong> A Stonekin or Sylvan that reaches Kindled plays above its roll rarity, so the Adam-and-eve answer is usually "keep and evolve", not "spin again" — see <a href="/races/evolution/" style="color: var(--accent); text-decoration: none;">Heirloom &amp; Heartblood locations</a>.</li>
        <li style="margin-bottom: 8px;"><strong style="color: #f5f3ff;">Reroll Human once you are past Act 2.</strong> Its +10% XP and +10% Class Mastery gate Super Class progress early, but it contributes no combat stat once that gate is behind you.</li>
        <li><strong style="color: #f5f3ff;">Match the race to the class you actually play.</strong> Stonekin only pays off on Fist; Vesper only pays off on magic. A "better" race that fights your kit is worse than a mediocre one that amplifies it.</li>
      </ul>
    </section>

    <!-- Links -->
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/codes/" style="background: #34d399; color: #0d0a14; padding: 12px 24px; border-radius: 6px; font-weight: 700; text-decoration: none;">
        Claim Free Race Spins via Codes →
      </a>
      <a href="/tier-list/talent-tier-list/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
        Check Talent Drop Rates →
      </a>
    </div>
  
      
      <!-- Frequently Asked Questions Accordion -->
      <FaqSection items={faqItems} />
          <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/tier-list/race-tier-list/" />
    </div></div>
</BaseLayout>
