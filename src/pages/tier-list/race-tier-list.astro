---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";

const raceTiers = [
  {
    tier: "S",
    color: "#f43f5e",
    races: [
      {
        name: "Nightborn",
        rarity: "Legendary (2% Spin Chance)",
        passives: "Shadow Affinity (+15% Magic & Dark damage in Dungeons), Night Sight (Immune to Darkness blind debuff).",
        synergy: "God-tier for Mage (Hexer) and Thief (Assassin). Turns Act 2 dungeon hallways into massive damage zones.",
      },
      {
        name: "Draconic",
        rarity: "Legendary (3% Spin Chance)",
        passives: "Dragon Scales (+12% Physical Defense, 25% Fire resistance), Dragon Breath (5% chance on hit to apply Burn DoT).",
        synergy: "Unstoppable frontline pairing with Warrior (Sentinel/Berserk) and Fist (Oni).",
      },
    ],
  },
  {
    tier: "A",
    color: "#a855f7",
    races: [
      {
        name: "High Elf",
        rarity: "Epic (10% Spin Chance)",
        passives: "Arcane Flow (-10% Mana cost on all spells), Nimble Step (+8% Combat Speed).",
        synergy: "Top-tier for Cleric, Mage, and Archer. Allows sustained spell rotations without chugging potions.",
      },
      {
        name: "Dwarf",
        rarity: "Epic (12% Spin Chance)",
        passives: "Stout Frame (+10% Maximum HP, +8% Poise stability), Smithing Blood (15% Gold discount at Blacksmith).",
        synergy: "Exceptional for Greatsword Warriors and Brawlers who trade blows in close quarters.",
      },
    ],
  },
  {
    tier: "B",
    color: "#38bdf8",
    races: [
      {
        name: "Beastkin",
        rarity: "Rare (25% Spin Chance)",
        passives: "Feral Instincts (+8% Dodge chance, +5% Movement speed during combat).",
        synergy: "Solid defensive baseline for Thief (Rogue) and Archer (Ranger).",
      },
      {
        name: "Human",
        rarity: "Common (48% Spin Chance)",
        passives: "Adaptable (+10% Bonus Knowledge from mobs, +5% Gold earned from all encounters).",
        synergy: "Universal beginner baseline. Accelerates early talent unlocks and Goblin Merchant purchases.",
      },
    ],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Race Tier List: Best Races Meta",
    description: "Complete Pixel Lineage race tier list: ranking all lineages, spin rarity probabilities, passive trait buffs, and optimal class synergies on Roblox.",
    url: `${siteConfig.siteUrl}/tier-list/race-tier-list/`,
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Tier List", item: `${siteConfig.siteUrl}/tier-list/` },
      { "@type": "ListItem", position: 3, name: "Races Tier List", item: `${siteConfig.siteUrl}/tier-list/race-tier-list/` },
    ],
  },
];
---

<BaseLayout
  title="Pixel Lineage Race Tier List: Best Races Meta"
  description="Complete Pixel Lineage race tier list: ranking all lineages, spin rarity probabilities, passive trait buffs, and optimal class synergies on Roblox."
  canonical="/tier-list/race-tier-list/"
  jsonLd={jsonLd}
>
  <div class="container" style="max-width: 960px; margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/tier-list/" style="color: var(--accent); text-decoration: none;">Tier List</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Races</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Race Tier List & Passives
      </h1>
      <p style="color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0;">
        Races in Pixel Lineage provide permanent passive stat multipliers that dramatically amplify your Super Class build. Here is how every lineage ranks in the current meta.
      </p>
    </header>

    <!-- Race Tiers -->
    <div style="display: flex; flex-direction: column; gap: 32px; margin-bottom: 40px;">
      {raceTiers.map((rt) => (
        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; overflow: hidden;">
          <div style={`background: #1d152c; border-left: 6px solid ${rt.color}; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between;`}>
            <span style={`font-size: 1.4rem; font-weight: 800; color: ${rt.color};`}>
              {rt.tier} TIER — {rt.tier === "S" ? "Game-Altering Passives" : rt.tier === "A" ? "Strong Competitive Viability" : "Solid Baseline"}
            </span>
          </div>

          <div style="padding: 20px; display: flex; flex-direction: column; gap: 20px;">
            {rt.races.map((r) => (
              <div style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 16px;">
                <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; flex-wrap: wrap;">
                  <h3 style="margin: 0; font-size: 1.2rem; color: var(--ink);">{r.name}</h3>
                  <span style="font-size: 0.8rem; font-family: var(--font-mono); color: #c9a227; background: rgba(201, 162, 39, 0.15); padding: 1px 6px; border-radius: 3px;">
                    {r.rarity}
                  </span>
                </div>
                <div style="color: #f5f3ff; font-size: 0.9rem; margin-bottom: 6px;">
                  <strong>Passive Effects:</strong> {r.passives}
                </div>
                <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
                  <strong>Class Synergy:</strong> {r.synergy}
                </p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Spin Strategy Guide -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 40px;">
      <h2 style="font-size: 1.3rem; color: var(--ink); margin: 0 0 12px;">When Should You Reroll Your Race?</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
        Race Spins are an extremely valuable resource obtained from active promo codes (like <code style="color: #34d399;">OCTOBER</code>) and high-level Guild Raid drops. Follow these guidelines:
      </p>
      <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 0;">
        <li><strong>Never reroll away from Nightborn or Draconic:</strong> With only a 2-3% roll rate, keeping a Legendary race guarantees endgame supremacy.</li>
        <li><strong>Keep High Elf if playing Mage or Cleric:</strong> The 10% Mana reduction prevents spell lockouts in long boss battles.</li>
        <li><strong>Reroll Human once you enter Act 2:</strong> While the 10% bonus Knowledge helps early level progression, Human provides no combat stat scaling in Torment mode.</li>
      </ul>
    </section>

    <!-- Links -->
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/codes/" style="background: #34d399; color: #0d0a14; padding: 12px 24px; border-radius: 6px; font-weight: 700; text-decoration: none;">
        Claim Free Race Spins via Codes →
      </a>
      <a href="/tier-list/talent-tier-list/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
        Check Talent Drop Rates →
      </a>
    </div>
  </div>
</BaseLayout>
