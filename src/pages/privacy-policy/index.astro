---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Privacy Policy | ${siteConfig.siteName}`,
    description: `Privacy policy and cookie disclosures for ${siteConfig.siteName}.`,
    url: `${siteConfig.siteUrl}/privacy-policy/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: `${siteConfig.siteUrl}/privacy-policy/` },
    ],
  },
];
---
<BaseLayout
  title="Pixel Lineage Wiki Privacy Policy"
  description="Official privacy policy and cookie disclosure for Pixel Lineage Wiki. Learn how anonymous analytics data is handled in compliance with privacy laws."
  canonical="/privacy-policy/"
  jsonLd={jsonLd}
>
  <div class="container" style="max-width: 860px; margin: 0 auto; padding: 40px 20px;">
    <article>
      <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
        <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
        <span class="separator" style="margin: 0 8px;">/</span>
        <span class="current">Privacy Policy</span>
      </nav>

      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 16px;">Pixel Lineage Wiki Privacy Policy</h1>
      <div class="meta-bar" style="margin-bottom: 24px; color: var(--muted); font-size: 0.85rem;">
        <span>Effective Date: October 18, 2026 · Legal & Compliance</span>
      </div>

      <p style="font-size: 1.05rem; line-height: 1.7; color: var(--ink); margin-bottom: 24px;">
        At <strong>Pixel Lineage Wiki</strong> (accessible from <a href={siteConfig.siteUrl} style="color: var(--accent);">{siteConfig.siteUrl}</a>), visitor privacy is an absolute priority. This policy outlines how information is gathered and protected.
      </p>

      <p style="color: var(--muted); line-height: 1.7; margin-bottom: 24px;">
        For queries regarding this privacy declaration, reach out to our privacy desk at <a href={`mailto:${siteConfig.contactEmail}`} style="color: var(--accent);">{siteConfig.contactEmail}</a>.
      </p>

      <h2 style="font-size: 1.4rem; color: var(--ink); margin: 32px 0 12px;">1. Server Log Records</h2>
      <p style="color: var(--muted); line-height: 1.7; margin-bottom: 24px;">
        Pixel Lineage Wiki utilizes standard edge caching and security log procedures provided by Cloudflare Pages. These logs record internet protocol (IP) addresses, browser type, referral pages, and request timestamps. This information is processed exclusively for DDoS mitigation, infrastructure stability, and geographic load balancing, without tracking personal identification.
      </p>

      <h2 style="font-size: 1.4rem; color: var(--ink); margin: 32px 0 12px;">2. Analytics & Measurement Cookies</h2>
      <p style="color: var(--muted); line-height: 1.7; margin-bottom: 16px;">
        We utilize Google Analytics 4 (Measurement ID: <code>G-2QYE09XE85</code>) to monitor anonymous traffic patterns, such as the most accessed class evolution guides and popular code queries:
      </p>
      <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin-bottom: 24px;">
        <li><strong>Aggregated Data</strong>: IP masking is enabled by default in GA4, ensuring full personal anonymity.</li>
        <li><strong>Visitor Choice</strong>: You can disable analytics tracking at any time by installing the official <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" style="color: var(--accent);">Google Analytics Opt-out Browser Extension</a>.</li>
      </ul>

      <div style="background: #161022; border-left: 4px solid var(--accent); padding: 16px 20px; margin: 24px 0; border-radius: 0 6px 6px 0;">
        <strong style="color: var(--accent); display: block; margin-bottom: 6px; font-size: 0.9rem; text-transform: uppercase;">
          Google Partner Policy Statement
        </strong>
        <span style="font-size: 0.95rem; color: var(--ink); line-height: 1.6;">
          To understand how Google utilizes data from websites using their services, please review: <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer" style="color: var(--accent);">How Google uses data when you use our partners' sites or apps</a>.
        </span>
      </div>

      <h2 style="font-size: 1.4rem; color: var(--ink); margin: 32px 0 12px;">3. External Links Disclaimer</h2>
      <p style="color: var(--muted); line-height: 1.7;">
        Our encyclopedia features direct links to external platforms including Roblox Corporation (<a href="https://www.roblox.com" target="_blank" rel="noopener noreferrer" style="color: var(--accent);">roblox.com</a>) and YouTube. We have no authority over external websites and encourage readers to inspect their standalone privacy policies.
      </p>
    </article>
  </div>
</BaseLayout>
