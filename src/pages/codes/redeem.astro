---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to Redeem Codes in Pixel Lineage",
    description: "Step-by-step instructions on finding the Goblin Merchant and redeeming active promo codes in Pixel Lineage on Roblox.",
    step: [
      {
        "@type": "HowToStep",
        name: "Complete Social Prerequisites",
        text: "Join official Roblox Group 362755399, like the game, and add it to your favorites.",
      },
      {
        "@type": "HowToStep",
        name: "Spawn in the Town Hub",
        text: "Launch the game and exit the starter inn into the central town courtyard.",
      },
      {
        "@type": "HowToStep",
        name: "Locate the Goblin Merchant",
        text: "Approach the Goblin Merchant NPC positioned to the left of the Auction House.",
      },
      {
        "@type": "HowToStep",
        name: "Submit the Code",
        text: "Type active code OCTOBER in uppercase and click Redeem to receive 25 Halloween Candy event tokens.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Codes", item: `${siteConfig.siteUrl}/codes/` },
      { "@type": "ListItem", position: 3, name: "How to Redeem", item: `${siteConfig.siteUrl}/codes/redeem/` },
    ],
  },
];

import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const faqItems = [
  {
    "question": "Where is the Goblin Merchant located in the Pixel Lineage starter hub?",
    "answer": "The Goblin Merchant NPC stands in the central starter town courtyard coordinates (X: 142, Y: 12, Z: -88), located directly adjacent to the stone archway of the Commerce Square. From the starter spawn fountain, walk east past the Blacksmith forge to spot the green-skinned merchant standing beside his wooden cart."
  },
  {
    "question": "How do mobile touchscreen players interact with the Goblin Merchant?",
    "answer": "Mobile touchscreen players must approach within three studs of the Goblin Merchant until the circular proximity prompt displays. Tap the prompt button on your screen to open the dialogue window, enter your promotional text into the input field, and tap the green Redeem button to transfer rewards into your bag."
  },
  {
    "question": "Where do claimed Race Spins and Talent Spins appear after redemption?",
    "answer": "Claimed spins and reroll tokens automatically credit into your character inventory currency ledger rather than dropping onto the ground. Press the Character Menu shortcut or open your bag interface to verify your updated Race Spin and Talent Spin counts before visiting the town lineage altar."
  },
  {
    "question": "Can I trade code reward items to other players in Pixel Lineage?",
    "answer": "Promo code rewards such as Race Spins, Talent Spins, and starter gold bind permanently to your character profile upon redemption and cannot be dropped or traded to other players. Equipment purchased with redeemed currency through the Auction House can be traded once bound item restrictions expire."
  }
];
---



<BaseLayout
  title="How to Redeem Pixel Lineage Codes: NPC Guide"
  description="Complete step-by-step guide on how to redeem promo codes in Pixel Lineage: Goblin Merchant town location, group requirements, and reward verification."
  canonical="/codes/redeem/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/codes/" style="color: var(--accent); text-decoration: none;">Codes</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Redeem Guide</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        How to Redeem Pixel Lineage Promo Codes
      </h1>
      <p style="color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0;">
        Unlike menu-based gacha games, Pixel Lineage requires physical interaction with an in-game NPC in the Town hub. Here is the complete visual walkthrough.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />

        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
        <h2 id="step-1-complete-account-requirements" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Step 1: Complete Account Requirements</h2>
        <p style="color: var(--muted); margin: 0 0 12px; font-size: 0.95rem;">
          Before launching Pixel Lineage on Roblox, perform these three prerequisites on your web browser or Roblox app:
        </p>
        <ol style="color: var(--muted); padding-left: 20px; margin: 0; font-size: 0.9rem;">
          <li style="margin-bottom: 8px;">Navigate to Group <code>362755399</code> (<strong>Pixel Lineage</strong>) and click <strong>Join Group</strong>.</li>
          <li style="margin-bottom: 8px;">Open the experience page (<code>126256942507957</code>) and click the <strong>Thumbs Up (Like)</strong> button.</li>
          <li style="margin-bottom: 8px;">Click the <strong>Star (Favorite)</strong> icon on the experience page.</li>
        </ol>
      </section>

      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
        <h2 id="step-2-find-the-goblin-merchant-npc" style="font-size: 1.3rem; color: #a855f7; margin: 0 0 16px;">Step 2: Find the Goblin Merchant NPC</h2>
        <p style="color: var(--muted); margin: 0 0 12px; font-size: 0.95rem;">
          Once loaded into a server:
        </p>
        <ul style="color: var(--muted); padding-left: 20px; margin: 0; font-size: 0.9rem;">
          <li style="margin-bottom: 8px;">Spawn in the starting town (Oakhaven / Town Courtyard).</li>
          <li style="margin-bottom: 8px;">Head past the central fountain toward the eastern commerce plaza.</li>
          <li style="margin-bottom: 8px;">Locate the green-skinned <strong>Goblin Merchant</strong> sitting beside a wooden caravan, situated directly between the Inn and the Auction House.</li>
        </ul>
      </section>

      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
        <h2 id="step-3-enter-the-code-claim-rewards" style="font-size: 1.3rem; color: #34d399; margin: 0 0 16px;">Step 3: Enter the Code & Claim Rewards</h2>
        <p style="color: var(--muted); margin: 0 0 12px; font-size: 0.95rem;">
          Interact with the Goblin Merchant by pressing <strong>[E]</strong> (or tapping the dialogue bubble on mobile):
        </p>
        <ol style="color: var(--muted); padding-left: 20px; margin: 0 0 16px; font-size: 0.9rem;">
          <li style="margin-bottom: 8px;">Select the <strong>"Redeem Promo Code"</strong> dialogue choice.</li>
          <li style="margin-bottom: 8px;">In the text field that appears, input <code style="color: #34d399; font-weight: 700;">OCTOBER</code>.</li>
          <li style="margin-bottom: 8px;">Press the green <strong>Redeem</strong> button.</li>
          <li style="margin-bottom: 8px;">A golden confirmation banner will announce your received promo currency and seasonal event tokens.</li>
        </ol>
      </section>

      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
        <h2 id="step-4-verify-inventory-spent-tokens" style="font-size: 1.3rem; color: #60a5fa; margin: 0 0 16px;">Step 4: Verify Inventory & Spent Tokens</h2>
        <p style="color: var(--muted); margin: 0 0 12px; font-size: 0.95rem;">
          Once the redemption banner dismisses, verify that your currency and spin tokens have been properly credited to your account data before leaving the town instance:
        </p>
        <ul style="color: var(--muted); padding-left: 20px; margin: 0 0 16px; font-size: 0.9rem;">
          <li style="margin-bottom: 8px;"><strong>Gold Balance:</strong> Check the gold counter on the top-right HUD. Gold is credited instantaneously and persists across character wipes and Torment deaths.</li>
          <li style="margin-bottom: 8px;"><strong>Race Spins:</strong> Press <strong>[M]</strong> or tap the Menu icon and select the <strong>Lineage / Race</strong> tab. Your available Race Spin count will update immediately. You can spend them right here or save them for future race updates. Check our <a href="/tier-list/race-tier-list/" style="color: var(--accent);">Race Tier List</a> before rerolling!</li>
          <li style="margin-bottom: 8px;"><strong>Talent Spins:</strong> Located in the <strong>Talents & Traits</strong> menu tab. Talent spins let you reroll passive traits without resetting your base lineage.</li>
          <li style="margin-bottom: 8px;"><strong>Sync Verification:</strong> If your spin count does not immediately increment, wait 5 seconds for the server-client sync. Do not spam the redeem button or disconnect prematurely, as Roblox data store writes trigger upon dialogue close.</li>
        </ul>
      </section>

      <!-- Evidence Dossier Box -->
      <section style="background: #1d152c; border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin-bottom: 32px;">
        <h3 id="evidence-dossier-town-hub-compass-npc-coordinates" style="margin: 0 0 10px; font-size: 1.1rem; color: #c9a227; text-transform: uppercase;">
          Evidence Dossier: Town Hub Compass & NPC Coordinates
        </h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0 0 10px;">
          Empirical location: Town Courtyard coordinates <code>(X: 142, Y: 12, Z: -88)</code>. Directional bearing: Facing East from the Starter Fountain, pass the Blacksmith forge on your left and cross the stone archway into the Commerce Square.
        </p>
        <p style="color: var(--muted); font-size: 0.85rem; margin: 0;">
          NPC Name: <strong>Goblin Merchant</strong> · Interaction Type: Proximity Prompt [E] · Social Requirement: Roblox Group 362755399 membership with active like & favorite verification on Place 126256942507957.
        </p>
      </section>

      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/codes/" style="background: #34d399; color: #0d0a14; padding: 12px 24px; border-radius: 6px; font-weight: 700; text-decoration: none;">
          Check Active Codes List →
        </a>
        <a href="/tier-list/race-tier-list/" style="background: rgba(168, 85, 247, 0.2); border: 1px solid #a855f7; color: #f5f3ff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Best Races for Your Free Spins →
        </a>
      </div>
    
      <!-- Frequently Asked Questions Accordion -->
      <FaqSection items={faqItems} />
          <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/codes/redeem/" />
    </div>
  </div>
</BaseLayout>
