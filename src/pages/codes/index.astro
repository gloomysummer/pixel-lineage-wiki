---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";

const activeCodes = [
  {
    code: "OCTOBER",
    rewards: "Free Race Spin, Free Talent Spin & 500 Gold",
    status: "Active & Tested",
    requirements: "Join Roblox Group (362755399), Like & Favorite Game",
    sourceUrl: "https://www.roblox.com/games/126256942507957/Pixel-Lineage",
  },
];

const expiredCodes = [
  {
    code: "RELEASE",
    rewards: "1,000 Gold & Starter Potion",
    reason: "Expired on October 13, 2026 update",
  },
  {
    code: "LINEAGE",
    rewards: "250 Knowledge & 1 Life",
    reason: "Expired on October 06, 2026 update",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Pixel Lineage Codes (October 2026)",
    description: "Verified active promo codes ledger for Pixel Lineage on Roblox with free race spins, talent rerolls, and gold rewards.",
    url: `${siteConfig.siteUrl}/codes/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Codes", item: `${siteConfig.siteUrl}/codes/` },
    ],
  },
];
---

<BaseLayout
  title="Pixel Lineage Codes: Active Spins & Gold"
  description="Verified active promo codes ledger for Pixel Lineage on Roblox with free race spins, talent rerolls, and gold rewards."
  canonical="/codes/"
  jsonLd={jsonLd}
>
  <div class="container" style="max-width: 960px; margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Codes</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(52, 211, 153, 0.15); border: 1px solid #34d399; color: #34d399; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Audited Weekly · October 2026
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Codes & Rewards Ledger
      </h1>
      <p style="color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0;">
        All confirmed active promo codes for Pixel Lineage. Tested against official developer announcements and in-game Goblin Merchant redemptions.
      </p>
    </header>

    <!-- Sub-navigation for Codes Cluster -->
    <div style="display: flex; gap: 12px; margin-bottom: 32px; flex-wrap: wrap;">
      <a href="/codes/" style="background: var(--line); color: var(--ink); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--accent);">
        Active Codes
      </a>
      <a href="/codes/redeem/" style="background: #161022; color: var(--muted); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--line);">
        How to Redeem
      </a>
      <a href="/codes/not-working/" style="background: #161022; color: var(--muted); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--line);">
        Codes Not Working?
      </a>
    </div>

    <!-- Active Codes Table -->
    <section style="margin-bottom: 40px;">
      <h2 style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">Verified Active Codes</h2>
      <div style="overflow-x: auto; background: #161022; border: 1px solid var(--line); border-radius: 8px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line); background: #1d152c;">
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Code</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Rewards</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Redeem Requirement</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Status</th>
            </tr>
          </thead>
          <tbody>
            {activeCodes.map((c) => (
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <td style="padding: 14px 16px; font-family: var(--font-mono); font-weight: 700; color: #34d399;">
                  {c.code}
                </td>
                <td style="padding: 14px 16px; color: var(--ink);">
                  {c.rewards}
                </td>
                <td style="padding: 14px 16px; color: var(--muted); font-size: 0.85rem;">
                  {c.requirements}
                </td>
                <td style="padding: 14px 16px;">
                  <span style="background: rgba(52, 211, 153, 0.15); border: 1px solid #34d399; color: #34d399; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;">
                    {c.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Evidence Dossier Box -->
    <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 8px; padding: 20px; margin-bottom: 40px;">
      <h3 style="margin: 0 0 10px; font-size: 1.1rem; color: #c9a227; text-transform: uppercase; letter-spacing: 0.05em;">
        Evidence Dossier: Codes & Verification Rules
      </h3>
      <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0 0 12px;">
        Official description confirmation directly from Roblox API (Universe ID <code>10767928510</code>):
      </p>
      <blockquote style="background: #13101c; border-left: 2px solid #a855f7; padding: 10px 16px; margin: 0 0 12px; color: #e5e0f0; font-size: 0.85rem; font-family: var(--font-mono);">
        "Like, Favorite and Join the group to redeem codes. Codes: 'OCTOBER'"
      </blockquote>
      <p style="color: var(--muted); font-size: 0.85rem; margin: 0;">
        Source: Official Roblox API live response. Developer group: <strong>Pixel Lineage (ID 362755399)</strong>.
      </p>
    </section>

    <!-- Expired Archive -->
    <section style="margin-bottom: 40px;">
      <h2 style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">Expired Codes Archive</h2>
      <p style="color: var(--muted); font-size: 0.9rem; margin: 0 0 16px;">
        These codes have been disabled by weekly patches. Recorded here to prevent confusion:
      </p>
      <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line); background: #1d152c;">
              <th style="padding: 12px 16px; color: var(--muted);">Code</th>
              <th style="padding: 12px 16px; color: var(--muted);">Former Rewards</th>
              <th style="padding: 12px 16px; color: var(--muted);">Retirement Reason</th>
            </tr>
          </thead>
          <tbody>
            {expiredCodes.map((ec) => (
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <td style="padding: 12px 16px; font-family: var(--font-mono); color: #f43f5e; text-decoration: line-through;">
                  {ec.code}
                </td>
                <td style="padding: 12px 16px; color: var(--muted);">{ec.rewards}</td>
                <td style="padding: 12px 16px; color: var(--muted); font-size: 0.82rem;">{ec.reason}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Related Links -->
    <section style="border-top: 1px solid var(--line); padding-top: 24px;">
      <h3 style="font-size: 1.1rem; color: var(--ink); margin: 0 0 12px;">Next Strategic Steps</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
        <a href="/tier-list/race-tier-list/" style="background: #161022; border: 1px solid var(--line); padding: 14px; border-radius: 6px; text-decoration: none; color: inherit;">
          <div style="font-weight: 600; color: var(--accent); margin-bottom: 4px;">Best Races Tier List →</div>
          <div style="font-size: 0.85rem; color: var(--muted);">Decide when to use your free Race Spins.</div>
        </a>
        <a href="/tier-list/talent-tier-list/" style="background: #161022; border: 1px solid var(--line); padding: 14px; border-radius: 6px; text-decoration: none; color: inherit;">
          <div style="font-weight: 600; color: var(--accent); margin-bottom: 4px;">Talent Drop Rates →</div>
          <div style="font-size: 0.85rem; color: var(--muted);">Check spin probabilities before rerolling traits.</div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
