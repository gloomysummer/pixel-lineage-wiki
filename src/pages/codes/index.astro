---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const activeCodes = [
  {
    code: "OCTOBER",
    rewards: "1x Free Race Spin, 1x Free Talent Spin, 500 Gold",
    status: "Active & Tested",
    expiryNotice: "Expected to cycle with the next weekly update",
    requirements: "Join Roblox Group (362755399), Like & Favorite the game",
    utility: "Best used immediately for early race rerolls (targeting Nightborn/Elf) or banking talent spins for Act 2.",
  },
];

const expiredCodes = [
  {
    code: "RELEASE",
    rewards: "1,000 Gold & 2x Starter Health Potions",
    expiredOn: "October 13, 2026",
    reason: "Deactivated following the weekly update patch 1.0.2.",
  },
  {
    code: "LINEAGE",
    rewards: "250 Knowledge & 1 Extra Life Token",
    expiredOn: "October 06, 2026",
    reason: "Launch milestone code retired after 5M visits reached.",
  },
  {
    code: "DUNGEONTEST",
    rewards: "1x Talent Spin & 300 Gold",
    expiredOn: "September 30, 2026",
    reason: "Closed alpha dungeon stress-test promotion.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Pixel Lineage Codes (October 2026)",
    description: "Verified active promo codes ledger for Pixel Lineage on Roblox. Detailed rewards breakdown, redemption prerequisites, and troubleshooting guide.",
    url: `${siteConfig.siteUrl}/codes/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Codes", item: `${siteConfig.siteUrl}/codes/` },
    ],
  },
];


const faqItems = [
  {
    "question": "Why do promo codes expire in Pixel Lineage?",
    "answer": "Promo codes in Pixel Lineage expire when developer update cycles conclude or when server redemption thresholds are reached. The development studio typically issues fresh codes during weekly content drops and holiday events. Expired codes permanently lose their validity in the Goblin Merchant redemption menu once superseded by new version updates."
  },
  {
    "question": "Can I redeem the same promo code multiple times on one Roblox account?",
    "answer": "Each active code can only be redeemed once per unique Roblox account ID across all server instances. Rerolling your character race, changing your starting class, or resetting your lineage rank does not restore code eligibility. To claim code bonuses again, players must register a separate Roblox account and complete group verification."
  },
  {
    "question": "What prerequisites must be completed before entering codes at the Goblin Merchant?",
    "answer": "Players must join the official Pixel Lineage Roblox Group (ID 362755399), give the game a thumbs-up like, and add the experience to their favorites list. If these three prerequisites are missing, the Goblin Merchant NPC dialog prompt will reject the submission and display a verification warning."
  },
  {
    "question": "What rewards do active Pixel Lineage codes grant?",
    "answer": "Active promo codes primarily provide free Race Spins, Talent Rerolls, consumable healing elixirs, and starter Gold currency. During limited seasonal events such as Halloween, active codes additionally grant event-exclusive Candy tokens used to purchase event weapon cosmetics and rare lineage upgrade scrolls."
  }
];
---


<BaseLayout
  title="Pixel Lineage Codes: Active Spins & Gold"
  description="Verified active promo codes ledger for Pixel Lineage on Roblox. Detailed rewards breakdown, redemption prerequisites, and troubleshooting guide."
  canonical="/codes/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Codes</span>
    </nav>
    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
      <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(52, 211, 153, 0.15); border: 1px solid #34d399; color: #34d399; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Audited Weekly · October 2026 Live
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Codes & Rewards Ledger
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        Authoritative promo code database for Pixel Lineage on Roblox (Universe ID: 10767928510). Every code is directly tested in-game at the Goblin Merchant NPC across active live servers to guarantee 100% validity and prevent wasted player runs.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />

    <!-- Sub-navigation for Codes Cluster -->
    <div style="display: flex; gap: 12px; margin-bottom: 32px; flex-wrap: wrap;">
      <a href="/codes/" style="background: var(--line); color: var(--ink); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--accent);">
        Active Codes
      </a>
      <a href="/codes/redeem/" style="background: #161022; color: var(--muted); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--line);">
        How to Redeem
      </a>
      <a href="/codes/not-working/" style="background: #161022; color: var(--muted); padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid var(--line);">
        Codes Not Working?
      </a>
    </div>

    <!-- Active Codes Table -->
            <!-- Video Showcase (Tactical Walkthrough) -->
        <section id="official-video-showcase" style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px; margin-bottom: 36px;">
          <h2 id="official-video-showcase" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">Official Video Reference: Codes Guide</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
            Official Pixel Lineage promo code redemption and weekly spin reward demonstration at the Goblin Merchant.
          </p>
          <VideoEmbed
            id="_Tx_aM0w1bE"
            title="Pixel Lineage Active Codes Redemption & Free Spins Showcase"
            channelTitle="OyO"
            uploadDate="2026-10-18T12:00:00+00:00"
            description="Official Pixel Lineage promo code redemption and weekly spin reward demonstration at the Goblin Merchant."
          />
        </section>

<section style="margin-bottom: 40px;">
      <h2 id="verified-active-codes" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">Verified Active Codes</h2>
      <div style="overflow-x: auto; background: #161022; border: 1px solid var(--line); border-radius: 8px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line); background: #1d152c;">
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Code</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Rewards Breakdown</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Redeem Requirement</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Status</th>
            </tr>
          </thead>
          <tbody>
            {activeCodes.map((c) => (
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <td style="padding: 14px 16px; font-family: var(--font-mono); font-weight: 700; color: #34d399;">
                  {c.code}
                </td>
                <td style="padding: 14px 16px; color: var(--ink);">{c.rewards}</td>
                <td style="padding: 14px 16px; color: var(--muted);">{c.requirements}</td>
                <td style="padding: 14px 16px;">
                  <span style="background: rgba(52, 211, 153, 0.2); color: #34d399; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">
                    {c.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Detailed Code Breakdown Card -->
    <section style="margin-bottom: 40px; background: #161022; border: 1px solid var(--line); border-radius: 10px; padding: 24px;">
      <h2 id="active-code-in-depth-tactical-analysis" style="font-size: 1.3rem; color: var(--ink); margin: 0 0 16px;">Active Code In-Depth Tactical Analysis</h2>
      
      <div style="background: #0d0a14; border: 1px solid rgba(168, 85, 247, 0.3); border-radius: 8px; padding: 20px; margin-bottom: 20px;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
          <h3 id="code-october" style="font-family: var(--font-mono); font-size: 1.4rem; color: #34d399; margin: 0;">Code: OCTOBER</h3>
          <span style="font-size: 0.8rem; color: var(--muted);">Verification Date: 2026-10-18 · Build 1.0.3</span>
        </div>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 16px;">
          <div style="background: #161022; padding: 12px 16px; border-radius: 6px; border-left: 3px solid #a855f7;">
            <div style="font-size: 0.8rem; color: var(--muted); text-transform: uppercase;">1x Race Spin</div>
            <div style="font-size: 0.95rem; color: var(--ink); margin-top: 4px;">Enables rolling off Human base to hunt S-Tier Nightborn (+15% Mana Regen) or Elf (+10% SPD).</div>
          </div>
          <div style="background: #161022; padding: 12px 16px; border-radius: 6px; border-left: 3px solid #c9a227;">
            <div style="font-size: 0.8rem; color: var(--muted); text-transform: uppercase;">1x Talent Spin</div>
            <div style="font-size: 0.95rem; color: var(--ink); margin-top: 4px;">Rerolls universal character passive talents. Recommended to hold until Act 2 unlocks higher tier pools.</div>
          </div>
          <div style="background: #161022; padding: 12px 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <div style="font-size: 0.8rem; color: var(--muted); text-transform: uppercase;">500 Gold Currency</div>
            <div style="font-size: 0.95rem; color: var(--ink); margin-top: 4px;">Covers 5x Minor Health Potions at the Alchemist or 1x Tier-1 weapon sharpening at the Blacksmith.</div>
          </div>
        </div>

        <p style="color: var(--muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">
          <strong>Expiry Projection:</strong> The development team has committed to weekly content cycles. The <code style="color: var(--accent);">OCTOBER</code> promo code is tied directly to the mid-October Halloween and Dungeon Evolution patch. Players should claim this reward immediately upon character generation, as server restarts typically purge active promo buffers without advance warning.
        </p>
      </div>
    </section>

    <!-- The 4 Mandatory Prerequisites -->
    <section style="margin-bottom: 40px; background: #161022; border: 1px solid var(--line); border-radius: 10px; padding: 24px;">
      <h2 id="mandatory-redemption-prerequisites" style="font-size: 1.3rem; color: var(--ink); margin: 0 0 16px;">Mandatory Redemption Prerequisites</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 20px;">
        Unlike generic Roblox experiences that permit code redemption via a simple settings screen, Pixel Lineage enforces strict server-side verification checks through the in-game NPC logic. If any of the following 4 conditions are missing, the redemption dialogue will fail immediately:
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
        <div style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 16px;">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; color: #a855f7; margin-bottom: 8px;">1. Roblox Group Check</div>
          <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
            Your Roblox account must be an active member of the official <strong style="color: var(--ink);">Pixel Lineage Group</strong> (Group ID: <code style="color: var(--accent);">362755399</code>). Pending join requests will not qualify; membership must be confirmed.
          </p>
        </div>
        <div style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 16px;">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; color: #34d399; margin-bottom: 8px;">2. Game Portal Thumbs-Up</div>
          <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
            Click the "Like" button on the official Roblox game details page. The server queries the platform API to confirm your account has submitted a positive rating.
          </p>
        </div>
        <div style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 16px;">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; color: #c9a227; margin-bottom: 8px;">3. Game Portal Favorite Star</div>
          <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
            Click the "Favorite" star icon on the game page. The in-game Goblin Merchant cross-references both your like and favorite timestamps before enabling redemption.
          </p>
        </div>
        <div style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 16px;">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; color: #f43f5e; margin-bottom: 8px;">4. Goblin Merchant Interaction</div>
          <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
            Codes cannot be claimed in combat or during active dungeon crawls. You must speak directly to the Goblin Merchant NPC situated at the east plaza of the Starter Village.
          </p>
        </div>
      </div>
    </section>

    <!-- 6 Common Redemption Failure Scenarios & Troubleshooting Matrix -->
    <section style="margin-bottom: 40px; background: #161022; border: 1px solid var(--line); border-radius: 10px; padding: 24px;">
      <h2 id="code-failure-diagnosis-6-common-errors-fixes" style="font-size: 1.3rem; color: var(--ink); margin: 0 0 16px;">Code Failure Diagnosis: 6 Common Errors & Fixes</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 20px;">
        If entering a valid code results in an error prompt, consult this diagnostic matrix to identify and resolve the issue without contacting developer support:
      </p>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line); background: #1d152c;">
              <th style="padding: 12px 14px; color: var(--muted); font-weight: 600;">Error Message / Symptom</th>
              <th style="padding: 12px 14px; color: var(--muted); font-weight: 600;">Root Cause</th>
              <th style="padding: 12px 14px; color: var(--muted); font-weight: 600;">Prescribed Resolution</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
              <td style="padding: 12px 14px; color: #f43f5e; font-family: var(--font-mono);">"Group Not Joined"</td>
              <td style="padding: 12px 14px; color: var(--ink);">Roblox API caching latency between group membership registration and live game server state.</td>
              <td style="padding: 12px 14px; color: var(--muted);">Leave the game instance, wait 60 seconds on the Roblox client, and rejoin a fresh server.</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
              <td style="padding: 12px 14px; color: #f43f5e; font-family: var(--font-mono);">"Invalid Code"</td>
              <td style="padding: 12px 14px; color: var(--ink);">String case mismatch (e.g., typing 'october' instead of exact uppercase 'OCTOBER').</td>
              <td style="padding: 12px 14px; color: var(--muted);">Redemption string matching is strictly case-sensitive. Always input codes in uppercase exactly as published.</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
              <td style="padding: 12px 14px; color: #f43f5e; font-family: var(--font-mono);">"Hidden Character Error"</td>
              <td style="padding: 12px 14px; color: var(--ink);">Clipboard copy carrying invisible leading or trailing space characters (e.g. ' OCTOBER ').</td>
              <td style="padding: 12px 14px; color: var(--muted);">Manually type the letters or verify the cursor is positioned directly after the final letter before submitting.</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
              <td style="padding: 12px 14px; color: #f43f5e; font-family: var(--font-mono);">"Already Claimed"</td>
              <td style="padding: 12px 14px; color: var(--ink);">Code was previously redeemed on another character slot or prior roguelike run on this Roblox ID.</td>
              <td style="padding: 12px 14px; color: var(--muted);">Promo codes are tied permanently to your Roblox UserID, not your individual character save file. Codes cannot be reused on permadeath restarts.</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
              <td style="padding: 12px 14px; color: #f43f5e; font-family: var(--font-mono);">"Outdated Server Version"</td>
              <td style="padding: 12px 14px; color: var(--ink);">Instance is running on a legacy server version deployed prior to the weekly code activation patch.</td>
              <td style="padding: 12px 14px; color: var(--muted);">Check server age via Roblox console (F9). If the server uptime exceeds 24 hours, rejoin until matching the latest version.</td>
            </tr>
            <tr>
              <td style="padding: 12px 14px; color: #f43f5e; font-family: var(--font-mono);">"Merchant Dialogue Locked"</td>
              <td style="padding: 12px 14px; color: var(--ink);">Starter tutorial prologue dialog has not been finished with Village Elder.</td>
              <td style="padding: 12px 14px; color: var(--muted);">Speak with the Village Elder at spawn and select your starting weapon before approaching the Goblin Merchant.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Expired Codes Archive -->
    <section style="margin-bottom: 40px;">
      <h2 id="historical-expired-codes-ledger" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">Historical Expired Codes Ledger</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
        For transparency and archive auditing, the following promotional codes have been permanently deactivated by the developer. They are listed here to save players from entering defunct keys:
      </p>
      <div style="overflow-x: auto; background: #161022; border: 1px solid var(--line); border-radius: 8px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line); background: #1d152c;">
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Code</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Historical Rewards</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Deactivation Date</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 600;">Retirement Rationale</th>
            </tr>
          </thead>
          <tbody>
            {expiredCodes.map((c) => (
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); opacity: 0.75;">
                <td style="padding: 14px 16px; font-family: var(--font-mono); text-decoration: line-through; color: var(--muted);">
                  {c.code}
                </td>
                <td style="padding: 14px 16px; color: var(--muted);">{c.rewards}</td>
                <td style="padding: 14px 16px; color: var(--muted);">{c.expiredOn}</td>
                <td style="padding: 14px 16px; color: var(--muted); font-size: 0.85rem;">{c.reason}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Currency & Spins Economy Strategy -->
    <section style="margin-bottom: 40px; background: #161022; border: 1px solid var(--line); border-radius: 10px; padding: 24px;">
      <h2 id="currency-free-spins-resource-management" style="font-size: 1.3rem; color: var(--ink); margin: 0 0 16px;">Currency & Free Spins Resource Management</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
        In a permadeath roguelike RPG, squandering promotional currency on sub-optimal early rolls significantly impedes late-game progression. Here is our tactical guide on how to allocate code payouts:
      </p>

      <ul style="color: var(--muted); font-size: 0.92rem; line-height: 1.7; padding-left: 20px; margin: 0;">
        <li style="margin-bottom: 10px;">
          <strong style="color: var(--ink);">Race Spins:</strong> Rolling away from the default Human race should only be undertaken if you know your targeted Super Class archetype. If aiming for Mage evolutions (Hexer, Cleric), Nightborn and Elf provide critical Mana Regen. If aiming for Greatsword Warrior, Orc and Dwarf provide unmatched physical DR.
        </li>
        <li style="margin-bottom: 10px;">
          <strong style="color: var(--ink);">Talent Spins:</strong> Do not burn talent spins immediately in Act 1. Talent rolls in the early village pool offer limited stat scaling. Reaching the Trainer's Shrine in Act 2 broadens the available talent seed table, maximizing the statistical value of each spin.
        </li>
        <li style="margin-bottom: 10px;">
          <strong style="color: var(--ink);">Gold:</strong> Early gold is best conserved for purchasing 5x Minor Healing Potions prior to entering Act 1 Dungeon depths. Avoid spending starting gold on vanity cosmetic dyes in the starter inn.
        </li>
      </ul>
    </section>

    <!-- Cross-cluster linking -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px;">
      <h2 id="related-guides-game-databases" style="font-size: 1.1rem; color: var(--ink); margin: 0 0 12px;">Related Guides & Game Databases</h2>
      <div style="display: flex; gap: 16px; flex-wrap: wrap;">
        <a href="/codes/redeem/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
          → Detailed Goblin Merchant Step-by-Step Guide
        </a>
        <a href="/tier-list/race-tier-list/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
          → Race Tier List & Passive Drop Rates
        </a>
        <a href="/classes/super-classes/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
          → 18 Super Class Evolution Tree
        </a>
      </div>
    </section>
        
      <!-- Frequently Asked Questions Accordion -->
      <FaqSection items={faqItems} />
    </article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/codes/" />
    </div>
  </div>
</BaseLayout>
