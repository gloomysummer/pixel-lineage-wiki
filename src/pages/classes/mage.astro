---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Mage Class Guide: Stats & Evolutions",
    description: "Complete Pixel Lineage Mage class guide: Lv 1-30 stat growths, Cleric, Hexer, and Summoner Super Classes, spell rotations, and arcane burst builds.",
    url: `${siteConfig.siteUrl}/classes/mage/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Classes", item: `${siteConfig.siteUrl}/classes/` },
      { "@type": "ListItem", position: 3, name: "Mage", item: `${siteConfig.siteUrl}/classes/mage/` },
    ],
  },
];

const mageMilestones = [
  { lv: 1, hp: 75, atk: 6, def: 5, mag: 18, spd: 10, crit: "4.0%", dodge: "4.0%" },
  { lv: 3, hp: 87, atk: 8, def: 7, mag: 24, spd: 12, crit: "4.6%", dodge: "4.4%" },
  { lv: 5, hp: 99, atk: 9, def: 9, mag: 29, spd: 15, crit: "5.2%", dodge: "4.8%" },
  { lv: 8, hp: 117, atk: 12, def: 11, mag: 38, spd: 18, crit: "6.1%", dodge: "5.4%" },
  { lv: 10, hp: 129, atk: 13, def: 13, mag: 43, spd: 21, crit: "6.7%", dodge: "5.8%" },
  { lv: 15, hp: 159, atk: 17, def: 18, mag: 57, spd: 27, crit: "8.2%", dodge: "6.8%" },
  { lv: 20, hp: 189, atk: 21, def: 22, mag: 71, spd: 33, crit: "9.7%", dodge: "7.8%" },
  { lv: 25, hp: 219, atk: 25, def: 27, mag: 85, spd: 39, crit: "11.2%", dodge: "8.8%" },
  { lv: 30, hp: 249, atk: 29, def: 31, mag: 99, spd: 45, crit: "12.7%", dodge: "9.8%" },
];


const faqItems = [
  {
    "question": "How do Mage characters manage Energy sustain during prolonged boss fights?",
    "answer": "Mage characters manage Energy sustain through staff weapon enchantments, tactical turn pacing, and Energy management. Pairing with the Vesper race provides an expanded Energy pool, while Nightborne grants lifesteal sustain during extended dungeon encounters."
  },
  {
    "question": "Is Cleric viable as a solo leveling archetype or only in party raids?",
    "answer": "While Cleric excels as the premier party healer in Guild Raids, it is completely viable for solo leveling thanks to holy radiant smites and self-sustain. Clerics deal bonus holy damage against undead dungeon monsters in Act 2, allowing steady progression without purchasing healing consumables."
  },
  {
    "question": "How does the Hexer Super Class bypass boss magical resistances?",
    "answer": "Hexer applies stacking decay curses that tick during every enemy turn phase while reducing target magic defense. Because decay damage bypasses mob armor, Hexer curses melt high-armor Torment bosses that otherwise resist direct elemental burst spells."
  },
  {
    "question": "Which races pair best with Mage archetypes in Pixel Lineage?",
    "answer": "Vesper and Celestine represent top racial synergies for Mages. Vesper provides +8% Magic damage, an expanded Energy pool, and skill evasion. Celestine provides +6% Crit, +4% Dodge, and +6% Magic. Nightborne also offers valuable lifesteal sustain."
  }
];
---


<BaseLayout
  title="Mage Class Guide: Stats & Super Classes"
  description="Complete Pixel Lineage Mage class guide: Lv 1-30 stat growths, Cleric, Hexer, and Summoner Super Classes, spell rotations, and arcane burst builds."
  canonical="/classes/mage/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/classes/" style="color: var(--accent); text-decoration: none;">Classes</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Mage</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(168, 85, 247, 0.15); border: 1px solid #a855f7; color: #a855f7; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Core Archetype · Arcane Burst & Holy Restoration
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Mage Class Guide: Stats & Super Classes
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        The definitive tactical guide to the Mage archetype in Pixel Lineage on Roblox. Featuring community-reported Level 1 to 30 attribute progressions (verify in game), in-depth breakdowns of Cleric, Hexer, and Summoner Super Class evolutions, and endgame raid rotation engineering.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


    <!-- Hero Image Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/cards/card_mage.webp"
        alt="Pixel Lineage Mage Class Arcane Destruction and Healing Combat"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

            <!-- Video Showcase (Tactical Walkthrough) -->
        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px; margin-bottom: 36px;">
          <h2 id="official-video-showcase" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">Official Video Reference: Mage Combat & Progression</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
            Comprehensive Pixel Lineage gameplay walkthrough demonstrating Mage spell rotations, Energy management, and Cleric/Hexer support.
          </p>
          <VideoEmbed
            id="1pdNdjCu7BM"
            title="Pixel Lineage Mage Class Arcane & Healing Rotation Walkthrough"
            channelTitle="OyO"
            uploadDate="2026-10-18T12:00:00+00:00"
            description="Comprehensive Pixel Lineage gameplay walkthrough demonstrating Mage spell rotations, Energy management, and Cleric/Hexer support."
          />
        </section>

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

<!-- Combat Philosophy & Archetype Overview -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #a855f7; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="mage-combat-philosophy-baseline-archetype" style="font-size: 1.25rem; color: #a855f7; margin: 0 0 12px;">Mage Combat Philosophy & Baseline Archetype</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
          The Mage is Pixel Lineage's premier glass cannon and utility master. Starting with 18 base Magic (MAG) and gaining +2.8 MAG per level, Mages possess the steepest offensive scaling curve in the game. While physical weapon users must punch through enemy armor ratings, arcane spells deal elemental and true damage that completely bypasses mob physical defense shields.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          However, this immense destructive potential comes at the cost of fragile base survivability (75 HP and 5 DEF at Level 1). At Level 15 in Act 2, Mages evolve into one of three distinct Super Classes at the Trainer's Shrine: <strong>Cleric</strong> (party-wide healing and cleanse savior), <strong>Hexer</strong> (curse decay and lifesteal warlock), or <strong>Summoner</strong> (golem tanking and extra turn actions). This choice is permanent and shapes your entire endgame identity.
        </p>
      </section>

      <!-- Complete Level 1 to 30 Milestone Growth Table -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 14px;">
          <h2 id="complete-level-1-to-30-attribute-growth-ledger" style="font-size: 1.3rem; color: #fff; margin: 0;">Complete Level 1 to 30 Attribute Growth Ledger</h2>
          <span style="font-family: var(--font-mono); font-size: 0.8rem; color: #a855f7;">Formula: HP +6.0/lv · MAG +2.8/lv · SPD +1.2/lv</span>
        </div>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          These milestone statistics reflect baseline Mage scaling based on community reports (verify in game). Magic progression reaches notable thresholds at Level 15 and Level 30:
        </p>

        <div style="overflow-x: auto;">
          <table class="responsive-card-table class-milestone-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
            <thead>
              <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                <th style="padding: 10px 12px;">Milestone Level</th>
                <th style="padding: 10px 12px;">HP</th>
                <th style="padding: 10px 12px;">ATK</th>
                <th style="padding: 10px 12px;">DEF</th>
                <th style="padding: 10px 12px;">MAG</th>
                <th style="padding: 10px 12px;">SPD</th>
                <th style="padding: 10px 12px;">Crit%</th>
                <th style="padding: 10px 12px;">Dodge%</th>
              </tr>
            </thead>
            <tbody>
              {mageMilestones.map((m) => (
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Milestone Level" style="padding: 10px 12px; font-weight: 700; color: #fff;">Level {m.lv}</td>
                  <td data-label="HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">{m.hp}</td>
                  <td data-label="ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">{m.atk}</td>
                  <td data-label="DEF" style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">{m.def}</td>
                  <td data-label="MAG" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7; font-weight: 700;">{m.mag}</td>
                  <td data-label="SPD" style="padding: 10px 12px; font-family: var(--font-mono); color: #e2e8f0;">{m.spd}</td>
                  <td data-label="Crit%" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">{m.crit}</td>
                  <td data-label="Dodge%" style="padding: 10px 12px; font-family: var(--font-mono); color: #94a3b8;">{m.dodge}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="color: var(--muted); font-size: 0.82rem; margin-top: 12px;">
          *Level 1 to 30 attribute progressions are community-reported; verify in game. For comparative curves across all classes, visit the complete <a href="/classes/stats/" style="color: var(--accent); text-decoration: none;">Class Growth Matrix</a>.
        </p>
      </section>

      <!-- The 3 Super Classes Deep Dive -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="the-3-mage-super-classes-skills-multipliers-builds" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">The 3 Mage Super Classes: Skills, Multipliers & Builds</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 20px;">
          At Level 15 in Act 2, speak to the High Arcanist at Trainer's Shrine. Choose carefully, as this selection is permanently irreversible:
        </p>

        <!-- 1. Cleric -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #38bdf8; border-radius: 6px; padding: 18px; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="1-cleric-s-tier-cooperative-healer-purifier" style="font-size: 1.15rem; color: #38bdf8; margin: 0;">1. Cleric — S Tier Cooperative Healer & Purifier</h3>
            <span style="font-size: 0.8rem; color: #38bdf8; background: rgba(56, 189, 248, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Raid Life Anchor</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Cleric is the premier cooperative healer for group expeditions. Innate passive <em>Quiet Grace</em> lowers the chance of being targeted by enemies while fighting in a party.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Smite (Unlocks on choosing Super Class)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Calls down holy radiance to strike a target enemy, dealing bonus damage against Undead or Demon foes.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Mending Light (Unlocks at Level 10)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Restores health to target party member and purges active status debuffs.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Judgement (Unlocks at Level 14)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Calls down divine wrath upon hostile ranks, unleashing party-wide holy magic damage.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> Essential for cooperative raid progression. Keeps frontline tanks alive and sustains the team through heavy incoming damage phases.
          </div>
        </div>

        <!-- 2. Hexer -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #a855f7; border-radius: 6px; padding: 18px; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="2-hexer-dark-decay-curse-specialist" style="font-size: 1.15rem; color: #a855f7; margin: 0;">2. Hexer — Dark Decay & Curse Specialist</h3>
            <span style="font-size: 0.8rem; color: #a855f7; background: rgba(168, 85, 247, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Boss Armor Bypass & Solo Carry</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Hexer is an attrition-focused solo spellcaster. Innate passive <em>Ill Omen</em> causes enemies to start battles with the Weakened debuff for 2 turns, reducing enemy damage by 15%.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Hex Bind (Unlocks on choosing Super Class)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Binds the target in dark energy, restricting mobility and inflicting steady curse decay.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Hex Bolt (Unlocks at Level 10)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Fires a concentrated missile of dark energy, dealing direct magic damage and stacking curse affliction.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Doom (Unlocks at Level 14)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Places a catastrophic doom countdown on the target, triggering massive shadow burst damage when it expires.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> High sustained solo boss damage. Debuffs bypass physical armor, allowing consistent boss clears.
          </div>
        </div>

        <!-- 3. Summoner -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #34d399; border-radius: 6px; padding: 18px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="3-summoner-arcane-construct-minion-overlord" style="font-size: 1.15rem; color: #34d399; margin: 0;">3. Summoner — Arcane Construct & Minion Overlord</h3>
            <span style="font-size: 0.8rem; color: #34d399; background: rgba(52, 211, 153, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Autonomous Army & Safe Clears</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Summoner commands arcane entities to fight on their behalf. Innate passive mechanics are not yet published in official sources.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Arcane Familiar (Unlocks on choosing Super Class)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Conjures an ethereal familiar to support the caster with ranged offensive projectiles.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Stone Guardian (Unlocks at Level 10)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Summons a resilient stone guardian to the frontline to intercept incoming physical damage.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Phoenix Call (Unlocks at Level 14)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Calls forth an astral phoenix that bombards enemy lines with fiery arcane strikes.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> Controlled, low-stress playstyle. Minions draw enemy attention, giving the Summoner room to cast safely.
          </div>
        </div>
      </section>

      <!-- Recommended Bloodline & Talent Synergies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="recommended-bloodline-talent-meta-synergies" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Recommended Bloodline & Talent Meta Synergies</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          To push your Mage build to maximum potency, pair with these top-tier racial lineages and trait setups:
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 20px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #a855f7;">
            <strong style="color: #a855f7; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/vesper/" style="color: #a855f7; text-decoration: none;">Vesper Bloodline (S+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Provides +8% Magic damage, an expanded Energy pool, and skill evasion. The definitive pairing for spellcasters to sustain continuous high-tier spell rotations.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #38bdf8;">
            <strong style="color: #38bdf8; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/celestine/" style="color: #38bdf8; text-decoration: none;">Celestine Bloodline (S+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Adds +6% Magic, +6% Crit, and +4% Dodge. The gold-standard pairing for high-critical spellcasters and raid Clerics.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #c9a227;">
            <strong style="color: #c9a227; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/sylvan/" style="color: #c9a227; text-decoration: none;">Sylvan Bloodline (A+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Provides +12% Nature damage and the Call Sylph companion summon, adding passive team healing and chip damage.
            </p>
          </div>
        </div>

        <h3 id="primary-secondary-talent-pairings" style="font-size: 1.1rem; color: #c9a227; margin: 0 0 10px;">Primary & Secondary Talent Pairings</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 12px;">
          Consult our full <a href="/traits/" style="color: var(--accent); text-decoration: none;">Traits & Drop Rates Guide</a> when rolling. For Mages, the top three talents are:
        </p>
        <ul style="color: var(--muted); font-size: 0.88rem; line-height: 1.6; padding-left: 20px; margin: 0;">
          <li><strong style="color: #fff;">Arcane Spark (+1 Starting Energy & +8% MAG):</strong> Mandatory for Mages. Starting with extra EP allows an immediate Turn 1 high-tier spell cast.</li>
          <li><strong style="color: #fff;">Survivor (+6% HP & Endure Cheat-Death):</strong> Prevents squishy casters from being instantly deleted by boss stealth ambushes or true-damage slams.</li>
          <li><strong style="color: #fff;">Prodigy (+15% Universal Attributes):</strong> The pinnacle Mythic talent. Scaling +15% on base Magic yields significant MAG before gear additions.</li>
        </ul>
      </section>

      <!-- Solo vs Multiplayer Dynamics -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="solo-vs-multiplayer-team-roles-positioning" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Solo vs Multiplayer Team Roles & Positioning</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border: 1px solid var(--line);">
            <strong style="color: #34d399; font-size: 1rem; display: block; margin-bottom: 6px;">Solo Expedition Dynamics</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              In solo play, Mages must leverage crowd control and positioning. Open with debuffs on Turn 1 before applying DoTs. When running Hexer or Summoner, your sustained curse decay and minion shields allow clearing entire dungeons safely.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border: 1px solid var(--line);">
            <strong style="color: #38bdf8; font-size: 1rem; display: block; margin-bottom: 6px;">Co-Op & Guild Raid Positioning</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              In 4-player raid groups, Mages occupy the Rear Center tile. This position shields you from frontal cleaves while keeping all 3 party allies within range of your group support abilities.
            </p>
          </div>
        </div>
      </section>

      <!-- Power Curve: Early, Mid, End Game -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="power-curve-trajectory-early-vs-mid-vs-end-game" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Power Curve Trajectory: Early vs Mid vs End Game</h2>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #eab308;">
            <strong style="color: #eab308;">Early Game (Levels 1–10): B Tier Fragility</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              With only 75 HP and 5 DEF, early game is hazardous. Mages must carefully manage Energy and positioning. High magic damage kills single targets quickly, but mob swarms require careful kiting.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399;">Mid Game (Levels 11–20): S Tier Awakening</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Unlocking Cleric, Hexer, or Summoner completely transforms the class. Base Magic hits 57, enabling AoE spells that wipe full rooms in Act 2 The Dungeon while providing self-sustaining utility.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e;">End Game (Levels 21–30): S+ Tier Raid Engine</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Reaching 99 base Magic and equipping high-tier staves produces massive damage ticks. In Torment Raids, having a Cleric is essential for survival, while Hexers melt raid boss health pools consistently.
            </p>
          </div>
        </div>
      </section>

      <!-- Best-in-Slot Equipment Synergies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="recommended-best-in-slot-equipment-synergies" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Recommended Best-in-Slot Equipment Synergies</h2>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #a855f7;">Weapon: Netherflame Staff of the Archmage</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Grants Magic ATK, Spell Crit Chance, and reduces Energy costs of Tier-2 spells by 1 EP.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #38bdf8;">Armor Set: Blessed Silk Vestments (Tier 3 Spellcaster Robes)</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Provides +28 DEF, +220 Max HP, and Healing/Decay amplification. Provides the defensive bulk needed for sustained raid battles.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #c9a227;">Accessory: Chrono-Warped Amulet of the Eclipse</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Restores Energy at the start of every combat turn and adds Critical Strike Multiplier to magical spells.
            </p>
          </div>
        </div>
        <p style="color: var(--muted); font-size: 0.82rem; margin-top: 12px;">
          *Equipment synergies and statistics are community-reported, verify in game.
        </p>
      </section>

      <!-- Frequently Asked Questions -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="frequently-asked-questions-about-the-mage" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Frequently Asked Questions About the Mage</h2>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div>
            <h3 id="can-spell-attacks-trigger-critical-strike-damage-in-pixel-lineage" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Can spell attacks trigger critical strike damage in Pixel Lineage?</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
              Yes. Unlike older RPG systems, offensive magic in Pixel Lineage rolls for critical strike chance on every cast and individual DoT tick. Magical crits deal 1.5x damage by default, which can be further boosted by accessories and talents.
            </p>
          </div>
          <div>
            <h3 id="does-healing-scale-with-magic-or-attack" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Does healing scale with Magic or Attack?</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
              All restorative abilities—including Cleric single-target prayers and AoE group heals—scale 100% with your total Magic attribute. Attack has zero impact on healing output.
            </p>
          </div>
          <div>
            <h3 id="which-super-class-is-best-for-solo-players-cleric-or-hexer" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Which Super Class is best for solo players: Cleric or Hexer?</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
              Hexer is substantially superior for solo players due to passive lifesteal and dark curse decay that bypasses monster armor. Cleric is designed primarily for multi-player co-op and guild raid coordination.
            </p>
          </div>
        </div>
      </section>

      <!-- Cross Navigation -->
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/classes/super-classes/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Compare All 21 Super Classes →
        </a>
        <a href="/calculator/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Simulate Mage in Combat Calculator →
        </a>
      </div>
          
      <!-- Frequently Asked Questions Accordion -->
      <FaqSection items={faqItems} />
