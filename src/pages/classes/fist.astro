---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Fist Class Guide: Stats & Evolutions",
    description: "Complete Pixel Lineage Fist class guide: Lv 1-30 stat growths, Monk, Brawler, and Oni Super Classes, poise break formulas, and martial brawler builds.",
    url: `${siteConfig.siteUrl}/classes/fist/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Classes", item: `${siteConfig.siteUrl}/classes/` },
      { "@type": "ListItem", position: 3, name: "Fist", item: `${siteConfig.siteUrl}/classes/fist/` },
    ],
  },
];

const fistMilestones = [
  { lv: 1, hp: 105, atk: 15, def: 8, mag: 6, spd: 12, crit: "8.0%", dodge: "6.0%" },
  { lv: 3, hp: 125, atk: 20, def: 11, mag: 7, spd: 15, crit: "8.8%", dodge: "6.6%" },
  { lv: 5, hp: 145, atk: 24, def: 13, mag: 9, spd: 18, crit: "9.6%", dodge: "7.2%" },
  { lv: 8, hp: 175, atk: 31, def: 17, mag: 11, spd: 22, crit: "10.8%", dodge: "8.1%" },
  { lv: 10, hp: 195, atk: 36, def: 20, mag: 12, spd: 25, crit: "11.6%", dodge: "8.7%" },
  { lv: 15, hp: 245, atk: 47, def: 26, mag: 16, spd: 32, crit: "13.6%", dodge: "10.2%" },
  { lv: 20, hp: 295, atk: 59, def: 33, mag: 19, spd: 39, crit: "15.6%", dodge: "11.7%" },
  { lv: 25, hp: 345, atk: 70, def: 39, mag: 23, spd: 46, crit: "17.6%", dodge: "13.2%" },
  { lv: 30, hp: 395, atk: 82, def: 46, mag: 26, spd: 53, crit: "19.6%", dodge: "14.7%" },
];


const faqItems = [
  {
    "question": "How does Poise Break work on Fist class combatants in Pixel Lineage?",
    "answer": "Every unarmed strike from a Fist combatant reduces the target enemy's hidden poise gauge. When an enemy's poise breaks, their current turn action is cancelled, stunning them until the following combat round. This enables Fist players to lock down dangerous elite casters and boss mechanics."
  },
  {
    "question": "Which Fist Super Class offers the highest burst damage potential?",
    "answer": "The Monk Super Class delivers the highest burst damage potential by chaining chi strikes into devastating combo finishers. When properly buffed with critical hit gear and the Fortune's Favor talent, Monk combo strikes can execute dungeon bosses in just two combat turns."
  },
  {
    "question": "Does Fist scale with physical Attack or Magic attributes?",
    "answer": "Standard Fist weapon scaling relies primarily on the physical Attack stat and character Speed for turn order. However, the Mystic Fist Super Class evolution introduces hybrid scaling, converting a portion of your Magic attribute into elemental shockwave damage across front-row enemy tiles."
  },
  {
    "question": "What equipment set should a Fist player prioritize in Act 2?",
    "answer": "Fist players should prioritize acquiring the Windwalker leather armor set and Dragonbone Cestus wraps from the Mountain Dragon Lair. This equipment combination provides substantial bonus Attack, fourteen percent Poise Break chance, and increased turn speed to ensure uninterrupted combo chains against heavily armored dungeon adversaries."
  }
];
---


<BaseLayout
  title="Fist Class Guide: Stats & Super Classes"
  description="Complete Pixel Lineage Fist class guide: Lv 1-30 stat growths, Monk, Brawler, and Oni Super Classes, poise break formulas, and martial brawler builds."
  canonical="/classes/fist/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/classes/" style="color: var(--accent); text-decoration: none;">Classes</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Fist</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(244, 63, 94, 0.15); border: 1px solid #f43f5e; color: #f43f5e; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Core Archetype · Poise Breaker & Stun Brawler
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Fist Class Guide: Stats & Super Classes
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        The definitive tactical guide to the Fist archetype in Pixel Lineage on Roblox. Featuring verified Level 1 to 30 attribute progressions, in-depth breakdowns of Monk, Brawler, and Oni Super Class evolutions, poise break formulas, and stun lock brawler builds.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />

    <!-- Hero Image Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/cards/card_fist.webp"
        alt="Pixel Lineage Fist Class Martial Arts and Stun Brawler Combat"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

            <!-- Video Showcase (Tactical Walkthrough) -->
        <section id="official-video-showcase" style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px; margin-bottom: 36px;">
          <h2 id="official-video-showcase" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">Official Video Reference: Fist Combat & Progression</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
            Comprehensive Pixel Lineage gameplay walkthrough demonstrating Fist martial arts rotations, stance switching, and stun lock mechanics.
          </p>
          <VideoEmbed
            id="1pdNdjCu7BM"
            title="Pixel Lineage Fist Class Martial Arts & Poise Break Walkthrough"
            channelTitle="OyO"
            uploadDate="2026-10-18T12:00:00+00:00"
            description="Comprehensive Pixel Lineage gameplay walkthrough demonstrating Fist martial arts rotations, stance switching, and stun lock mechanics."
          />
        </section>

<!-- Combat Philosophy & Archetype Overview -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #f43f5e; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="fist-combat-philosophy-baseline-archetype" style="font-size: 1.25rem; color: #f43f5e; margin: 0 0 12px;">Fist Combat Philosophy & Baseline Archetype</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
          The Fist archetype is Pixel Lineage's premier hybrid of overwhelming physical offense, crowd control stagger, and agile melee poise. Starting with 15 base Attack (the highest base ATK at Level 1 across all 6 classes) and a solid 105 HP buffer, Fist brawlers do not merely deal damage—they break enemy poise meters.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          In Pixel Lineage Build 1.0.3, poise break is computed via the formula <code style="color: #c9a227;">Poise_Damage = (ATK * 0.45) + (SPD * 0.2)</code>. Because Fist scales both ATK (+2.3/lv) and SPD (+1.4/lv) simultaneously, Fist characters possess the unique capability to stun lock dangerous Act 2 and Act 3 dungeon bosses. At Level 15, the Trainer's Shrine offers three distinct permanent evolutions: <strong>Monk</strong>, <strong>Brawler</strong>, or <strong>Oni</strong>.
        </p>
      </section>

      <!-- Complete Level 1 to 30 Milestone Growth Table -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 14px;">
          <h2 id="complete-level-1-to-30-attribute-growth-ledger" style="font-size: 1.3rem; color: #fff; margin: 0;">Complete Level 1 to 30 Attribute Growth Ledger</h2>
          <span style="font-family: var(--font-mono); font-size: 0.8rem; color: #f43f5e;">Formula: HP +10.0/lv · ATK +2.3/lv · DEF +1.3/lv</span>
        </div>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          These milestone statistics reflect pure baseline Fist scaling. Notice how Attack reaches 47 at Level 15 and 82 at Level 30, providing unmatched martial striking power:
        </p>

        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
            <thead>
              <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                <th style="padding: 10px 12px;">Milestone Level</th>
                <th style="padding: 10px 12px;">HP</th>
                <th style="padding: 10px 12px;">ATK</th>
                <th style="padding: 10px 12px;">DEF</th>
                <th style="padding: 10px 12px;">MAG</th>
                <th style="padding: 10px 12px;">SPD</th>
                <th style="padding: 10px 12px;">Crit%</th>
                <th style="padding: 10px 12px;">Dodge%</th>
              </tr>
            </thead>
            <tbody>
              {fistMilestones.map((m) => (
                <tr style="border-bottom: 1px solid var(--line);">
                  <td style="padding: 10px 12px; font-weight: 700; color: #fff;">Level {m.lv}</td>
                  <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">{m.hp}</td>
                  <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e; font-weight: 700;">{m.atk}</td>
                  <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">{m.def}</td>
                  <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">{m.mag}</td>
                  <td style="padding: 10px 12px; font-family: var(--font-mono); color: #e2e8f0;">{m.spd}</td>
                  <td style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">{m.crit}</td>
                  <td style="padding: 10px 12px; font-family: var(--font-mono); color: #94a3b8;">{m.dodge}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="color: var(--muted); font-size: 0.82rem; margin-top: 12px;">
          *For comparative curves across all classes, visit the complete <a href="/classes/stats/" style="color: var(--accent); text-decoration: none;">Class Growth Matrix</a>.
        </p>
      </section>

      <!-- The 3 Super Classes Deep Dive -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="the-3-fist-super-classes-skills-multipliers-builds" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">The 3 Fist Super Classes: Skills, Multipliers & Builds</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 20px;">
          At Level 15 in Act 2, speak to the Grandmaster at Trainer's Shrine. Choose carefully, as your martial path is permanently locked:
        </p>

        <!-- 1. Monk -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #38bdf8; border-radius: 6px; padding: 18px; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="1-monk-spirit-palm-counter-defense" style="font-size: 1.15rem; color: #38bdf8; margin: 0;">1. Monk — Spirit Palm & Counter Defense</h3>
            <span style="font-size: 0.8rem; color: #38bdf8; background: rgba(56, 189, 248, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Fluid Tank & Counter Striker</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Monk channels spiritual Ki to deflect incoming attacks while striking nerve clusters. Innate passive <em>Iron Palm Flow</em> grants a 25% chance to completely parry incoming physical strikes and immediately retaliate.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Spirit Palm Thrust (Cost: 1 EP · 0 Turn CD)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Strikes enemy pressure points for 125% ATK, reducing enemy Attack by 20% and restoring 15 Ki energy.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Zen Meditation (Cost: 2 EP · 3 Turn CD)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Purges all debuffs and recovers 25% max HP while creating a barrier absorbing 200 physical and magical damage.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Hundred Hands of Nirvana (Cost: 3 EP · Ultimate · 4 Turn CD)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Delivers an eight-hit palm combination dealing 280% total ATK. Inflicts Silence and Action Gauge freeze for 1 round.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> The ultimate defensive duelist. Parries boss attacks while self-healing, making solo high-difficulty clears extremely consistent.
          </div>
        </div>

        <!-- 2. Brawler -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #f43f5e; border-radius: 6px; padding: 18px; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="2-brawler-poise-breaker-stun-specialist" style="font-size: 1.15rem; color: #f43f5e; margin: 0;">2. Brawler — Poise Breaker & Stun Specialist</h3>
            <span style="font-size: 0.8rem; color: #f43f5e; background: rgba(244, 63, 94, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Boss Interrupt & Stagger King</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Brawler specializes in relentless close-quarters blunt force. Innate passive <em>Concussive Force</em> doubles all poise damage dealt, allowing standard attacks to stagger and delay boss action queues.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Shattering Haymaker (Cost: 1 EP · 0 Turn CD)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Heavy hook punch dealing 140% ATK. Deals 2.5x poise damage against armored and shielded targets.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Seismic Ground Stomp (Cost: 2 EP · 2 Turn CD)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Slams both fists into the floor, dealing 160% AoE physical damage and pushing all enemy turn meters back by 25%.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Skullcracker Combo (Cost: 3 EP · Ultimate · 4 Turn CD)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Pummels target for 310% ATK. Guarantees a 2-round hard Stun, completely shutting down boss enrage phases.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> Essential in 4-player Guild Raids. Keeping raid bosses permanently staggered prevents wipe attacks and creates huge damage windows for allies.
          </div>
        </div>

        <!-- 3. Oni -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #ea580c; border-radius: 6px; padding: 18px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="3-oni-demonic-rage-berserk-carnage" style="font-size: 1.15rem; color: #ea580c; margin: 0;">3. Oni — Demonic Rage & Berserk Carnage</h3>
            <span style="font-size: 0.8rem; color: #ea580c; background: rgba(234, 88, 12, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Dark Physical Hypercarry</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Oni taps into demonic blood covenants to gain massive attack scaling at the expense of defensive resilience. Innate passive <em>Demonic Rampage</em> elevates Total Attack by +30% while converting 20% of defense into flat attack.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Blood Gore Claws (Cost: 1 EP · 0 Turn CD)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Rips through flesh for 150% ATK, inflicting Deep Wounds that increase target physical damage taken by 15%.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Hellfire Roar (Cost: 2 EP · 3 Turn CD)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Sacrifices 10% current HP to gain +45% Attack and 15% Critical Chance for 2 rounds. Immunizes character against crowd control.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Cataclysmic Asura Slam (Cost: 3 EP · Ultimate · 5 Turn CD)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Delivers an earth-shattering blow for 360% ATK. If the target dies, immediately restores 2 Energy Points and resets all cooldowns.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> Brutal burst damage. One-shots elite dungeon mobs, though low base defense requires careful health management or lifesteal gear.
          </div>
        </div>
      </section>

      <!-- Recommended Bloodline & Talent Synergies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="recommended-bloodline-talent-meta-synergies" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Recommended Bloodline & Talent Meta Synergies</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Fist scaling excels when paired with brawler and sustain racial lineages:
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 20px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #ea580c;">
            <strong style="color: #ea580c; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/orc/" style="color: #ea580c; text-decoration: none;">Orc Bloodline (S+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Adds +12% Max HP, stun resistance, and +15% ATK below 30% HP. Stacks with the Oni demonic rage multiplier to deliver earth-shattering counter-punches.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/dullahan/" style="color: #f43f5e; text-decoration: none;">Dullahan Bloodline (S Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Headless Poise provides complete stun immunity, allowing the Brawler to channel heavy punches without fear of being interrupted by boss crowd control.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #a855f7;">
            <strong style="color: #a855f7; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/nightborn/" style="color: #a855f7; text-decoration: none;">Nightborn Bloodline (A+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Innate 15% critical lifesteal replenishes health on every flurry crit, giving the Fist brawler self-sustaining brawling power in prolonged dungeon bouts.
            </p>
          </div>
        </div>

        <h3 id="primary-secondary-talent-pairings" style="font-size: 1.1rem; color: #c9a227; margin: 0 0 10px;">Primary & Secondary Talent Pairings</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 12px;">
          Consult our full <a href="/traits/" style="color: var(--accent); text-decoration: none;">Traits & Drop Rates Guide</a> when rolling. For Fist characters, the top three talents are:
        </p>
        <ul style="color: var(--muted); font-size: 0.88rem; line-height: 1.6; padding-left: 20px; margin: 0;">
          <li><strong style="color: #fff;">Bloodthirst (12% Lifesteal on Crit):</strong> The undisputed best talent for Oni and Brawler. Restores massive health pools during multi-hit ultimate combos.</li>
          <li><strong style="color: #fff;">Survivor (+6% HP & Endure Cheat-Death):</strong> Protects aggressive brawlers who trade hits at close range from sudden fatal boss spikes.</li>
          <li><strong style="color: #fff;">Iron Soul (+6% DEF & 30% Ailment Resist):</strong> Strengthens the Monk's parry defense, turning you into an unshakeable counter-tank.</li>
        </ul>
      </section>

      <!-- Solo vs Multiplayer Dynamics -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="solo-vs-multiplayer-team-roles-positioning" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Solo vs Multiplayer Team Roles & Positioning</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border: 1px solid var(--line);">
            <strong style="color: #34d399; font-size: 1rem; display: block; margin-bottom: 6px;">Solo Expedition Efficacy</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Fist excels in solo play due to 15 base Attack and heavy stun capability. You can reliably stun lock elite monsters in 1v1 combat, preventing them from casting dangerous curses or calling reinforcements. Clear speeds are rapid and potion expenditure is minimal.
            </p>
          </div>

