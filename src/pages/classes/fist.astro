---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Fist Class Guide: Oni & Brawler",
    description: "Complete Pixel Lineage Fist class guide: Lv 1-30 stat growths, poise break scaling, Oni, Brawler, and Monk Super Class builds on Roblox.",
    url: `${siteConfig.siteUrl}/classes/fist/`,
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Classes", item: `${siteConfig.siteUrl}/classes/` },
      { "@type": "ListItem", position: 3, name: "Fist", item: `${siteConfig.siteUrl}/classes/fist/` },
    ],
  },
];
---

<BaseLayout
  title="Pixel Lineage Fist Class Guide: Oni & Brawler"
  description="Complete Pixel Lineage Fist class guide: Lv 1-30 stat growths, poise break scaling, Oni, Brawler, and Monk Super Class builds on Roblox."
  canonical="/classes/fist/"
  jsonLd={jsonLd}
>
  <div class="container" style="max-width: 860px; margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/classes/" style="color: var(--accent); text-decoration: none;">Classes</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Fist</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(244, 63, 94, 0.15); border: 1px solid #f43f5e; color: #f43f5e; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Archetype Overview · Martial Mastery
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Fist Class Guide
      </h1>
      <p style="color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0;">
        Specializing in rapid multi-hit combos, poise breaks, and turn lockouts, the Fist archetype requires no expensive weapon purchases and scales naturally into the S-Tier Oni evolution.
      </p>
    </header>

    <article style="line-height: 1.7; color: var(--ink);">
      <!-- Attribute Progression Matrix -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; margin-bottom: 36px;">
        <div style="background: #1d152c; padding: 14px 20px; border-bottom: 1px solid var(--line);">
          <h2 style="font-size: 1.25rem; color: var(--ink); margin: 0;">Fist Stat Growth Milestones</h2>
        </div>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead>
              <tr style="border-bottom: 1px solid var(--line); background: #13101c;">
                <th style="padding: 10px 14px; color: var(--muted);">Level</th>
                <th style="padding: 10px 14px; color: var(--muted);">HP</th>
                <th style="padding: 10px 14px; color: var(--muted);">Attack</th>
                <th style="padding: 10px 14px; color: var(--muted);">Defense</th>
                <th style="padding: 10px 14px; color: var(--muted);">Magic</th>
                <th style="padding: 10px 14px; color: var(--muted);">Speed</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: 700; color: #f43f5e;">Lv 1 (Starter)</td>
                <td style="padding: 10px 14px;">105</td>
                <td style="padding: 10px 14px;">15</td>
                <td style="padding: 10px 14px;">8</td>
                <td style="padding: 10px 14px;">6</td>
                <td style="padding: 10px 14px;">12</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: 700;">Lv 10 (Act 1 Clear)</td>
                <td style="padding: 10px 14px;">230</td>
                <td style="padding: 10px 14px;">34</td>
                <td style="padding: 10px 14px;">18</td>
                <td style="padding: 10px 14px;">12</td>
                <td style="padding: 10px 14px;">25</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: 700; color: #c9a227;">Lv 20 (Super Class)</td>
                <td style="padding: 10px 14px;">420</td>
                <td style="padding: 10px 14px;">68</td>
                <td style="padding: 10px 14px;">36</td>
                <td style="padding: 10px 14px;">22</td>
                <td style="padding: 10px 14px;">46</td>
              </tr>
              <tr>
                <td style="padding: 10px 14px; font-weight: 700; color: #f43f5e;">Lv 30 (Endgame)</td>
                <td style="padding: 10px 14px;">660</td>
                <td style="padding: 10px 14px;">112</td>
                <td style="padding: 10px 14px;">58</td>
                <td style="padding: 10px 14px;">34</td>
                <td style="padding: 10px 14px;">72</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 3 Super Class Paths -->
      <h2 style="font-size: 1.4rem; color: var(--ink); margin: 32px 0 16px;">Fist Super Class Branching Paths</h2>

      <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 36px;">
        <div style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #f43f5e; border-radius: 8px; padding: 20px;">
          <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #f43f5e;">1. Oni (S-Tier Demonic Berserker)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 10px;">
            The premier martial evolution. <strong>Ogre Rush</strong> strikes 4 times with an independent 15% Stun check per blow, completely shutting down Act 2 and 3 dungeon bosses before they can execute mechanics.
          </p>
          <div style="font-size: 0.85rem; color: #c9a227;">Best Racial Synergy: <strong>Draconic</strong> (+12% Defense + burn reflection).</div>
        </div>

        <div style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #ea580c; border-radius: 8px; padding: 20px;">
          <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #ea580c;">2. Brawler (Counter Striker & Armor Breaker)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 10px;">
            Punishes aggressive monsters through <strong>Counter Cross</strong> (200% retaliation on hit) while <strong>Iron Knuckle</strong> permanently shreds 20% of target Defense.
          </p>
          <div style="font-size: 0.85rem; color: #c9a227;">Best Racial Synergy: <strong>Dwarf</strong> (+10% Maximum HP).</div>
        </div>

        <div style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #38bdf8; border-radius: 8px; padding: 20px;">
          <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #38bdf8;">3. Monk (Hybrid Ki & Debuff Cleansing)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 10px;">
            Channels Ki energy to manipulate turn order with <strong>Palm Strike</strong>. <strong>Inner Peace</strong> restores 20% HP and renders the Monk completely immune to status debuffs.
          </p>
          <div style="font-size: 0.85rem; color: #c9a227;">Best Racial Synergy: <strong>Human</strong> or <strong>High Elf</strong>.</div>
        </div>
      </div>

      <!-- Evidence Dossier -->
      <section style="background: #1d152c; border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin-bottom: 32px;">
        <h3 style="margin: 0 0 10px; font-size: 1.1rem; color: #c9a227; text-transform: uppercase;">Evidence Dossier: Fist Growth Formula</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0 0 8px;">
          Growth per level formula: <code>HP +13.5 | ATK +2.2 | DEF +1.2 | MAG +0.6 | SPD +1.4</code>.
        </p>
        <p style="color: var(--muted); font-size: 0.85rem; margin: 0;">
          Weapon affinity: Brass Knuckles, Claws, Handwraps, Monastic Gi.
        </p>
      </section>

      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/classes/super-classes/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Full 18 Super Classes Guide →
        </a>
        <a href="/tier-list/talent-tier-list/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Best Talents for Fist Characters →
        </a>
      </div>
    </article>
  </div>
</BaseLayout>
