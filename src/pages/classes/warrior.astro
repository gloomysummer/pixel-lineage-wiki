---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import MobileToc from "../../components/MobileToc.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Warrior Class Guide: Stats & Builds",
    description: "Complete Pixel Lineage Warrior class guide: Lv 1-30 stat growth tables, Berserk, Sentinel, and Greatsword Super Classes, and endgame raid builds.",
    url: `${siteConfig.siteUrl}/classes/warrior/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Classes", item: `${siteConfig.siteUrl}/classes/` },
      { "@type": "ListItem", position: 3, name: "Warrior", item: `${siteConfig.siteUrl}/classes/warrior/` },
    ],
  },
];

const warriorMilestones = [
  { lv: 1, hp: 120, atk: 14, def: 12, mag: 4, spd: 8, crit: "5.0%", dodge: "3.0%" },
  { lv: 3, hp: 144, atk: 18, def: 16, mag: 5, spd: 10, crit: "5.4%", dodge: "3.2%" },
  { lv: 5, hp: 168, atk: 23, def: 19, mag: 6, spd: 11, crit: "5.8%", dodge: "3.4%" },
  { lv: 8, hp: 204, atk: 29, def: 25, mag: 8, spd: 14, crit: "6.4%", dodge: "3.7%" },
  { lv: 10, hp: 228, atk: 34, def: 28, mag: 9, spd: 15, crit: "6.8%", dodge: "3.9%" },
  { lv: 15, hp: 288, atk: 45, def: 37, mag: 11, spd: 19, crit: "7.8%", dodge: "4.4%" },
  { lv: 20, hp: 348, atk: 56, def: 46, mag: 14, spd: 23, crit: "8.8%", dodge: "4.9%" },
  { lv: 25, hp: 408, atk: 67, def: 55, mag: 16, spd: 27, crit: "9.8%", dodge: "5.4%" },
  { lv: 30, hp: 468, atk: 78, def: 64, mag: 19, spd: 31, crit: "10.8%", dodge: "5.9%" },
];


const faqItems = [
  {
    "question": "Can I change my base class from Warrior to another class later?",
    "answer": "Base class selection is permanent and irreversible for your character save file in Pixel Lineage. If you choose Warrior at character creation, you cannot swap to Mage, Thief, or Archer without creating a new character slot. You can, however, customize your combat role by selecting one of three distinct Super Classes at level ten."
  },
  {
    "question": "Which Warrior Super Class is best for solo player progression?",
    "answer": "The Berserk Super Class is widely recognized as the premier solo progression choice due to its aggressive missing-health attack scaling and lifesteal passives. Solo players can defeat Act 2 dungeon bosses quickly without relying on external healing support by maintaining controlled low-health damage bursts."
  },
  {
    "question": "Is the Sentinel Super Class necessary for endgame Guild Raids?",
    "answer": "Sentinel is virtually mandatory for high-tier Guild Raids because it provides sixty-five percent physical damage mitigation and party-wide taunt mechanics. Without a dedicated Sentinel absorbing heavy boss cleaves, fragile spellcasters and burst rogues get eliminated by unavoidable AoE ground slams in Torment encounters."
  },
  {
    "question": "What is the optimal playable race pairing for a Warrior build?",
    "answer": "Ashborn and Dullahan represent two of the strongest racial lineages for Warrior characters in the current meta. Ashborn provides innate bonus attack and maximum health (+6% ATK, +8% max HP), while Dullahan offers bonus health, defense, and crit (+5% max HP, +5% DEF, +3% Crit) that synergize with heavy frontline and tanking setups."
  }
];
---


<BaseLayout
  title="Warrior Class Guide: Stats & Super Classes"
  description="Complete Pixel Lineage Warrior class guide: Lv 1-30 stat growth tables, Berserk, Sentinel, and Greatsword Super Classes, and endgame raid builds."
  canonical="/classes/warrior/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/classes/" style="color: var(--accent); text-decoration: none;">Classes</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Warrior</span>
    </nav>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
        <header style="margin-bottom: 32px;">
          <div style="display: inline-block; background: rgba(234, 88, 12, 0.15); border: 1px solid #ea580c; color: #ea580c; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
            Core Archetype · Heavy Frontline & Melee Cleave
          </div>
          <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
            Pixel Lineage Warrior Class Guide: Stats & Super Classes
          </h1>
          <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
            The definitive tactical guide to the Warrior archetype in Pixel Lineage on Roblox. Featuring community-reported Level 1 to 30 attribute progressions (verify in game), in-depth breakdowns of Berserk, Sentinel, and Greatsword Super Class evolutions, optimal bloodline pairings, and endgame raid rotation engineering.
          </p>
        </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


        <!-- Hero Image Banner -->
        <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
          <img
            src="/images/cards/card_warrior.webp"
            alt="Pixel Lineage Warrior Class Frontline Tanking and Cleave Combat"
            width="1200"
            height="675"
            style="width: 100%; height: auto; display: block;"
            loading="eager"
          />
        </div>
            <!-- Video Showcase (Tactical Walkthrough) -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="official-video-showcase" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">Official Video Reference: Warrior Combat & Progression</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Verified live gameplay walkthrough by OyO demonstrating early-game Warrior progression, melee cleave positioning, and dungeon tanking fundamentals.
        </p>
        <VideoEmbed
          id="1pdNdjCu7BM"
          title="Pixel Lineage Warrior Class Progression & Combat Mechanics Guide"
          channelTitle="OyO"
          uploadDate="2026-10-18T12:00:00+00:00"
          description="Comprehensive Pixel Lineage beginner guide and live combat walkthrough showcasing Warrior frontline rotations and dungeon survival."
        />
      </section>

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

      <!-- Combat Philosophy & Archetype Overview -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #ea580c; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="warrior-combat-philosophy" style="font-size: 1.25rem; color: #ea580c; margin: 0 0 12px;">Warrior Combat Philosophy & Baseline Archetype</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
          The Warrior is Pixel Lineage's quintessential frontline bastion. Starting with the highest natural health pool in the game (120 HP) and 12 base Defense, Warriors excel at absorbing severe physical punishment while controlling enemy positioning. Unlike squishy agility or arcane classes that depend on RNG dodges and fragile magical barriers, Warriors mitigate damage deterministically through the hyperbolic armor formula <code style="color: #c9a227;">DEF / (DEF + 60)</code>.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          Upon reaching the Trainer's Shrine in Act 2: The Dungeon, the Warrior can permanently evolve into one of three distinct Super Classes: <strong>Berserk</strong> (low-health offensive juggernaut), <strong>Sentinel</strong> (impenetrable party vanguard), or <strong>Greatsword</strong> (wide-angle AoE mob annihilator). Because this choice is permanently irreversible, understanding their mechanics and stat interactions is essential.
        </p>
      </section>

      <!-- Complete Level 1 to 30 Milestone Growth Table -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 14px;">
          <h2 id="level-growth-ledger" style="font-size: 1.3rem; color: #fff; margin: 0;">Complete Level 1 to 30 Attribute Growth Ledger</h2>
          <span style="font-family: var(--font-mono); font-size: 0.8rem; color: #ea580c;">Formula: HP +12/lv · DEF +1.8/lv · ATK +2.2/lv</span>
        </div>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          These milestone statistics reflect baseline Warrior scaling based on community reports (verify in game). Notice how Defense scales up to provide substantial native mitigation before plate armor is factored in:
        </p>

        <div style="overflow-x: auto;">
          <table class="responsive-card-table class-milestone-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
            <thead>
              <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                <th style="padding: 10px 12px;">Milestone Level</th>
                <th style="padding: 10px 12px;">HP</th>
                <th style="padding: 10px 12px;">ATK</th>
                <th style="padding: 10px 12px;">DEF</th>
                <th style="padding: 10px 12px;">MAG</th>
                <th style="padding: 10px 12px;">SPD</th>
                <th style="padding: 10px 12px;">Crit%</th>
                <th style="padding: 10px 12px;">Dodge%</th>
              </tr>
            </thead>
            <tbody>
              {warriorMilestones.map((m) => (
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Milestone Level" style="padding: 10px 12px; font-weight: 700; color: #fff;">Level {m.lv}</td>
                  <td data-label="HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">{m.hp}</td>
                  <td data-label="ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">{m.atk}</td>
                  <td data-label="DEF" style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">{m.def}</td>
                  <td data-label="MAG" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">{m.mag}</td>
                  <td data-label="SPD" style="padding: 10px 12px; font-family: var(--font-mono); color: #e2e8f0;">{m.spd}</td>
                  <td data-label="Crit%" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">{m.crit}</td>
                  <td data-label="Dodge%" style="padding: 10px 12px; font-family: var(--font-mono); color: #94a3b8;">{m.dodge}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="color: var(--muted); font-size: 0.82rem; margin-top: 12px;">
          *Level 1 to 30 attribute progressions are community-reported; verify in game. For comparative curves across all classes, visit the complete <a href="/classes/stats/" style="color: var(--accent); text-decoration: none;">Class Growth Matrix</a>.
        </p>
      </section>

      <!-- The 3 Super Classes Deep Dive -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="super-class-evolutions" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">The 3 Warrior Super Classes: Skills, Multipliers & Builds</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 20px;">
          At Level 15 in Act 2, speak to the Ancient Knight at Trainer's Shrine. Your selection permanently rewires your skill kit and passive multipliers:
        </p>

        <!-- 1. Berserk -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #f43f5e; border-radius: 6px; padding: 18px; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="super-class-berserk" style="font-size: 1.15rem; color: #f43f5e; margin: 0;">1. Berserk — Low-HP Hypercarry</h3>
            <span style="font-size: 0.8rem; color: #34d399; background: rgba(52, 211, 153, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Solo Boss Shredder</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            Berserk converts character injury into devastating offensive violence. Innate passive <em>Blood Heat</em> elevates sword damage by up to +20% as character HP drops.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Rending Cross (Unlocks on choosing Super Class)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Delivers a fierce cross-slash with the blade, carving through hostile frontlines and capitalizing on offensive momentum.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Ruin (Unlocks at Level 10)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">A crushing strike that inflicts deep wounds on the target, shattering enemy defensive postures.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Bloodbath (Unlocks at Level 14)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Unleashes a relentless series of heavy slashing attacks to decimate weakened foes.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> Unmatched boss DPS for experienced players who can micro-manage low-health thresholds without wiping to boss true-damage spikes.
          </div>
        </div>

        <!-- 2. Sentinel -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #38bdf8; border-radius: 6px; padding: 18px; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="super-class-sentinel" style="font-size: 1.15rem; color: #38bdf8; margin: 0;">2. Sentinel — Unshakable Raid Vanguard</h3>
            <span style="font-size: 0.8rem; color: #38bdf8; background: rgba(56, 189, 248, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Raid Main Tank & Protector</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Sentinel is the definitive co-op tank. Innate passive <em>Iron Resolve</em> reduces incoming physical damage by 10% when wielding a Warrior sword.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Oathbreaker (Unlocks on choosing Super Class)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Strikes the target with disciplinary force, drawing enemy hostility and establishing frontline aggro control.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Counter Stance (Unlocks at Level 10)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Adopts a fortified guarding posture to absorb incoming attacks and retaliate against hostile melee pressure.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Falling Judgement (Unlocks at Level 14)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Leaps forward and brings down a crushing blow from above, staggering targets and reinforcing defensive ground control.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> The highest-demand class in 4-player Guild Raids and Torment Abyss expeditions. Guarantees team survival through enrage mechanics.
          </div>
        </div>

        <!-- 3. Greatsword -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #ea580c; border-radius: 6px; padding: 18px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="super-class-greatsword" style="font-size: 1.15rem; color: #ea580c; margin: 0;">3. Greatsword — Wide-Angle AoE Annihilator</h3>
            <span style="font-size: 0.8rem; color: #ea580c; background: rgba(234, 88, 12, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Mob Wave Sweeper</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            Wielding oversized Colossal weapons, the Greatsword Super Class converts heavy swings into sweeping arcs that strike multiple enemies across the battlefield. Innate passive mechanics are not yet published in official sources.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Great Cleave (Unlocks on choosing Super Class)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Sweeps a broad arc with the heavy blade, cleaving through multiple foes across the front rank.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Earthsplitter (Unlocks at Level 10)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Slams the massive blade downward with extreme momentum, cleaving the earth and staggering enemy lines.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Whirlwind (Unlocks at Level 14)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Spins with the colossal weapon in a continuous circle of steel, striking all nearby enemies in rapid succession.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> The fastest dungeon room clearer in the game. Obliterates multi-mob encounters in Act 1 and Act 2 in fewer turns than single-target classes.
          </div>
        </div>
      </section>

      <!-- Recommended Race & Talent Synergies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="bloodline-synergies" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Recommended Bloodline & Talent Meta Synergies</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          To maximize a Warrior's combat efficacy, pair your character with these verified racial lineages and trait combinations:
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 20px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/dullahan/" style="color: #f43f5e; text-decoration: none;">Dullahan Bloodline (S+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Grants +5% max HP, +5% DEF, and +3% Crit. Creates a resilient Sentinel or Greatsword tank capable of enduring sustained frontline pressure.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #ea580c;">
            <strong style="color: #ea580c; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/ashborn/" style="color: #ea580c; text-decoration: none;">Ashborn Bloodline (S Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Grants +6% Attack and +8% max HP. A formidable pairing for Berserk and Greatsword builds that benefit from raw frontline offensive scaling and added health buffer.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #38bdf8;">
            <strong style="color: #38bdf8; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/celestine/" style="color: #38bdf8; text-decoration: none;">Celestine Bloodline (A+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Provides +6% Crit, +4% Dodge, and +6% Magic. Offers evasive utility and critical strike scaling for agile melee builds.
            </p>
          </div>
        </div>

        <h3 id="talent-pairings" style="font-size: 1.1rem; color: #c9a227; margin: 0 0 10px;">Primary & Secondary Talent Pairings</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 12px;">
          Consult our full <a href="/traits/" style="color: var(--accent); text-decoration: none;">Traits & Drop Rates Guide</a> when rolling. For Warriors, the top two talents are:
        </p>
        <ul style="color: var(--muted); font-size: 0.88rem; line-height: 1.6; padding-left: 20px; margin: 0;">
          <li><strong style="color: #fff;">Iron Soul (+6% DEF & 30% Ailment Resist):</strong> Multiplies base and gear armor, pushing late-game physical damage reduction above 72%.</li>
          <li><strong style="color: #fff;">Survivor (+6% HP & Endure Cheat-Death):</strong> Prevents sudden wipes against Act 3 boss True Damage slams that bypass physical armor.</li>
          <li><strong style="color: #fff;">Bloodthirst (12% Lifesteal on Crit):</strong> Essential for Berserk Warriors to sustain continuous offensive uptime without relying on potion cooldowns.</li>
        </ul>
      </section>

      <!-- Solo vs Multiplayer Dynamics -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="team-roles" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Solo vs Multiplayer Team Roles & Positioning</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border: 1px solid var(--line);">
            <strong style="color: #34d399; font-size: 1rem; display: block; margin-bottom: 6px;">Solo Expedition Efficacy</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Warriors possess the highest early solo survivability of any class. High base HP means mistakes during the Act 1 learning curve rarely result in death. While clear speeds are slower than Thieves or Archers, Warriors comfortably solo all normal and hard mode story bosses without requiring premium consumable investments.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border: 1px solid var(--line);">
            <strong style="color: #38bdf8; font-size: 1rem; display: block; margin-bottom: 6px;">Co-Op & Guild Raid Positioning</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              In 4-player co-op, the Warrior occupies the Frontline Center grid tile. By casting Taunting Phalanx on Turn 1, the Sentinel locks boss cleave arcs onto their heavy plate armor, allowing backline Mages and Archers to channel full DPS uninterrupted by aggro shifts.
            </p>
          </div>
        </div>
      </section>

      <!-- Power Curve: Early, Mid, End Game -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="power-curve" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Power Curve Trajectory: Early vs Mid vs End Game</h2>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399;">Early Game (Levels 1–10): S Tier Dominance</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Starting with 120 HP and 12 DEF makes the Warrior virtually immune to early dungeon wipes. Goblin mobs and dungeon wolves deal negligible scratch damage, allowing rapid leveling through Act 1 chambers.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #eab308;">
            <strong style="color: #eab308;">Mid Game (Levels 11–20): A Tier Transition</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Enemy spellcaster mobs in Act 2 introduce magical and curse damage that ignores physical defense. Warriors must prioritize obtaining Tier-2 plate armor with magical resistance sockets or awaken into Sentinel to maintain tanking supremacy.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e;">End Game (Levels 21–30): S+ Tier Raid Pinnacle</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              With 468 base HP, 64 base DEF, and Tier-3 Dwarven plate armor, the Warrior reaches over 1,800+ Effective Health Pool (EHP). In Torment Mode, having a Sentinel or Berserk Warrior is mandatory to survive raid boss enrage sweeps.
            </p>
          </div>
        </div>
      </section>

      <!-- Best-in-Slot Equipment Synergies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="equipment-synergies" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Recommended Best-in-Slot Equipment Synergies</h2>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #ea580c;">Weapon: Warmonger Greataxe or Pinnacle Broadsword</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Provides +38 ATK and +15% Stun Chance on critical strikes. Synergizes with Warrior cleaves to disrupt enemy turn meters.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #38bdf8;">Armor Set: Juggernaut Bulwark Plate (Tier 3 Dungeon Plate)</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Provides +65 DEF, +140 HP, and +20% Knockback Resistance. Combined with base defense, elevates total physical mitigation to 68%+.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #c9a227;">Accessory: Bloodstone Pendant of the Vanguard</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Increases threat generation by 25% and reflects 10% of mitigated physical damage back to attackers.
            </p>
          </div>
        </div>
        <p style="color: var(--muted); font-size: 0.82rem; margin-top: 12px;">
          *Equipment synergies and statistics are community-reported, verify in game.
        </p>
      </section>

      <!-- Frequently Asked Questions -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="frequently-asked-questions" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Frequently Asked Questions About the Warrior</h2>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div>
            <h3 id="faq-reset-super-class" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Can I reset my Super Class if I choose the wrong Warrior evolution?</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
              No. In Pixel Lineage, choosing your Super Class at the Trainer's Shrine is permanently irreversible on that character slot. If you want to switch between Berserk and Sentinel, you must create a new character lineage or use an Ultra Sigil at Level 25.
            </p>
          </div>
          <div>
            <h3 id="faq-stat-allocation" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">How should I allocate stat points as a Warrior?</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
              Prioritize Defense and Attack in a 2:1 ratio until Defense hits 60 (granting 50% physical DR). Afterwards, split points evenly between Attack and Max HP, as stacking Defense past 120 yields diminishing mitigation returns.
            </p>
          </div>
          <div>
            <h3 id="faq-greatsword-torment" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Is Greatsword viable for solo Torment Mode dungeons?</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
              Greatsword clears mob rooms faster than any other melee class. However, on single-target Torment bosses, Sentinel or Berserk generally performs better due to specialized boss mitigation and execute mechanics.
            </p>
          </div>
        </div>
      </section>

      <!-- Cross Navigation -->
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/classes/super-classes/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Compare All 21 Super Classes →
        </a>
        <a href="/calculator/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Simulate Warrior in Combat Calculator →
        </a>
      </div>
    
      <!-- Frequently Asked Questions Accordion -->
      <FaqSection items={faqItems} />
