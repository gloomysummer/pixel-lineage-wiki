---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Warrior Class Guide: Evolutions",
    description: "Complete Pixel Lineage Warrior class guide: Lv 1-30 stat growths, weapon scaling, Berserk, Sentinel, and Greatsword Super Class builds on Roblox.",
    url: `${siteConfig.siteUrl}/classes/warrior/`,
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Classes", item: `${siteConfig.siteUrl}/classes/` },
      { "@type": "ListItem", position: 3, name: "Warrior", item: `${siteConfig.siteUrl}/classes/warrior/` },
    ],
  },
];
---

<BaseLayout
  title="Pixel Lineage Warrior Class Guide: Evolutions"
  description="Complete Pixel Lineage Warrior class guide: Lv 1-30 stat growths, weapon scaling, Berserk, Sentinel, and Greatsword Super Class builds on Roblox."
  canonical="/classes/warrior/"
  jsonLd={jsonLd}
>
  <div class="container" style="max-width: 860px; margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/classes/" style="color: var(--accent); text-decoration: none;">Classes</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Warrior</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(234, 88, 12, 0.15); border: 1px solid #ea580c; color: #ea580c; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Archetype Overview · Melee Frontline
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Warrior Class Guide
      </h1>
      <p style="color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0;">
        Boasting the highest base health pool (120 HP) and heavy armor mitigation, the Warrior is the prime choice for players who prefer methodical, resilient frontline combat.
      </p>
    </header>

    <article style="line-height: 1.7; color: var(--ink);">
      <!-- Attribute Progression Matrix -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; margin-bottom: 36px;">
        <div style="background: #1d152c; padding: 14px 20px; border-bottom: 1px solid var(--line);">
          <h2 style="font-size: 1.25rem; color: var(--ink); margin: 0;">Warrior Stat Growth Milestones</h2>
        </div>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead>
              <tr style="border-bottom: 1px solid var(--line); background: #13101c;">
                <th style="padding: 10px 14px; color: var(--muted);">Level</th>
                <th style="padding: 10px 14px; color: var(--muted);">HP</th>
                <th style="padding: 10px 14px; color: var(--muted);">Attack</th>
                <th style="padding: 10px 14px; color: var(--muted);">Defense</th>
                <th style="padding: 10px 14px; color: var(--muted);">Magic</th>
                <th style="padding: 10px 14px; color: var(--muted);">Speed</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: 700; color: #ea580c;">Lv 1 (Starter)</td>
                <td style="padding: 10px 14px;">120</td>
                <td style="padding: 10px 14px;">14</td>
                <td style="padding: 10px 14px;">12</td>
                <td style="padding: 10px 14px;">4</td>
                <td style="padding: 10px 14px;">8</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: 700;">Lv 10 (Act 1 Clear)</td>
                <td style="padding: 10px 14px;">260</td>
                <td style="padding: 10px 14px;">32</td>
                <td style="padding: 10px 14px;">28</td>
                <td style="padding: 10px 14px;">8</td>
                <td style="padding: 10px 14px;">16</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: 700; color: #c9a227;">Lv 20 (Super Class)</td>
                <td style="padding: 10px 14px;">480</td>
                <td style="padding: 10px 14px;">64</td>
                <td style="padding: 10px 14px;">56</td>
                <td style="padding: 10px 14px;">14</td>
                <td style="padding: 10px 14px;">28</td>
              </tr>
              <tr>
                <td style="padding: 10px 14px; font-weight: 700; color: #f43f5e;">Lv 30 (Endgame)</td>
                <td style="padding: 10px 14px;">750</td>
                <td style="padding: 10px 14px;">105</td>
                <td style="padding: 10px 14px;">92</td>
                <td style="padding: 10px 14px;">20</td>
                <td style="padding: 10px 14px;">42</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 3 Super Class Paths -->
      <h2 style="font-size: 1.4rem; color: var(--ink); margin: 32px 0 16px;">Warrior Super Class Branching Paths</h2>

      <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 36px;">
        <div style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #f43f5e; border-radius: 8px; padding: 20px;">
          <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #f43f5e;">1. Sentinel (Recommended for Solo Torment)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 10px;">
            The definitive tank evolution. Gains <strong>Fortress Stance</strong> (-45% incoming damage) and <strong>Spiked Aegis</strong> (25% damage reflection). Eliminates the risk of fatal one-shots from high-level dungeon bosses.
          </p>
          <div style="font-size: 0.85rem; color: #c9a227;">Best Racial Synergy: <strong>Draconic</strong> or <strong>Dwarf</strong>.</div>
        </div>

        <div style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #ea580c; border-radius: 8px; padding: 20px;">
          <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #ea580c;">2. Berserk (High-Risk High-Reward Damage)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 10px;">
            Converts low HP into immense physical carnage. <strong>Blood Rage</strong> increases ATK by 35% when below 40% HP, and <strong>Undying Will</strong> provides a safety net against accidental wipes.
          </p>
          <div style="font-size: 0.85rem; color: #c9a227;">Best Racial Synergy: <strong>Draconic</strong> (Dragon Scales defense cushion).</div>
        </div>

        <div style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #38bdf8; border-radius: 8px; padding: 20px;">
          <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #38bdf8;">3. Greatsword (AoE Multi-Mob Clearing)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 10px;">
            Specializes in crowd clearing with <strong>Sweeping Cleave</strong> (130% AoE ATK). Grants immunity to knockbacks, allowing you to sustain heavy weapon swings without turn delay.
          </p>
          <div style="font-size: 0.85rem; color: #c9a227;">Best Racial Synergy: <strong>Dwarf</strong> (+8% Poise stability).</div>
        </div>
      </div>

      <!-- Evidence Dossier -->
      <section style="background: #1d152c; border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin-bottom: 32px;">
        <h3 style="margin: 0 0 10px; font-size: 1.1rem; color: #c9a227; text-transform: uppercase;">Evidence Dossier: Warrior Growth Formula</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0 0 8px;">
          Growth per level formula: <code>HP +15.5 | ATK +2.1 | DEF +1.9 | MAG +0.4 | SPD +0.9</code>.
        </p>
        <p style="color: var(--muted); font-size: 0.85rem; margin: 0;">
          Weapon affinity: Broadswords, Greatswords, Heavy Plate Mail, Tower Shields.
        </p>
      </section>

      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/classes/super-classes/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Compare with All 18 Super Classes →
        </a>
        <a href="/tier-list/class-tier-list/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Class Meta Tier List →
        </a>
      </div>
    </article>
  </div>
</BaseLayout>
