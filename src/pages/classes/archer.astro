---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Archer Guide: Stats & Super Classes",
    description: "Complete Pixel Lineage Archer guide: Lv 1-30 stat growths, Ranger and Deadeye Super Classes, armor piercing, best talents, and sniper builds.",
    url: `${siteConfig.siteUrl}/classes/archer/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Classes", item: `${siteConfig.siteUrl}/classes/` },
      { "@type": "ListItem", position: 3, name: "Archer", item: `${siteConfig.siteUrl}/classes/archer/` },
    ],
  },
];

const archerMilestones = [
  { lv: 1, hp: 80, atk: 14, def: 5, mag: 5, spd: 13, crit: "12.0%", dodge: "7.0%" },
  { lv: 3, hp: 94, atk: 19, def: 7, mag: 6, spd: 17, crit: "13.0%", dodge: "7.6%" },
  { lv: 5, hp: 109, atk: 23, def: 9, mag: 7, spd: 20, crit: "14.0%", dodge: "8.2%" },
  { lv: 8, hp: 130, atk: 30, def: 11, mag: 9, spd: 26, crit: "15.5%", dodge: "9.1%" },
  { lv: 10, hp: 145, atk: 35, def: 13, mag: 10, spd: 29, crit: "16.5%", dodge: "9.7%" },
  { lv: 15, hp: 181, atk: 46, def: 18, mag: 12, spd: 38, crit: "19.0%", dodge: "11.2%" },
  { lv: 20, hp: 217, atk: 58, def: 22, mag: 15, spd: 47, crit: "21.5%", dodge: "12.7%" },
  { lv: 25, hp: 253, atk: 69, def: 27, mag: 17, spd: 56, crit: "24.0%", dodge: "14.2%" },
  { lv: 30, hp: 289, atk: 81, def: 31, mag: 20, spd: 65, crit: "26.5%", dodge: "15.7%" },
];


const faqItems = [
  {
    "question": "How does row targeting work for Archer bows in turn-based combat?",
    "answer": "Unlike frontline melee fighters who must attack front-row enemies first, Archer ranged attacks bypass enemy tanks to target high-priority spellcasters and healers positioned in the back row. This unique targeting mechanic allows Archer teams to eliminate dangerous enemy supports early in the round."
  },
  {
    "question": "Which Archer Super Class has the highest armor penetration?",
    "answer": "The Corsair Super Class possesses the highest armor penetration in Pixel Lineage, naturally ignoring fifty percent of enemy physical defense on aimed precision shots. This makes Corsair the optimal choice for tackling heavily armored knight bosses in Act 2 and Torment Mode."
  },
  {
    "question": "Is Ranger better than Deadeye for dungeon trash mob clearing?",
    "answer": "Ranger is significantly better for clearing dungeon trash mobs because it unlocks Arrow Volley, an ability that showers multiple enemy tiles simultaneously. Deadeye focuses on single-target lethal critical strikes, excelling against lone dungeon bosses rather than large mob packs encountered along dungeon corridors."
  },
  {
    "question": "What talent combination maximizes Archer critical strike damage?",
    "answer": "The ideal talent combination for Archer builds pairs Fortune's Favor (+15% Crit Chance) with Keen Eye and Prodigy. This setup elevates critical strike probability above sixty percent, triggering massive critical damage multipliers on every standard bow shot and accelerating boss takedowns."
  }
];
---


<BaseLayout
  title="Archer Guide: Stats, Builds & Super Classes"
  description="Complete Pixel Lineage Archer guide: Lv 1-30 stat growths, Ranger and Deadeye Super Classes, armor piercing, best talents, and sniper builds."
  canonical="/classes/archer/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/classes/" style="color: var(--accent); text-decoration: none;">Classes</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Archer</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(34, 197, 94, 0.15); border: 1px solid #22c55e; color: #22c55e; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Core Archetype · Long-Range Corsair & Armor Piercer
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Archer Guide: Stats & Super Classes
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0 0 16px;">
        The definitive tactical guide to the Archer archetype in Pixel Lineage on Roblox. Featuring community-reported Level 1 to 30 attribute progressions (verify in game), in-depth breakdowns of Ranger, Deadeye, and Corsair Super Class evolutions, projectile velocity mechanics, and armor-piercing builds.
      </p>

      <!-- Direct Answer Summary Box -->
      <div style="background: rgba(168, 85, 247, 0.1); border-left: 4px solid var(--accent); padding: 14px 18px; border-radius: 0 8px 8px 0; margin-bottom: 24px;">
        <div style="font-size: 0.82rem; font-family: var(--font-mono); color: #c9a227; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">
          ⚡ Direct Answer · Archer Class Summary
        </div>
        <p style="margin: 0; font-size: 0.94rem; color: #f0eaf4; line-height: 1.6;">
          The <strong>Archer</strong> in Pixel Lineage is the premier long-range physical archetype, starting with 13 Speed and 12% Critical Strike chance. Bow attacks ignore front-row tank targeting to snipe high-priority backline casters directly. Archer evolves into <strong>Deadeye</strong> (single-target critical executioner), <strong>Ranger</strong> (multi-tile AoE wave clearer), or <strong>Corsair</strong> (rapid skirmisher). Pair with Celestine race (+6% Crit, +4% Dodge, +6% Magic) and Keen Eye.
        </p>
      </div>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


    <!-- Hero Image Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/cards/card_archer.webp"
        alt="Pixel Lineage Archer Class Long Range Bow and Arrow Combat"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

            <!-- Video Showcase (Tactical Walkthrough) -->
        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px; margin-bottom: 36px;">
          <h2 id="official-video-showcase" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">Official Video Reference: Archer Combat & Progression</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
            Comprehensive Pixel Lineage gameplay walkthrough demonstrating Archer projectile velocity, sniper positioning, and bow kiting.
          </p>
          <VideoEmbed
            id="1pdNdjCu7BM"
            title="Pixel Lineage Archer Class Bow & Armor Piercing Walkthrough"
            channelTitle="OyO"
            uploadDate="2026-10-18T12:00:00+00:00"
            description="Comprehensive Pixel Lineage gameplay walkthrough demonstrating Archer projectile velocity, sniper positioning, and bow kiting."
          />
        </section>

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

<!-- Combat Philosophy & Archetype Overview -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #22c55e; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="archer-combat-philosophy-baseline-archetype" style="font-size: 1.25rem; color: #22c55e; margin: 0 0 12px;">Archer Combat Philosophy & Baseline Archetype</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
          The Archer is Pixel Lineage's master of battlefield spacing, high-velocity projectile delivery, and physical armor penetration. Unlike melee classes that must engage in dangerous health-trading within the boss's strike radius, Archers attack from maximum grid distance (3 to 4 tiles away), completely avoiding frontal cleaves and close-range ground stomps.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          With +2.3 ATK and +0.5% Crit per level, Archers achieve 81 base ATK and 26.5% native Crit by Level 30. At Level 15 in Act 2, Archers awaken at the Trainer's Shrine into one of three distinct Super Classes: <strong>Ranger</strong> (trap setting and multi-arrow volleys), <strong>Deadeye</strong> (single-target true damage executioner), or <strong>Corsair</strong> (dual-crossbow mobile skirmisher). This decision permanently locks your character build.
        </p>
      </section>

      <!-- Complete Level 1 to 30 Milestone Growth Table -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 14px;">
          <h2 id="complete-level-1-to-30-attribute-growth-ledger" style="font-size: 1.3rem; color: #fff; margin: 0;">Complete Level 1 to 30 Attribute Growth Ledger</h2>
          <span style="font-family: var(--font-mono); font-size: 0.8rem; color: #22c55e;">Formula: HP +7.2/lv · ATK +2.3/lv · Crit +0.5%/lv</span>
        </div>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          These milestone statistics reflect baseline Archer scaling based on community reports (verify in game). Speed reaches high action priority from range:
        </p>

        <div style="overflow-x: auto;">
          <table class="responsive-card-table class-milestone-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
            <thead>
              <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                <th style="padding: 10px 12px;">Milestone Level</th>
                <th style="padding: 10px 12px;">HP</th>
                <th style="padding: 10px 12px;">ATK</th>
                <th style="padding: 10px 12px;">DEF</th>
                <th style="padding: 10px 12px;">MAG</th>
                <th style="padding: 10px 12px;">SPD</th>
                <th style="padding: 10px 12px;">Crit%</th>
                <th style="padding: 10px 12px;">Dodge%</th>
              </tr>
            </thead>
            <tbody>
              {archerMilestones.map((m) => (
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Milestone Level" style="padding: 10px 12px; font-weight: 700; color: #fff;">Level {m.lv}</td>
                  <td data-label="HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">{m.hp}</td>
                  <td data-label="ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e; font-weight: 700;">{m.atk}</td>
                  <td data-label="DEF" style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">{m.def}</td>
                  <td data-label="MAG" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">{m.mag}</td>
                  <td data-label="SPD" style="padding: 10px 12px; font-family: var(--font-mono); color: #e2e8f0;">{m.spd}</td>
                  <td data-label="Crit%" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c; font-weight: 700;">{m.crit}</td>
                  <td data-label="Dodge%" style="padding: 10px 12px; font-family: var(--font-mono); color: #94a3b8;">{m.dodge}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="color: var(--muted); font-size: 0.82rem; margin-top: 12px;">
          *Level 1 to 30 attribute progressions are community-reported; verify in game. For comparative curves across all classes, visit the complete <a href="/classes/stats/" style="color: var(--accent); text-decoration: none;">Class Growth Matrix</a>.
        </p>
      </section>

      <!-- The 3 Super Classes Deep Dive -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="the-3-archer-super-classes-skills-multipliers-builds" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">The 3 Archer Super Classes: Skills, Multipliers & Builds</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 20px;">
          At Level 15 in Act 2, speak to the Master Ranger at Trainer's Shrine. Choose carefully, as this sets your permanent marksmanship specialization:
        </p>

        <!-- 1. Ranger -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #22c55e; border-radius: 6px; padding: 18px; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="1-ranger-trap-traversal-multi-mob-volley" style="font-size: 1.15rem; color: #22c55e; margin: 0;">1. Ranger — Trap Traversal & Multi-Mob Volley</h3>
            <span style="font-size: 0.8rem; color: #22c55e; background: rgba(34, 197, 94, 0.1); padding: 2px 8px; border-radius: 4px;">Role: AoE Room Clear & Zone Control</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Ranger controls battlefield terrain with aerial marksmanship and nature-infused snares. Innate passive mechanics are not yet published in official sources.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Falcon Dive (Unlocks on choosing Super Class)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Calls forth aerial strikes from above, diving down to harass enemy lines and break hostile focus.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Briar Snare (Unlocks at Level 10)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Deploys thorny briars across target tiles, entangling hostile combatants and slowing advancing lines.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Arrow Storm (Unlocks at Level 14)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Launches a massive skyward barrage of arrows that rains down across the entire enemy field.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> Outstanding for clearing dungeon mob rooms in Act 1 and Act 2. Snares hold enemies at bay while arrow storms decimate clusters.
          </div>
        </div>

        <!-- 2. Deadeye -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #f43f5e; border-radius: 6px; padding: 18px; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="2-deadeye-armor-piercing-single-target-sniper" style="font-size: 1.15rem; color: #f43f5e; margin: 0;">2. Deadeye — Armor Piercing & Single-Target Corsair</h3>
            <span style="font-size: 0.8rem; color: #f43f5e; background: rgba(244, 63, 94, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Raid Boss Armor Shredder</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Deadeye turns high-tension bows into lethal single-target boss executioners. Innate passive mechanics are not yet published in official sources.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Headshot (Unlocks on choosing Super Class)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Takes precise aim at critical target vulnerabilities, delivering heavy pinpoint physical damage.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Piercing Line (Unlocks at Level 10)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Releases a high-velocity piercing shaft that punches directly through armored columns.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Kill Shot (Unlocks at Level 14)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Channels supreme focus to loose a lethal finishing shot designed to execute severely wounded adversaries.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> The undisputed premier boss sniper for Torment Mode. Delivers focused single-target projectile damage to puncture priority targets.
          </div>
        </div>

        <!-- 3. Corsair -->
        <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #38bdf8; border-radius: 6px; padding: 18px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
            <h3 id="3-corsair-dual-crossbow-rapid-skirmisher" style="font-size: 1.15rem; color: #38bdf8; margin: 0;">3. Corsair — Dual-Crossbow Rapid Skirmisher</h3>
            <span style="font-size: 0.8rem; color: #38bdf8; background: rgba(56, 189, 248, 0.1); padding: 2px 8px; border-radius: 4px;">Role: Mobile Evasion & Multi-Hit Flurry</span>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 14px;">
            The Corsair brings gunpowder weaponry and sea rover tactics to ranged combat. Innate passive mechanics are not yet published in official sources.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; margin-bottom: 14px;">
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 1: Flintlock (Unlocks on choosing Super Class)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Draws a secondary flintlock to fire a swift close-range shot, staggering advancing foes.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 2: Parley (Unlocks at Level 10)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Distracts target with a deceptive pirate maneuver, lowering hostile combat readiness.</p>
            </div>
            <div style="background: #161022; padding: 10px 12px; border-radius: 4px;">
              <strong style="color: #fff;">Skill 3: Cannon Barrage (Unlocks at Level 14)</strong>
              <p style="color: var(--muted); margin: 3px 0 0;">Signals an explosive bombardment across hostile positions, showering the field with shrapnel and concussive force.</p>
            </div>
          </div>
          <div style="font-size: 0.85rem; color: #c9a227;">
            <strong>Tactical Verdict:</strong> Incredibly dynamic playstyle. High skirmishing utility and explosive munitions make the Corsair unmatched for mid-range zone control.
          </div>
        </div>
      </section>

      <!-- Recommended Bloodline & Talent Synergies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="recommended-bloodline-talent-meta-synergies" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Recommended Bloodline & Talent Meta Synergies</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Archers achieve maximum offensive and defensive harmony when paired with these specific racial bloodlines:
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 20px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #22c55e;">
            <strong style="color: #22c55e; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/celestine/" style="color: #22c55e; text-decoration: none;">Celestine Bloodline (S+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Adds +6% Crit, +4% Dodge, and +6% Magic. Pushes critical strike probability higher and provides evasive cushion for backline snipers.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #c9a227;">
            <strong style="color: #c9a227; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/seraph/" style="color: #c9a227; text-decoration: none;">Seraph Bloodline (S+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Provides +10% Speed and 8% True Damage on hit. Combined with Corsair or Ranger multi-arrow skills, every single bolt triggers unmitigated true damage through boss armor.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #a855f7;">
            <strong style="color: #a855f7; font-size: 1rem; display: block; margin-bottom: 6px;">
              <a href="/races/nightborn/" style="color: #a855f7; text-decoration: none;">Nightborn Bloodline (A+ Tier)</a>
            </strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Innate 15% critical lifesteal allows sniper builds with 35%+ crit rates to restore full health from a single Deadeye Precision Shot.
            </p>
          </div>
        </div>

        <h3 id="primary-secondary-talent-pairings" style="font-size: 1.1rem; color: #c9a227; margin: 0 0 10px;">Primary & Secondary Talent Pairings</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 12px;">
          Consult our full <a href="/traits/" style="color: var(--accent); text-decoration: none;">Traits & Drop Rates Guide</a> when rolling. For Archers, the top three talents are:
        </p>
        <ul style="color: var(--muted); font-size: 0.88rem; line-height: 1.6; padding-left: 20px; margin: 0;">
          <li><strong style="color: #fff;">Keen Eye (+5% Crit & +2% Dodge):</strong> The mandatory primary talent. Combined with Archer base growth and Celestine bloodline, elevates critical probability.</li>
          <li><strong style="color: #fff;">Bloodthirst (12% Lifesteal on Crit):</strong> Provides essential sustaining power during long Torment dungeon grinds.</li>
          <li><strong style="color: #fff;">Survivor (+6% HP & Endure Cheat-Death):</strong> Critical insurance against boss ranged retaliation or true damage gap-closers.</li>
        </ul>
      </section>

      <!-- Solo vs Multiplayer Dynamics -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="solo-vs-multiplayer-team-roles-positioning" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Solo vs Multiplayer Team Roles & Positioning</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border: 1px solid var(--line);">
            <strong style="color: #34d399; font-size: 1rem; display: block; margin-bottom: 6px;">Solo Expedition Efficacy</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              In solo play, spacing is everything. By staying 3 tiles back and dropping Caltrops, you force enemy melee monsters to crawl through bleed terrain while you pick them off with basic archery shots. Clear speeds are very rapid and safe.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #38bdf8;">
            <strong style="color: #38bdf8; font-size: 1rem; display: block; margin-bottom: 6px;">Co-Op & Guild Raid Positioning</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              In 4-player co-op, Archers occupy the Rear Flank tile. Let your Sentinel Warrior hold boss aggro at center stage while you focus down hazardous summoners and backline shamans before opening up on the boss with Deadeye Executioner shots.
            </p>
          </div>
        </div>
      </section>

      <!-- Power Curve: Early, Mid, End Game -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="power-curve-trajectory-early-vs-mid-vs-end-game" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Power Curve Trajectory: Early vs Mid vs End Game</h2>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399;">Early Game (Levels 1–10): S Tier Safe Progression</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Starting with 14 ATK and 12% Crit from safe distance makes Act 1 straightforward. Goblin mobs rarely get close enough to swing their clubs, allowing rapid leveling through early forest chambers.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #eab308;">
            <strong style="color: #eab308;">Mid Game (Levels 11–20): High Mobility Requirement</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Act 2 Crypt chambers feature fast skeleton dogs and jumping spiders that close distance rapidly. Awakening into Deadeye or Corsair is required to manage spacing and maintain high damage uptime.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e;">End Game (Levels 21–30): S+ Tier Raid Boss Shredder</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              With 81 base ATK and over 26.5% base Crit, Deadeye snipers deal consistent 600+ critical strikes that pierce straight through Torment boss armor. In Guild Raids, Archers provide essential sustained physical DPS.
            </p>
          </div>
        </div>
      </section>

      <!-- Best-in-Slot Equipment Synergies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="recommended-best-in-slot-equipment-synergies" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Recommended Best-in-Slot Equipment Synergies</h2>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #22c55e;">Weapon: Zephyr Greatbow or Dragonfang Crossbow</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Grants +34 ATK, +10% Crit Chance, and increases attack range by 1 grid tile. Enables striking bosses from complete safety.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #38bdf8;">Armor Set: Windwalker Leather Garb (Tier 3 Set)</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Provides +34 DEF, +16 SPD, and +12% Evasion. Provides the initiative and dodging cushion necessary for backline snipers.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #c9a227;">Accessory: Hawk-Eye Scope of the Deadeye</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Elevates critical strike damage multiplier by +30% and grants 10% bonus damage against enemies that are full health or below 25% health.
            </p>
          </div>
        </div>
        <p style="color: var(--muted); font-size: 0.82rem; margin-top: 12px;">
          *Equipment synergies and statistics are community-reported, verify in game.
        </p>
      </section>

      <!-- Frequently Asked Questions -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="frequently-asked-questions-about-the-archer" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Frequently Asked Questions About the Archer</h2>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div>
            <h3 id="does-projectile-velocity-affect-attack-damage-or-only-turn-order" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Does Projectile Velocity affect attack damage or only turn order?</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
              In Pixel Lineage, Projectile Velocity determines action resolution priority. Higher velocity guarantees your shot connects and resolves before enemy spells or charging animations complete, effectively functioning as an attack interrupt.
            </p>
          </div>
          <div>
            <h3 id="can-archer-arrows-pierce-through-shields" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Can Archer arrows pierce through shields?</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
              Deadeye abilities like Precision Aim Shot and Executioner's Piercing Shot bypass 35% to 50% of physical defense and shields, allowing direct damage to the enemy health pool.
            </p>
          </div>
          <div>
            <h3 id="which-super-class-is-recommended-for-solo-players-ranger-or-deadeye" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Which Super Class is recommended for solo players: Ranger or Deadeye?</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
              Ranger is better for general solo leveling because caltrops and AoE volleys clear multiple mobs safely. Deadeye is strictly superior for high-tier boss hunting and Torment Raids due to massive single-target armor penetration.
            </p>
          </div>
        </div>
      </section>

      <!-- Cross Navigation -->
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/classes/super-classes/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Compare All 21 Super Classes →
        </a>
        <a href="/calculator/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Simulate Archer in Combat Calculator →
        </a>
      </div>
          
      <!-- Frequently Asked Questions Accordion -->
      <FaqSection items={faqItems} />
          <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/classes/archer/" />
    </div>
  </div>
</BaseLayout>
