---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Thief Class Guide: Evolutions",
    description: "Complete Pixel Lineage Thief class guide: Lv 1-30 stat growths, speed scaling, Assassin, Rogue, and Corsair Super Class builds on Roblox.",
    url: `${siteConfig.siteUrl}/classes/thief/`,
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Classes", item: `${siteConfig.siteUrl}/classes/` },
      { "@type": "ListItem", position: 3, name: "Thief", item: `${siteConfig.siteUrl}/classes/thief/` },
    ],
  },
];
---

<BaseLayout
  title="Pixel Lineage Thief Class Guide: Evolutions"
  description="Complete Pixel Lineage Thief class guide: Lv 1-30 stat growths, speed scaling, Assassin, Rogue, and Corsair Super Class builds on Roblox."
  canonical="/classes/thief/"
  jsonLd={jsonLd}
>
  <div class="container" style="max-width: 860px; margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/classes/" style="color: var(--accent); text-decoration: none;">Classes</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Thief</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(52, 211, 153, 0.15); border: 1px solid #34d399; color: #34d399; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Archetype Overview · Agility & Critical
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Thief Class Guide
      </h1>
      <p style="color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0;">
        The master of turn priority and burst execution. With 16 base Speed and 15% base Critical strike chance, the Thief consistently strikes first to eliminate key targets.
      </p>
    </header>

    <article style="line-height: 1.7; color: var(--ink);">
      <!-- Attribute Progression Matrix -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; margin-bottom: 36px;">
        <div style="background: #1d152c; padding: 14px 20px; border-bottom: 1px solid var(--line);">
          <h2 style="font-size: 1.25rem; color: var(--ink); margin: 0;">Thief Stat Growth Milestones</h2>
        </div>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead>
              <tr style="border-bottom: 1px solid var(--line); background: #13101c;">
                <th style="padding: 10px 14px; color: var(--muted);">Level</th>
                <th style="padding: 10px 14px; color: var(--muted);">HP</th>
                <th style="padding: 10px 14px; color: var(--muted);">Attack</th>
                <th style="padding: 10px 14px; color: var(--muted);">Defense</th>
                <th style="padding: 10px 14px; color: var(--muted);">Speed</th>
                <th style="padding: 10px 14px; color: var(--muted);">Crit / Dodge</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: 700; color: #34d399;">Lv 1 (Starter)</td>
                <td style="padding: 10px 14px;">85</td>
                <td style="padding: 10px 14px;">12</td>
                <td style="padding: 10px 14px;">6</td>
                <td style="padding: 10px 14px;">16</td>
                <td style="padding: 10px 14px;">15% / 12%</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: 700;">Lv 10 (Act 1 Clear)</td>
                <td style="padding: 10px 14px;">190</td>
                <td style="padding: 10px 14px;">28</td>
                <td style="padding: 10px 14px;">14</td>
                <td style="padding: 10px 14px;">34</td>
                <td style="padding: 10px 14px;">20% / 16%</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 14px; font-weight: 700; color: #c9a227;">Lv 20 (Super Class)</td>
                <td style="padding: 10px 14px;">340</td>
                <td style="padding: 10px 14px;">56</td>
                <td style="padding: 10px 14px;">26</td>
                <td style="padding: 10px 14px;">62</td>
                <td style="padding: 10px 14px;">28% / 22%</td>
              </tr>
              <tr>
                <td style="padding: 10px 14px; font-weight: 700; color: #f43f5e;">Lv 30 (Endgame)</td>
                <td style="padding: 10px 14px;">540</td>
                <td style="padding: 10px 14px;">92</td>
                <td style="padding: 10px 14px;">42</td>
                <td style="padding: 10px 14px;">98</td>
                <td style="padding: 10px 14px;">38% / 30%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 3 Super Class Paths -->
      <h2 style="font-size: 1.4rem; color: var(--ink); margin: 32px 0 16px;">Thief Super Class Branching Paths</h2>

      <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 36px;">
        <div style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #a855f7; border-radius: 8px; padding: 20px;">
          <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #a855f7;">1. Assassin (A-Tier Meta Burst)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 10px;">
            The premier executioner. <strong>Shadow Step</strong> grants 1 turn of complete stealth and forces a guaranteed 100% critical on your next skill. <strong>Throat Slit</strong> deals +50% bonus damage on wounded targets.
          </p>
          <div style="font-size: 0.85rem; color: #c9a227;">Best Racial Synergy: <strong>Nightborn</strong> (Shadow Affinity +15% Dungeon damage).</div>
        </div>

        <div style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #34d399; border-radius: 8px; padding: 20px;">
          <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #34d399;">2. Rogue (Poison & Evasion Attrition)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 10px;">
            Focuses on sustained combat through <strong>Venomous Blade</strong> (DoT poison) and <strong>Pocket Sand</strong> (40% accuracy debuff on enemies). Higher survivability than Assassin in drawn-out battles.
          </p>
          <div style="font-size: 0.85rem; color: #c9a227;">Best Racial Synergy: <strong>Beastkin</strong> (+8% Dodge chance).</div>
        </div>

        <div style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #eab308; border-radius: 8px; padding: 20px;">
          <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #eab308;">3. Corsair (Gold Farming & Ranged Utility)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 10px;">
            Generates 15-30% extra Gold from defeated enemies with <strong>Plunder</strong> and wields an unblockable <strong>Flintlock Quickdraw</strong>. Great for financing equipment upgrades at Blacksmith.
          </p>
          <div style="font-size: 0.85rem; color: #c9a227;">Best Racial Synergy: <strong>Human</strong> (+5% Gold bonus).</div>
        </div>
      </div>

      <!-- Evidence Dossier -->
      <section style="background: #1d152c; border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin-bottom: 32px;">
        <h3 style="margin: 0 0 10px; font-size: 1.1rem; color: #c9a227; text-transform: uppercase;">Evidence Dossier: Thief Growth Formula</h3>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0 0 8px;">
          Growth per level formula: <code>HP +11.2 | ATK +1.9 | DEF +0.8 | MAG +0.5 | SPD +2.1</code>.
        </p>
        <p style="color: var(--muted); font-size: 0.85rem; margin: 0;">
          Weapon affinity: Daggers, Dual Blades, Light Leather Tunics, Flintlocks.
        </p>
      </section>

      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/classes/super-classes/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Compare 18 Super Classes Matrix →
        </a>
        <a href="/tier-list/talent-tier-list/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
          Best Talents for Thief Builds →
        </a>
      </div>
    </article>
  </div>
</BaseLayout>
