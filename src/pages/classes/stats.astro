const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Class Stat Growths: Lv 1-30 Tables",
    description: "Master Pixel Lineage stat progression: complete attribute tables across 10 level milestones, growth curves, soft caps, and build optimizations for all 6 classes.",
    url: `${siteConfig.siteUrl}/classes/stats/`,
    datePublished: "2026-10-18T12:00:00Z",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Classes", item: `${siteConfig.siteUrl}/classes/` },
      { "@type": "ListItem", position: 3, name: "Stat Growths", item: `${siteConfig.siteUrl}/classes/stats/` },
