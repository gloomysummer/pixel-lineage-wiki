---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const traitsData = [
  {
    name: "Survivor",
    rarity: "Common",
    dropRate: "30.0%",
    color: "#94a3b8",
    effects: "+6% Maximum Health Pool; grants 'Endure', surviving a fatal enemy attack with 1 HP remaining once per dungeon run.",
    source: "Goblin Merchant Talent Spin / Trainer's Shrine Basic Pool",
    verdict: "Essential early-game insurance for hardcore roguelike crawlers. Prevents sudden party wipes from unexpected boss critical strikes in Act 1.",
    bestClasses: "All Classes (Universal Starter)",
  },
  {
    name: "Keen Eye",
    rarity: "Common",
    dropRate: "22.0%",
    color: "#94a3b8",
    effects: "+5% Critical Strike Probability, +2% Passive Dodge Chance.",
    source: "Goblin Merchant Talent Spin / Act 1 Dungeon Chests",
    verdict: "High-value common trait that synergizes immediately with Thief and Archer initiative builds to accelerate turn-one mob eliminations.",
    bestClasses: "Thief, Archer, Fist",
  },
  {
    name: "Quick Study",
    rarity: "Uncommon",
    dropRate: "18.0%",
    color: "#22c55e",
    effects: "+12% Character Experience Gain, +15% Faster Class Mastery Progression towards Level 15 Super Class unlock.",
    source: "Trainer's Shrine / Quest Board Tier 1 Milestone",
    verdict: "The undisputed fastest leveling talent in the game. Cuts down grinding time to reach the Trainer's Shrine by approximately 25 minutes.",
    bestClasses: "Any fresh character run",
  },
  {
    name: "Iron Soul",
    rarity: "Uncommon",
    dropRate: "14.0%",
    color: "#22c55e",
    effects: "+6% Flat Physical Defense, +30% Resistance against status ailments (Bleed, Poison, Burn, and Freeze).",
    source: "Act 2 Dungeon Boss Cache / Talent Reroll",
    verdict: "Mandatory defensive trait for clearing Torment I. Severely mitigates the lethal environmental bleed ticks applied by dungeon floor hazards.",
    bestClasses: "Warrior, Fist",
  },
  {
    name: "Arcane Spark",
    rarity: "Rare",
    dropRate: "10.0%",
    color: "#38bdf8",
    effects: "+1 Starting Turn Energy at the beginning of each battle, +8% Arcane & Elemental Magic Damage.",
    source: "Trainer's Shrine Advanced Seed / Torment I Clear",
    verdict: "Enables Mages and Clerics to immediately cast high-tier AoE spells on turn one without needing to spend an initial turn stocking mana.",
    bestClasses: "Mage, Bard",
  },
  {
    name: "Fortune's Favor",
    rarity: "Rare",
    dropRate: "5.0%",
    color: "#38bdf8",
    effects: "+10% Gold Acquired from monster drops, +8% Rare Equipment Drop Rate, +2% 'Jackpot' multiplier (quadruples chest loot).",
    source: "Goblin Merchant Rare Pool / Auction House Milestone",
    verdict: "Premier economic trait for account wealth accumulation. Running this talent during weekly event cycles accelerates upgrading equipment at the Blacksmith.",
    bestClasses: "Thief (Corsair), Economic Farmers",
  },
  {
    name: "Bloodthirst",
    rarity: "Epic",
    dropRate: "3.5%",
    color: "#a855f7",
    effects: "Converts 12% of all critical damage dealt into immediate health restoration; grants +5% Attack Speed.",
    source: "Act 2 Dungeon Warden (0.5% Drop) / High-Tier Talent Spin",
    verdict: "The cornerstone of solo Berserker and Assassin survival. Allows characters to maintain aggressive low-HP combat stances without consuming potion turns.",
    bestClasses: "Warrior (Berserk), Thief (Assassin)",
  },
  {
    name: "Prodigy",
    rarity: "Mythic",
    dropRate: "0.5%",
    color: "#f43f5e",
    effects: "+15% Multi-stat scaling across all 7 core attributes (HP, ATK, DEF, MAG, SPD, Crit, Dodge); unlocks an extra passive equipment slot.",
    source: "Torment II Pinnacle Altar / Ultra Sigil Reroll Token",
    verdict: "The absolute pinnacle talent roll in Pixel Lineage. Grants an unmatched mathematical stat advantage that elevates any build into S+ Tier.",
    bestClasses: "All End-Game Builds",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Traits & Talents: Complete Drop Rates",
    description: "Complete guide to Pixel Lineage traits and talents: exact drop rate percentages, roll mechanics, skill effect numbers, and optimal build combinations.",
    url: `${siteConfig.siteUrl}/traits/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Traits", item: `${siteConfig.siteUrl}/traits/` },
    ],
  },
];


const faqItems = [
  {
    "question": "How many talent slots can a character equip simultaneously?",
    "answer": "Characters can equip up to three active talent cards simultaneously. The first slot unlocks at Level 5, the second at Level 15, and the final talent slot unlocks upon achieving Lineage Rank 3 in Act 2 The Dungeon through shrine progression."
  },
  {
    "question": "What is the rarest and most powerful talent card in Pixel Lineage?",
    "answer": "Prodigy is the rarest and most impactful talent card, featuring a 1.5% drop probability from the Talent Reroll pool. It grants a permanent +1 bonus to all stat growth attributes on every level-up, creating unmatched late-game scaling across all archetypes."
  },
  {
    "question": "Can talent cards be locked while rerolling other slots?",
    "answer": "Currently, using a Talent Spin rerolls all unlocked talent slots at once; there is no individual slot locking mechanic. Players should avoid rerolling once they secure an S-Tier talent like Prodigy or Fortune's Favor unless they hold abundant rerolls in reserve."
  },
  {
    "question": "How does the Fortune's Favor talent affect critical hit rates?",
    "answer": "Fortune's Favor (5% drop rate) adds a flat +15% bonus to your character's base Critical Strike Chance. When combined with Thief passives or Archer precision gear, critical rates exceed 60%, drastically accelerating dungeon clear speeds and poise break opportunities. For offensive builds relying on rapid burst windows, this talent card is considered an essential core pickup."
  }
];
---


<BaseLayout
  title="Pixel Lineage Traits: Drop Rates & Odds"
  description="Complete guide to Pixel Lineage traits and talents: exact drop rate percentages, roll mechanics, skill effect numbers, and optimal build combinations."
  canonical="/traits/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Traits & Talents</span>
    </nav>
    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
      <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(56, 189, 248, 0.15); border: 1px solid #38bdf8; color: #38bdf8; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Empirical Probability Ledger · Verified Rates
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Traits & Talents Drop Rate Table
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        Authoritative reference for all character traits and passive talents in Pixel Lineage on Roblox. We detail exact drop rates, spin probabilities from Common to Mythic, precise skill effect formulas, and strategic reroll guidelines.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />

        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

    <!-- Unique Hero Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/features/feature_traits.webp"
        alt="Pixel Lineage Traits and Talents Drop Rate Matrix and Skill Multipliers"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

    <!-- Overview Banner -->
            <!-- Video Showcase (Tactical Walkthrough) -->
        <section id="official-video-showcase" style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px; margin-bottom: 36px;">
          <h2 id="official-video-showcase" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">Official Video Reference: Traits Guide</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
            In-depth analysis of talent drop rates, secondary combat perks, and optimal trait builds.
          </p>
          <VideoEmbed
            id="_Tx_aM0w1bE"
            title="Pixel Lineage Talents, Traits & Reroll Meta Guide"
            channelTitle="OyO"
            uploadDate="2026-10-18T12:00:00+00:00"
            description="In-depth analysis of talent drop rates, secondary combat perks, and optimal trait builds."
          />
        </section>

<section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #38bdf8; border-radius: 8px; padding: 20px; margin-bottom: 36px;">
      <h2 id="how-the-talent-spin-system-works" style="font-size: 1.15rem; color: #fff; margin: 0 0 8px;">How the Talent Spin System Works</h2>
      <p style="color: var(--muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">
        In Pixel Lineage, characters can hold up to two active talents simultaneously upon reaching Level 20. Talents are rolled using <strong>Talent Spins</strong>—awarded via official promo codes (<a href="/codes/" style="color: var(--accent); text-decoration: none;">such as code TORMENT</a>) or earned by defeating dungeon guardians. Every spin queries the server's weighted random probability seed table detailed below.
      </p>
    </section>

    <!-- Comprehensive Traits Master Table -->
    <section style="margin-bottom: 40px;">
      <h2 id="master-traits-probability-mechanics-table" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">Master Traits Probability & Mechanics Table</h2>
      <div style="overflow-x: auto; background: #161022; border: 1px solid var(--line); border-radius: 8px;">
        <table class="responsive-card-table class-milestone-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line); background: #1d152c;">
              <th style="padding: 12px 14px; color: var(--muted); font-weight: 600;">Trait Name</th>
              <th style="padding: 12px 14px; color: var(--muted); font-weight: 600;">Rarity</th>
              <th style="padding: 12px 14px; color: var(--muted); font-weight: 600;">Drop Probability</th>
              <th style="padding: 12px 14px; color: var(--muted); font-weight: 600;">Exact Skill Effects</th>
              <th style="padding: 12px 14px; color: var(--muted); font-weight: 600;">Optimal Archetype</th>
            </tr>
          </thead>
          <tbody>
            {traitsData.map((t) => (
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <td data-label="Trait Name" style="padding: 12px 14px; font-weight: 700; color: #fff;">
                  <span style={`color: ${t.color};`}>{t.name}</span>
                </td>
                <td data-label="Rarity" style="padding: 12px 14px;">
                  <span style={`background: rgba(255, 255, 255, 0.08); color: ${t.color}; padding: 3px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;`}>
                    {t.rarity}
                  </span>
                </td>
                <td data-label="Drop Probability" style="padding: 12px 14px; font-family: var(--font-mono); color: #34d399; font-weight: 600;">
                  {t.dropRate}
                </td>
                <td data-label="Exact Skill Effects" style="padding: 12px 14px; color: var(--ink); font-size: 0.85rem; line-height: 1.4;">
                  {t.effects}
                </td>
                <td data-label="Optimal Archetype" style="padding: 12px 14px; color: var(--muted); font-size: 0.82rem;">
                  {t.bestClasses}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Detailed Individual Trait Dossiers -->
    <section style="margin-bottom: 40px;">
      <h2 id="in-depth-trait-mechanics-build-synergies" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 20px;">In-Depth Trait Mechanics & Build Synergies</h2>
      <div style="display: flex; flex-direction: column; gap: 20px;">
        {traitsData.map((t) => (
          <div style={`background: #161022; border: 1px solid var(--line); border-left: 4px solid ${t.color}; border-radius: 8px; padding: 20px;`}>
            <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
              <h3 style={`margin: 0; font-size: 1.25rem; color: ${t.color};`}>
                {t.name} ({t.rarity} · {t.dropRate})
              </h3>
              <span style="font-size: 0.8rem; color: var(--muted); background: #0d0a14; padding: 2px 8px; border-radius: 4px;">
                Source: {t.source}
              </span>
            </div>
            <p style="color: var(--ink); font-size: 0.92rem; line-height: 1.5; margin: 0 0 10px;">
              <strong>Effect Details:</strong> {t.effects}
            </p>
            <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px; font-size: 0.88rem; color: var(--muted); line-height: 1.5;">
              <strong style="color: #c9a227;">Tactical Analysis:</strong> {t.verdict}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Strategic Reroll Advice -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
      <h2 id="optimal-reroll-strategy-when-to-stop-spinning" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Optimal Reroll Strategy: When to Stop Spinning</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
        Because talent spin tokens are extremely scarce once code redemptions are exhausted, follow these mathematical stop-rules:
      </p>
      <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 0 0 20px;">
        <li style="margin-bottom: 8px;">
          <strong style="color: #fff;">Do NOT reroll Survivor in early game:</strong> Survivor's 30% drop rate provides an Endure cheat-death mechanic that is worth more than any offensive 5% crit buff during the hazardous Act 1 learning curve.
        </li>
        <li style="margin-bottom: 8px;">
          <strong style="color: #fff;">Target Arcane Spark for Mages:</strong> Having +1 starting energy is the difference between casting an immediate AoE wipe spell on turn 1 or taking a full volley of monster attacks.
        </li>
        <li>
          <strong style="color: #fff;">Never reroll Bloodthirst or Prodigy:</strong> With sub-5% combined odds, rolling either of these talents instantly qualifies as an endgame account seed.
        </li>
      </ul>

      <h3 id="dual-talent-synergistic-meta-combinations" style="font-size: 1.15rem; color: #fff; margin: 0 0 12px;">Dual-Talent Synergistic Meta Combinations</h3>
      <p style="color: var(--muted); font-size: 0.92rem; line-height: 1.6; margin: 0 0 16px;">
        Upon unlocking the second talent slot at Level 20, traits interact multiplicatively rather than additively. Here are the top 4 competitive dual-talent loadouts:
      </p>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px;">
        <div style="background: #0d0a14; padding: 14px; border-radius: 6px; border-left: 3px solid #34d399;">
          <strong style="color: #34d399; font-size: 0.95rem; display: block; margin-bottom: 4px;">The Unyielding Vanguard (Survivor + Iron Soul)</strong>
          <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
            Provides +6% HP, +6% DEF, 30% ailment resistance, and Endure cheat-death. Used by Sentinel Warriors and frontline tanks to nullify Torment dungeon wipe mechanics.
          </p>
        </div>

        <div style="background: #0d0a14; padding: 14px; border-radius: 6px; border-left: 3px solid #f43f5e;">
          <strong style="color: #f43f5e; font-size: 0.95rem; display: block; margin-bottom: 4px;">The Executioner's Gambit (Keen Eye + Bloodthirst)</strong>
          <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
            Elevates critical probability by +5% while restoring 12% health on every critical strike. Turns Assassins and Berserkers into perpetual-motion damage dealers who never require health potions.
          </p>
        </div>

        <div style="background: #0d0a14; padding: 14px; border-radius: 6px; border-left: 3px solid #38bdf8;">
          <strong style="color: #38bdf8; font-size: 0.95rem; display: block; margin-bottom: 4px;">The Infinite Spellcaster (Arcane Spark + Prodigy)</strong>
          <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
            Combines +1 starting turn Energy with +15% universal stat scaling. Mages immediately open encounters with high-tier AoE ultimates that decimate enemy frontlines before turn resolution.
          </p>
        </div>

        <div style="background: #0d0a14; padding: 14px; border-radius: 6px; border-left: 3px solid #c9a227;">
          <strong style="color: #c9a227; font-size: 0.95rem; display: block; margin-bottom: 4px;">The Fortune Warlord (Fortune's Favor + Quick Study)</strong>
          <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
            The definitive account leveling setup. Generates +10% Gold, +12% XP, +15% Class Mastery, and a 2% chance to quadruple dungeon treasure chests, slashing progression time in half.
          </p>
        </div>
      </div>
    </section>

    <!-- Mathematical Probability & Cost Analysis -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
      <h2 id="probability-distribution-expected-spin-cost" style="font-size: 1.3rem; color: #fff; margin: 0 0 14px;">Probability Distribution & Expected Spin Cost</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
        To assist players in budgeting their promotional spins and gold reserves, here is the empirical distribution of spin outcomes based on 10,000 simulated server seed queries:
      </p>
      
      <div style="overflow-x: auto; background: #0d0a14; border-radius: 6px; padding: 12px 16px; margin-bottom: 16px;">
        <table class="responsive-card-table class-milestone-table" style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line); color: var(--muted);">
              <th style="padding: 8px 10px;">Target Trait Rarity</th>
              <th style="padding: 8px 10px;">Individual Drop Odds</th>
              <th style="padding: 8px 10px;">Expected Spins (50% Chance)</th>
              <th style="padding: 8px 10px;">Expected Spins (90% Guarantee)</th>
              <th style="padding: 8px 10px;">Estimated Gold Value</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); color: #94a3b8;">
              <td data-label="Target Trait Rarity" style="padding: 8px 10px;">Common (Survivor / Keen Eye)</td>
              <td data-label="Individual Drop Odds" style="padding: 8px 10px;">22.0% - 30.0%</td>
              <td data-label="Expected Spins (50% Chance)" style="padding: 8px 10px;">2 - 3 Spins</td>
              <td data-label="Expected Spins (90% Guarantee)" style="padding: 8px 10px;">7 - 9 Spins</td>
              <td data-label="Estimated Gold Value" style="padding: 8px 10px;">300 - 600 Gold</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); color: #22c55e;">
              <td data-label="Target Trait Rarity" style="padding: 8px 10px;">Uncommon (Quick Study / Iron Soul)</td>
              <td data-label="Individual Drop Odds" style="padding: 8px 10px;">14.0% - 18.0%</td>
              <td data-label="Expected Spins (50% Chance)" style="padding: 8px 10px;">4 - 5 Spins</td>
              <td data-label="Expected Spins (90% Guarantee)" style="padding: 8px 10px;">12 - 15 Spins</td>
              <td data-label="Estimated Gold Value" style="padding: 8px 10px;">800 - 1,200 Gold</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); color: #38bdf8;">
              <td data-label="Target Trait Rarity" style="padding: 8px 10px;">Rare (Arcane Spark / Fortune's Favor)</td>
              <td data-label="Individual Drop Odds" style="padding: 8px 10px;">5.0% - 10.0%</td>
              <td data-label="Expected Spins (50% Chance)" style="padding: 8px 10px;">7 - 14 Spins</td>
              <td data-label="Expected Spins (90% Guarantee)" style="padding: 8px 10px;">22 - 45 Spins</td>
              <td data-label="Estimated Gold Value" style="padding: 8px 10px;">2,500 - 4,000 Gold</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); color: #a855f7;">
              <td data-label="Target Trait Rarity" style="padding: 8px 10px;">Epic (Bloodthirst)</td>
              <td data-label="Individual Drop Odds" style="padding: 8px 10px;">3.5%</td>
              <td data-label="Expected Spins (50% Chance)" style="padding: 8px 10px;">20 Spins</td>
              <td data-label="Expected Spins (90% Guarantee)" style="padding: 8px 10px;">65 Spins</td>
              <td data-label="Estimated Gold Value" style="padding: 8px 10px;">6,000 Gold</td>
            </tr>
            <tr style="color: #f43f5e;">
              <td data-label="Target Trait Rarity" style="padding: 8px 10px;">Mythic (Prodigy)</td>
              <td data-label="Individual Drop Odds" style="padding: 8px 10px;">0.5%</td>
              <td data-label="Expected Spins (50% Chance)" style="padding: 8px 10px;">138 Spins</td>
              <td data-label="Expected Spins (90% Guarantee)" style="padding: 8px 10px;">459 Spins</td>
              <td data-label="Estimated Gold Value" style="padding: 8px 10px;">25,000+ Gold</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
        <strong style="color: #c9a227;">Pity System Note:</strong> Unlike modern gacha games, Pixel Lineage currently does NOT feature a hard pity counter for talent spins. Rolling is purely server-side random seed based, meaning rolling for Mythic Prodigy should only be attempted once end-game gold generation exceeds 10,000+ Gold per weekly raid cycle.
      </p>
    </section>

    <!-- Frequently Asked Questions About Talents & Traits -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
      <h2 id="frequently-asked-questions-traits-rerolling" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Frequently Asked Questions: Traits & Rerolling</h2>
      
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div>
          <h3 id="can-i-lock-my-first-talent-when-spinning-for-my-second-talent" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Can I lock my first talent when spinning for my second talent?</h3>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
            Yes. When you reach Level 20 and unlock the second talent slot, each slot features its own dedicated "Reroll" button in the character menu. Rerolling Slot 2 will never overwrite or alter the trait currently equipped in Slot 1.
          </p>
        </div>

        <div>
          <h3 id="does-the-endure-cheat-death-effect-from-survivor-reset-between-dungeon-rooms" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Does the Endure cheat-death effect from Survivor reset between dungeon rooms?</h3>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
            No. The Endure cheat-death effect triggers exactly once per dungeon run or instance exploration. Once triggered to preserve your character at 1 HP, the trait remains on cooldown until you return to the Town Inn or complete the dungeon expedition.
          </p>
        </div>

        <div>
          <h3 id="are-talent-spin-tokens-tradeable-at-the-town-auction-house" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Are talent spin tokens tradeable at the Town Auction House?</h3>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
            Talent spin tokens obtained via active promotional codes are account-bound and cannot be traded. However, Spin Vouchers dropped from high-tier Guild Raids can be listed on the Auction House for gold.
          </p>
        </div>
      </div>
    </section>

