---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Seraph Race in Pixel Lineage: Stats & Build Meta",
    description: "Complete Pixel Lineage Seraph race guide: archangel wing evasion, true holy damage scaling, aerial speed priority, and Monk/Archer build synergies.",
    url: `${siteConfig.siteUrl}/races/seraph/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Races", item: `${siteConfig.siteUrl}/races/` },
      { "@type": "ListItem", position: 3, name: "Seraph", item: `${siteConfig.siteUrl}/races/seraph/` },
    ],
  },
];


const faqItems = [
  {
    "question": "What are the unique racial traits of the Seraph lineage?",
    "answer": "Seraph is a Mythic bloodline (1.5% spin probability) featuring angelic wings and holy radiance. It grants +15% Holy spell damage, a party-wide aura that boosts incoming healing by 10%, and a resurrection blessing that revives one fallen ally per raid."
  },
  {
    "question": "How does the Seraph Angelic Revival ability work in Guild Raids?",
    "answer": "If an allied teammate dies during a raid encounter, Seraph can channel a revival prayer that restores the fallen player with thirty percent health. This revive bypasses standard permadeath penalties during that specific raid encounter, preventing devastating party wipes against Torment bosses."
  },
  {
    "question": "Is Seraph restricted to healer classes or can damage dealers use it?",
    "answer": "While Seraph is the definitive choice for Clerics and support Bards, its +15% Holy amplification also empowers holy-element Greatsword Warrior and paladin-style hybrid builds, combining heavy frontline survivability with self-healing aura support to sustain solo expeditions. This provides exceptional versatility for both solo players and organized guild groups."
  },
  {
    "question": "How many race spins on average does it take to roll Seraph?",
    "answer": "Due to its 1.5% drop rate, rolling Seraph requires an average of sixty to seventy Race Spins. Players should stockpile spins from multiple active code releases and seasonal events before attempting to roll for this top-tier Mythic lineage at the merchant."
  }
];
---


<BaseLayout
  title="Seraph Race in Pixel Lineage: Stats & Build Meta"
  description="Complete Pixel Lineage Seraph race guide: archangel wing evasion, true holy damage scaling, aerial speed priority, and Monk/Archer build synergies."
  canonical="/races/seraph/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/races/" style="color: var(--accent); text-decoration: none;">Races</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Seraph</span>
    </nav>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(201, 162, 39, 0.15); border: 1px solid #c9a227; color: #c9a227; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Mythic Archangel Lineage · 1.0% Spin Probability
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Seraph Race: Stats & Build Meta
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        In-depth guide to the Seraph bloodline in Pixel Lineage on Roblox. We analyze ethereal wing evasion mechanics, true Holy damage conversion, aerial turn speed advantages, and top competitive builds for Torment II and PvP Arena.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />

    <!-- Unique Hero Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/features/feature_seraph.webp"
        alt="Pixel Lineage Seraph Race Archangel Wings and True Holy Damage Passives"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

            <!-- Video Showcase (Tactical Walkthrough) -->
        <section id="official-video-showcase" style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px; margin-bottom: 36px;">
          <h2 id="official-video-showcase" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">Official Video Reference: Seraph Bloodline & Mechanics</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
            Comprehensive Pixel Lineage gameplay walkthrough analyzing Seraph holy damage buffs, angel wings mobility, and cleric support meta.
          </p>
          <VideoEmbed
            id="1pdNdjCu7BM"
            title="Pixel Lineage Seraph Lineage & Holy Ascension Breakdown"
            channelTitle="OyO"
            uploadDate="2026-10-18T12:00:00+00:00"
            description="Comprehensive Pixel Lineage gameplay walkthrough analyzing Seraph holy damage buffs, angel wings mobility, and cleric support meta."
          />
        </section>

<!-- Core Attributes Box -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #c9a227; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="seraph-innate-racial-trait-ledger" style="font-size: 1.25rem; color: #c9a227; margin: 0 0 12px;">Seraph Innate Racial Trait Ledger</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; font-size: 0.9rem;">
          <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px;">
            <span style="color: var(--muted); font-size: 0.75rem; display: block;">Archangel Flight</span>
            <strong style="color: #38bdf8; font-size: 1.1rem;">+14% Turn Speed & Evasion</strong>
          </div>
          <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px;">
            <span style="color: var(--muted); font-size: 0.75rem; display: block;">Judgment Brand</span>
            <strong style="color: #f43f5e; font-size: 1.1rem;">10% Attacks Convert to True Holy DMG</strong>
          </div>
          <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px;">
            <span style="color: var(--muted); font-size: 0.75rem; display: block;">Heavenly Grace <em style="font-size: 0.75rem; color: #c9a227;">(Community-reported)</em></span>
            <strong style="color: #34d399; font-size: 1.1rem;">Immunity to Ground Trap Hazards</strong>
          </div>
        </div>
      </section>

      <!-- Tactical Deep Dive -->
      <section style="margin-bottom: 36px;">
        <h2 id="the-apex-combat-hybrid-aerial-mastery" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">The Apex Combat Hybrid: Aerial Mastery</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          The Seraph bloodline represents one of the rarest and most coveted character seeds in Pixel Lineage. Endowed with glowing celestial wings, Seraph characters float above the battlefield grid. This aerial state grants complete immunity to floor traps, caltrops, poison puddles, and lava hazards commonly encountered throughout Act 2 and Act 3 dungeons.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Offensively, Seraph's unique trait is <strong style="color: #fff;">Judgment Brand</strong>. Unlike elemental damage that gets reduced by enemy magic resistance, Judgment Brand converts 10% of all outgoing damage into pure True Holy Damage. When fighting high-defense raid bosses like the Iron Golem or Torment Warden (possessing 70%+ damage reduction), this true damage portion punches straight through armor, maintaining high burst outputs where other classes falter.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          Coupled with a massive +14% Turn Speed modifier, Seraph frequently achieves Action Surges in battle, granting double actions against slow heavy monsters.
        </p>
      </section>

      <!-- Super Class Synergy Matrix -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="best-super-class-synergies-with-seraph" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Best Super Class Synergies with Seraph</h2>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <h3 id="1-monk-fist-super-class-s-tier-meta" style="font-size: 1.1rem; color: #f43f5e; margin: 0 0 6px;">1. Monk (Fist Super Class) — S+ Tier Meta</h3>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              Monk focuses on Ki-empowered multi-strikes. Because Judgment Brand procs on every individual hit in a flurry, a 6-hit Monk flurry delivers 6 instances of True Holy Damage, melting armored bosses in a single turn rotation.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #22c55e;">
            <h3 id="2-sniper-archer-super-class-s-tier-burst" style="font-size: 1.1rem; color: #22c55e; margin: 0 0 6px;">2. Sniper (Archer Super Class) — S Tier Burst</h3>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              Snipers already deal 3.0x precision critical hits. Adding Seraph's speed guarantees backline positioning initiative, allowing the Sniper to eliminate elite enemy casters before they take their first turn.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <h3 id="3-assassin-thief-super-class-a-tier-speed" style="font-size: 1.1rem; color: #34d399; margin: 0 0 6px;">3. Assassin (Thief Super Class) — A+ Tier Speed</h3>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              Combines Thief's highest base Speed (16 + 2.4/lv) with Seraph's +14% flight boost, pushing turn initiative beyond 95+ in end-game PvP Arena duels.
            </p>
          </div>
        </div>
      </section>

      
      <!-- Level 1 to 30 Milestone Scaling Table -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="seraph-level-1-to-30-milestone-progression-ledger" style="font-size: 1.3rem; color: #fff; margin: 0 0 14px;">Seraph Level 1 to 30 Milestone Progression Ledger</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Seraph represents the pinnacle of aerial speed and true damage. Here is the verified stat progression across seven key milestone levels, measured with standard Archer/Assassin archetype scaling:
        </p>

        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
            <thead>
              <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                <th style="padding: 10px 12px;">Level Milestone</th>
                <th style="padding: 10px 12px;">Base Speed</th>
                <th style="padding: 10px 12px;">Base ATK</th>
                <th style="padding: 10px 12px;">Speed Multiplier</th>
                <th style="padding: 10px 12px;">True Damage on Hit</th>
                <th style="padding: 10px 12px;">Trap Immunity</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 1 (Novice)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">14 SPD</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">14 ATK</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">+10.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">8.0% True</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">Active (100%)</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 5 (Apprentice)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">22 SPD</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">23 ATK</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">+10.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">8.0% True</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">Active (100%)</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 10 (Adept)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">32 SPD</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">35 ATK</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">+10.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">8.0% True</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">Active (100%)</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 15 (Super Class)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">43 SPD</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">46 ATK</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">+10.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">8.0% True</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">Active (100%)</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 20 (Master)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">54 SPD</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">58 ATK</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">+10.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">8.0% True</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">Active (100%)</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 25 (Ultra Class)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">65 SPD</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">69 ATK</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">+10.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">8.0% True</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">Active (100%)</td>
              </tr>
              <tr>
                <td style="padding: 10px 12px; font-weight: 600; color: #c9a227;">Level 30 (Capstone)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">76 SPD</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">81 ATK</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">+10.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">8.0% True</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">Active (100%)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Boss Matchup Strategies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="dungeon-boss-tactical-matchup-ledger" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Dungeon Boss Tactical Matchup Ledger</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399; font-size: 1rem; display: block; margin-bottom: 6px;">Goblin King (Act 1)</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              <strong>Advantage: Extreme.</strong> Seraph's +10% Speed ensures you act before Goblin King's turn gauge fills. Featherfall ignores spiked pit traps in the boss arena, allowing free kiting without ever triggering environmental slows.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #38bdf8;">
            <strong style="color: #38bdf8; font-size: 1rem; display: block; margin-bottom: 6px;">Crypt Necromancer (Act 2)</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              <strong>Advantage: Very High.</strong> The Necromancer erects bone barricades with heavy armor. Seraph's 8% True Damage completely pierces through these bone barriers, directly shredding the Necromancer's underlying health pool.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e; font-size: 1rem; display: block; margin-bottom: 6px;">Abyssal Colossus (Act 3)</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              <strong>Advantage: Pinnacle.</strong> The Colossus possesses over 140 DEF (70% physical damage mitigation). While other melee classes struggle to scratch it, Seraph's 8% True Damage deals consistent, unmitigated damage every round.
            </p>
          </div>
        </div>
      </section>

      <!-- Best-in-Slot Equipment Loadout -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="recommended-best-in-slot-equipment-synergies" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Recommended Best-in-Slot Equipment Synergies</h2>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #c9a227;">Weapon: Zephyr Longbow or Piercing Rapier</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Grants +34 ATK, +12 SPD, and multi-hit flurry attacks. Multi-hit weapon skills trigger Seraph's 8% True Damage on every single projectile tick.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #38bdf8;">Armor Set: Windwalker Leathers (Tier 3 Set)</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Provides +38 DEF, +18 SPD, and +15% Evasion. Combines with Seraph's innate aerial agility to achieve over 30% passive dodge rate against boss attacks.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #34d399;">Accessory: Feathered Talisman of the Archon</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Increases turn initiative gauge fill rate by 15%, ensuring your character takes the opening action in 100% of high-tier Torment dungeon rooms.
            </p>
          </div>
        </div>
      </section>

      <!-- Talent Pairing Synergies & Traps -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="talent-pairing-synergies-anti-synergies" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Talent Pairing Synergies & Anti-Synergies</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399; font-size: 0.95rem;">Must-Pick: Keen Eye + Prodigy</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 6px 0 0;">
              Keen Eye adds +5% Crit and +2% Dodge, while Prodigy's +15% universal stat scaling supercharges Seraph's already exceptional Speed and Attack stat growth.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e; font-size: 0.95rem;">Trap Talent: Iron Soul</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 6px 0 0;">
              Seraph survivability relies entirely on evasion, turn priority, and aerial repositioning. Stacking heavy defense is mathematically counterproductive compared to stacking Speed.
            </p>
          </div>
        </div>
      </section>

      
      <!-- Dungeon Exploration & Leveling Route SOP -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="seraph-exploration-leveling-route-sop" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Seraph Exploration & Leveling Route SOP</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Seraph dominates speed progression. Follow this leveling blueprint to leverage your aerial agility and true damage:
        </p>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399;">Early Game (Levels 1–10): Rapid Clearing & Double-Turn Kiting</strong>
