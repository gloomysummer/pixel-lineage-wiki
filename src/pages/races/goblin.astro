---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);

const TITLE = "Goblin Race in Pixel Lineage: +8% Gold & Loot";
const DESC = "Goblin in Pixel Lineage: 8.63% roll, +8% Gold earned and a 6% bonus loot chance, plus how it differs from Dwarf at the same odds.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: TITLE,
    description: DESC,
    url: `${siteConfig.siteUrl}/races/goblin/`,
    datePublished: "2026-11-10T12:00:00+00:00",
    dateModified: "2026-11-10T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Races", item: `${siteConfig.siteUrl}/races/` },
      { "@type": "ListItem", position: 3, name: "Goblin", item: `${siteConfig.siteUrl}/races/goblin/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What does the Goblin race do in Pixel Lineage?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Goblin provides +8% Gold gains from all sources and grants a 6% chance to find bonus loot drops at the end of dungeon encounters.",
        },
      },
      {
        "@type": "Question",
        name: "Where do you farm the Goblin Heirloom and Heartblood?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The Goblin Heirloom drops in Act 2 (Dungeon) or Act 3 (Cursed Forest) on Hard difficulty for Stage 1 Kindled. The Goblin Heartblood drops from Mallgrath, the Lord Below in Act 5 (Underworld) for Stage 2 Exalted.",
        },
      },
      {
        "@type": "Question",
        name: "In the goblin vs dwarf matchup, which is better?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Both share an identical 8.63% drop rate, but Goblin is focused on gold and item farming speed, whereas Dwarf is built purely for defense and maximum HP survival.",
        },
      },
    ],
  },
];

const faqItems = [
  {
    question: "What does the Goblin race do in Pixel Lineage?",
    answer: "Goblin gives an innate +8% Gold yield and a 6% chance for bonus loot drops, making it the primary economic utility race for funding town upgrades and equipment purchases."
  },
  {
    question: "Where do you farm the Goblin Heirloom and Heartblood?",
    answer: "The Goblin Heirloom drops in Act 2 (Dungeon) or Act 3 (Cursed Forest) on Hard difficulty for Stage 1 Kindled. The Goblin Heartblood drops from Mallgrath, the Lord Below in Act 5 (Underworld) for Stage 2 Exalted."
  },
  {
    question: "In the goblin vs dwarf matchup, which is better?",
    answer: "While both sit at an 8.63% roll rate, Goblin is tailored for farming and economy, whereas Dwarf provides +15% HP and +6% DEF for survivability."
  },
];
---

<BaseLayout title={TITLE} description={DESC} canonical="/races/goblin/" jsonLd={jsonLd}>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
        <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
          <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
          <span class="separator" style="margin: 0 8px;">/</span>
          <a href="/races/" style="color: var(--accent); text-decoration: none;">Races</a>
          <span class="separator" style="margin: 0 8px;">/</span>
          <span class="current">Goblin</span>
        </nav>

        <header style="margin-bottom: 32px;">
          <div style="display: inline-block; background: rgba(201, 162, 39, 0.15); border: 1px solid #c9a227; color: #c9a227; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
            Uncommon Bloodline · 8.63% Roll · Grade C
          </div>
          <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
            Pixel Lineage Goblin Race &amp; Farming Guide
          </h1>
          <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0 0 16px;">
            Goblin is the premier economy and farming bloodline in Pixel Lineage, boosting Gold income by +8% and offering a 6% bonus loot chance on dungeon clears.
          </p>

          <div style="background: rgba(168, 85, 247, 0.1); border-left: 4px solid var(--accent); padding: 14px 18px; border-radius: 0 8px 8px 0; margin-bottom: 24px;">
            <div style="font-size: 0.82rem; font-family: var(--font-mono); color: #c9a227; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">
              ⚡ Direct Answer
            </div>
            <p style="margin: 0; font-size: 0.94rem; color: #e8e2f2; line-height: 1.6;">
              <strong>Goblin</strong> is an <strong>8.63% Uncommon race</strong> that grants <strong>+8% Gold gains</strong> and a <strong>6% chance for bonus loot</strong>. Farm the <strong>Heirloom in Act 2 or Act 3 on Hard</strong> for Stage 1 (Kindled), and the <strong>Heartblood from Mallgrath in Act 5</strong> for Stage 2 (Exalted). It is ideal for currency farming before swapping to combat races.
            </p>
          </div>
        </header>

        <MobileToc tocHeadings={tocHeadings} />

        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

        <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #c9a227; border-radius: 8px; padding: 22px; margin-bottom: 32px;">
          <h2 id="innate-racial-trait-ledger" style="font-size: 1.25rem; color: #c9a227; margin: 0 0 12px;">Innate Racial Trait Ledger</h2>
          <div style="overflow-x: auto;">
            <table class="responsive-card-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
              <thead>
                <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                  <th style="padding: 10px 12px;">Parameter</th>
                  <th style="padding: 10px 12px;">Value</th>
                  <th style="padding: 10px 12px;">Economic Effect</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Parameter" style="padding: 10px 12px; font-weight: 700; color: #fff;">Roll Probability</td>
                  <td data-label="Value" style="padding: 10px 12px; color: #34d399; font-family: var(--font-mono);">8.63%</td>
                  <td data-label="Effect" style="padding: 10px 12px; color: var(--muted);">Uncommon rarity tier at the town Goblin Merchant.</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Parameter" style="padding: 10px 12px; font-weight: 700; color: #fff;">Scavenger Gold</td>
                  <td data-label="Value" style="padding: 10px 12px; color: #c9a227; font-family: var(--font-mono);">+8% Gold</td>
                  <td data-label="Effect" style="padding: 10px 12px; color: var(--muted);">Increases gold earned from mob kills, boss bounties, and dungeon rewards.</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Parameter" style="padding: 10px 12px; font-weight: 700; color: #fff;">Lucky Hoard</td>
                  <td data-label="Value" style="padding: 10px 12px; color: #c9a227; font-family: var(--font-mono);">6% Bonus Loot</td>
                  <td data-label="Effect" style="padding: 10px 12px; color: var(--muted);">Triggers a secondary loot roll on clearing encounter rooms.</td>
                </tr>
                <tr>
                  <td data-label="Parameter" style="padding: 10px 12px; font-weight: 700; color: #fff;">Evolution Items</td>
                  <td data-label="Value" style="padding: 10px 12px; color: #f5f3ff;">Act 2/3 &amp; Act 5</td>
                  <td data-label="Effect" style="padding: 10px 12px; color: var(--muted);">Heirloom in Act 2/3 Hard; Heartblood from Mallgrath in Act 5 (shared with Ashborn).</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p style="color: var(--muted); font-size: 0.88rem; margin: 14px 0 0;">
            Compare all drop locations on the <a href="/races/evolution/" style="color: var(--accent); text-decoration: none;">Heirloom &amp; Heartblood guide</a>.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="best-class-pairings" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">Best Class Pairings</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            Goblin fits well with fast speed-farming archetypes:
          </p>
          <ul style="color: var(--muted); font-size: 0.92rem; padding-left: 20px; margin: 0;">
            <li><strong>Thief (Rogue / Assassin)</strong>: High movement speed and critical hits allow rapid clearing of lower-difficulty Acts to maximize gold per minute.</li>
            <li><strong>Archer (Ranger)</strong>: Ranged AoE arrows sweep rooms quickly, capitalizing on the 6% bonus loot trigger.</li>
          </ul>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="should-you-reroll-it" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">Should You Reroll It?</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            When comparing the <a href="/races/dwarf/" style="color: var(--accent); text-decoration: none;">goblin vs dwarf</a> matchup at an identical 8.63% roll rate, Goblin is strictly an economic utility pick.
          </p>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            <strong style="color: #34d399;">Keep on a secondary character</strong>: Having a dedicated Goblin farmer accelerates town repairs, gear purchases, and potion stocks.
          </p>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
            <strong style="color: #f43f5e;">Reroll on your main pusher</strong>: Goblin offers zero combat damage multipliers or defensive mitigation. If you are pushing deep Acts, reroll using spins from <a href="/codes/" style="color: var(--accent); text-decoration: none;">active codes</a>. Check our <a href="/races/best-races/" style="color: var(--accent); text-decoration: none;">best races meta ranking</a> for combat alternatives.
          </p>
        </section>

        <FaqSection items={faqItems} />

        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 24px;">
          <a href="/races/evolution/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
            Heirloom &amp; Heartblood Locations →
          </a>
          <a href="/races/best-races/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
            Best Races &amp; Spin Meta →
          </a>
        </div>

        <div class="ad-slot-footer">
          <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
          <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
        </div>
      </article>

      <DualSidebar tocHeadings={tocHeadings} currentUrl="/races/goblin/" />
    </div>
  </div>
</BaseLayout>
