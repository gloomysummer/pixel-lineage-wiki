---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import FaqSection from "../../components/FaqSection.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Pixel Lineage Bloodlines & Races System Guide",
    description: "Complete guide to racial bloodlines, spin probabilities, and trait synergies in Pixel Lineage on Roblox.",
    url: `${siteConfig.siteUrl}/races/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Races", item: `${siteConfig.siteUrl}/races/` },
    ],
  },
];

const bloodlines = [
  { name: "Seraph", rarity: "Mythic", rate: "0.72%", passive: "Angelic Blessing — all allies take 10% less damage on turn one, healing +25% for 2 rounds", pairing: "Cleric / anything with party healing", color: "#c084fc" },
  { name: "Nightborne", rarity: "Mythic", rate: "0.72%", passive: "Bloodthirst — heals 15% of damage dealt (cap ~7% max HP per move)", pairing: "Mage (Hexer) / Warrior (Berserk)", color: "#a855f7" },
  { name: "Dragonborn", rarity: "Mythic", rate: "0.72%", passive: "Scaled Hide (+15% max HP, -30% Fire damage, -20% from Burned enemies) + Dragonfire AoE Burn", pairing: "Spear (Dragoon → Dragonlord)", color: "#ea580c" },
  { name: "Tideborn", rarity: "Mythic", rate: "0.72%", passive: "Tidal Grace — restores 5% of max HP at the start of each of your turns", pairing: "Warrior / Bard, long Torment runs", color: "#22d3ee" },
  { name: "Celestine", rarity: "Mythic", rate: "1.44%", passive: "+6% Crit, +4% Dodge, +6% Magic", pairing: "Mage / Archer, crit-stacking builds", color: "#eab308" },
  { name: "Sylvan", rarity: "Rare", rate: "7.19%", passive: "+12% Nature Damage & Call Sylph Companion", pairing: "Archer (Ranger) / Bard (Siren)", color: "#34d399" },
  { name: "Vesper", rarity: "Rare", rate: "5.76%", passive: "+8% Magic, small Energy boost, chance to evade ability attacks", pairing: "Mage (Hexer) / Bard", color: "#818cf8" },
  { name: "Slime", rarity: "Rare", rate: "6.47%", passive: "Physical resistance and extra healing after battle; takes increased Fire damage", pairing: "Warrior, physical-heavy content", color: "#4ade80" },
  { name: "Mushroom", rarity: "Rare", rate: "4.32%", passive: "16% chance to poison an attacker when hit", pairing: "Defensive builds, long fights", color: "#fb7185" },
  { name: "Stonekin", rarity: "Uncommon", rate: "7.91%", passive: "+20 Max HP & +15% Fist attack damage", pairing: "Fist (Monk / Brawler / Oni)", color: "#a3e635" },
  { name: "Ashborn", rarity: "Uncommon", rate: "9.35%", passive: "+8% Max HP & +6% Attack", pairing: "Warrior (Berserk) / Thief", color: "#f43f5e" },
  { name: "Goblin", rarity: "Uncommon", rate: "8.63%", passive: "+8% Gold earned & 6% bonus loot chance", pairing: "Farming runs, any class", color: "#fbbf24" },
  { name: "Dwarf", rarity: "Uncommon", rate: "8.63%", passive: "+15% Max HP & +6% DEF", pairing: "Warrior (Sentinel) / Fist", color: "#94a3b8" },
  { name: "Dullahan", rarity: "Event only", rate: "10,000 Candy", passive: "+5% Max HP, +5% DEF, +3% Crit + Headless Ride (4 Energy, 5-turn cooldown)", pairing: "Warrior (Sentinel) / Fist", color: "#38bdf8" },
  { name: "Human", rarity: "Common", rate: "37.41%", passive: "+10% XP & +10% Class Mastery from battles", pairing: "First character, leveling only", color: "#cbd5e1" },
];

const faqItems = [
  {
    question: "What is a Bloodline in Pixel Lineage?",
    answer: "A Bloodline is your character's racial heritage in Pixel Lineage. Each bloodline bestows permanent attribute bonuses, unique defensive or offensive passives, and elemental affinities that dictate high-Torment dungeon performance.",
  },
  {
    question: "What is the best Bloodline overall in Pixel Lineage?",
    answer: "Seraph (Mythic 0.72%) is the best all-around support bloodline thanks to its party-wide damage reduction on turn one. For spellcasters and aggressive bruisers, Nightborne (0.72%) ranks highest for lifesteal sustain, while Ashborn (15.0%) is optimal for physical melee combatants seeking raw offensive and health scaling.",
  },
  {
    question: "How do you get free Race Spins to roll Bloodlines?",
    answer: "Free Race Spins are claimed by redeeming active promotional codes (such as OCTOBER or TORMENT) at the Goblin Merchant NPC in the starter town. Spins are stored directly in your inventory ledger.",
  },
  {
    question: "Does rerolling your Bloodline reset your character level or class?",
    answer: "No, rerolling your bloodline via a Race Spin only replaces your current race passive and racial stat multipliers. Your character level, equipped gear, talent slots, and Super Class progression remain completely unaffected.",
  },
  {
    question: "Do Dragon or Dragonlord races require specific tomes to unlock abilities?",
    answer: "No. Racial passives for the Dragonborn bloodline in Pixel Lineage are innate and activate immediately upon rolling the race. You do not need a race-specific tome or book. In Pixel Lineage, tomes and spellbooks are exclusively used by spellcaster classes (such as Mage and Cleric) to unlock class skills, whereas racial passives scale naturally with your character's Lineage Ranks.",
  },
];

import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);
---


<BaseLayout
  title="Pixel Lineage Races Guide: Bloodlines & Spin Odds"
  description="Complete Pixel Lineage bloodlines & races guide: spin probabilities, Goblin Merchant rerolls, racial passive modifiers, and optimal class pairings."
  canonical="/races/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Races</span>
    </nav>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(201, 162, 39, 0.15); border: 1px solid #c9a227; color: #c9a227; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Core Lineage System
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Races & Bloodlines: Complete Guide
      </h1>
      <p style="color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0;">
        Bloodlines and Talents represent the primary gacha and customization pillars in Pixel Lineage. They provide permanent stat multipliers that define your viability in Act 2 Torment dungeons.
      </p>

      <!-- Direct Answer Box for Pixel Lineage Bloodlines -->
      <div style="background: rgba(201, 162, 39, 0.08); border: 1px solid rgba(201, 162, 39, 0.35); border-left: 4px solid #c9a227; border-radius: 6px; padding: 14px 18px; margin: 18px 0 0; font-size: 0.92rem; line-height: 1.6; color: var(--ink);">
        <strong style="color: #c9a227;">Pixel Lineage Bloodlines Summary:</strong> Bloodlines (playable races) grant permanent stat scalings and unique passive abilities in Pixel Lineage. Obtained via Race Spins at the Goblin Merchant NPC in town, bloodlines span from Common Human (48% chance) to Mythic Seraph (1.0%) and Legendary Nightborn (2.0%). Rerolling modifies passive affinities without resetting character level or learned class skills.
      </div>

      <!-- Dragon / Dragonlord Tome Clarification Box -->
      <div style="background: rgba(168, 85, 247, 0.08); border: 1px solid rgba(168, 85, 247, 0.3); border-left: 4px solid var(--accent); border-radius: 6px; padding: 14px 18px; margin: 14px 0 0; font-size: 0.92rem; line-height: 1.6; color: var(--ink);">
        <strong style="color: #c084fc;">Dragonlord & Race Tomes Clarification:</strong> If you rolled the <em>Dragon</em> or <em>Dragonlord</em> race, <strong>you do NOT need a respective tome or book</strong> to unlock racial abilities or breath skills. Racial passives in Pixel Lineage are innate upon rolling. Spell tomes are exclusively class equipment for Mage/Cleric archetypes, not racial prerequisites.
      </div>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


    <!-- Sub-Guides Navigation Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px;">
      <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 20px; display: flex; flex-direction: column;">
        <h2 id="race-tier-list-rankings" style="font-size: 1.25rem; color: #c9a227; margin: 0 0 10px;">Race Tier List & Rankings</h2>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; flex-grow: 1; margin: 0 0 16px;">
          Empirical tier list of all playable lineages from Legendary Nightborn (2%) down to Human (48%), with full passive breakdowns.
        </p>
        <a href="/tier-list/race-tier-list/" style="color: #c9a227; font-weight: 600; font-size: 0.88rem; text-decoration: none;">
          View Race Tier List →
        </a>
      </div>

      <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 20px; display: flex; flex-direction: column;">
        <h2 id="talent-drop-rates-traits" style="font-size: 1.25rem; color: #38bdf8; margin: 0 0 10px;">Talent Drop Rates & Traits</h2>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; flex-grow: 1; margin: 0 0 16px;">
          Verified drop rates for all traits including Prodigy (+1 all stat growth, 1.5%) and Fortune's Favor (15% Crit, 5%).
        </p>
        <a href="/tier-list/talent-tier-list/" style="color: #38bdf8; font-weight: 600; font-size: 0.88rem; text-decoration: none;">
          Check Talent Drop Rates →
        </a>
      </div>

      <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 20px; display: flex; flex-direction: column;">
        <h2 id="free-race-talent-spins" style="font-size: 1.25rem; color: #34d399; margin: 0 0 10px;">Free Race & Talent Spins</h2>
        <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; flex-grow: 1; margin: 0 0 16px;">
          Redeem active promo codes (such as TORMENT) at the Goblin Merchant NPC to secure free spins without spending Robux. If Nightborn is your target, the <a href="/codes/roblox-nightborn-codes/" style="color: var(--accent);">Nightborn Codes & Spin Guide</a> covers the free-spin codes and the 2.0% drop math.
        </p>
        <a href="/codes/" style="color: #34d399; font-weight: 600; font-size: 0.88rem; text-decoration: none;">
          Redeem Active Codes →
        </a>
      </div>
    </div>

    <!-- Bloodline Roster & Drop Rates -->
    <section style="margin-bottom: 40px;">
      <h2 id="all-racial-bloodlines-spin-rates" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">
        All Racial Bloodlines & Spin Odds
      </h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
        Pixel Lineage features seven established racial bloodlines rolled via Race Spins at the Goblin Merchant, each granting distinct elemental affinities and passive advantages:
      </p>

      <div style="overflow-x: auto; margin-bottom: 24px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; background: #161022; border: 1px solid var(--line); border-radius: 8px;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line); background: #0d0a14;">
              <th style="padding: 12px 16px; color: var(--ink); font-weight: 700;">Bloodline</th>
              <th style="padding: 12px 16px; color: var(--ink); font-weight: 700;">Rarity</th>
              <th style="padding: 12px 16px; color: var(--ink); font-weight: 700;">Spin %</th>
              <th style="padding: 12px 16px; color: var(--ink); font-weight: 700;">Core Passive Buff</th>
              <th style="padding: 12px 16px; color: var(--ink); font-weight: 700;">Optimal Pairings</th>
            </tr>
          </thead>
          <tbody>
            {bloodlines.map((b) => (
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <td style={`padding: 12px 16px; font-weight: 700; color: ${b.color};`}>{b.name}</td>
                <td style="padding: 12px 16px; color: var(--muted);">{b.rarity}</td>
                <td style="padding: 12px 16px; color: #34d399; font-weight: 600;">{b.rate}</td>
                <td style="padding: 12px 16px; color: var(--ink);">{b.passive}</td>
                <td style="padding: 12px 16px; color: var(--muted); font-size: 0.85rem;">{b.pairing}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    
    <!-- 2026-10-20 Weekly Update Note: Dragon Race -->
    

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" /><section style="background: rgba(168, 85, 247, 0.08); border: 1px solid rgba(168, 85, 247, 0.35); border-left: 4px solid var(--accent); border-radius: 8px; padding: 20px 24px; margin-bottom: 36px; line-height: 1.7;">
      <h2 id="dragon-race-update-pending" style="margin: 0 0 8px; font-size: 1.15rem; color: #f5f3ff;">
        📢 October 20, 2026 Update: Dragon Race Added
      </h2>
      <p style="color: var(--muted); font-size: 0.95rem; margin: 0;">
        Dragon race added in the 2026-10-20 update (experience renamed to <em>Pixel Lineage [🎃Spear Class + Dragon Race]</em>) — passive trait and spin probability pending verification. Full racial modifiers and roll seed brackets will be integrated once confirmed from server-side sampling.
      </p>
    </section>

    <!-- How the Spin System Works -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px; line-height: 1.7;">
      <h2 id="how-the-reroll-system-works" style="font-size: 1.3rem; color: var(--ink); margin: 0 0 16px;">How the Reroll System Works</h2>
      <p style="color: var(--muted); font-size: 0.95rem; margin: 0 0 12px;">
        When creating a character or using a <strong>Race Spin</strong> in town:
      </p>
      <ul style="color: var(--muted); font-size: 0.9rem; padding-left: 20px; margin: 0 0 16px;">
        <li>Your current race is immediately replaced by a new random lineage based on the global seed.</li>
        <li>Racial passives apply automatically to all base stats and Super Class skill calculations.</li>
        <li>Talent slots unlock as your character gains Lineage Ranks throughout Act 1 and Act 2.</li>
      </ul>
      <p style="color: var(--muted); font-size: 0.9rem; margin: 0;">
        Never reroll a Mythic race (<a href="/races/nightborn/" style="color: var(--accent); text-decoration: none;">Nightborne</a>, Seraph, Dragonborn, Tideborn, all 0.72%) unless you are sitting on 15+ spare Race Spins. And before you reroll an Uncommon or Rare race, check the <a href="/races/evolution/" style="color: var(--accent); text-decoration: none;">Heirloom &amp; Heartblood locations</a> — evolution makes those rolls usable, so a keep decision is often cheaper than another spin.
      </p>
    </section>

    <!-- FAQ Section -->
    <FaqSection items={faqItems} />

    <!-- Links -->
    <div style="text-align: center;">
      <a href="/races/best-races/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-block; margin: 4px;">
        Best Races &amp; Spin Meta →
      </a>
      <a href="/races/evolution/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-block; margin: 4px;">
        Heirloom &amp; Heartblood Locations →
      </a>
      <a href="/races/dragonborn/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-block; margin: 4px;">
        Dragonborn Race Guide →
      </a>
      <a href="/classes/super-classes/" style="background: rgba(168, 85, 247, 0.2); border: 1px solid #a855f7; color: #f5f3ff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-block; margin: 4px;">
        Explore Class & Race Synergies →
      </a>
    </div>
  
            <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/races/" />
    </div></div>
</BaseLayout>
