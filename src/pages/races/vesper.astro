---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);

const TITLE = "Vesper Race in Pixel Lineage: +8% Magic & Evasion";
const DESC = "Vesper in Pixel Lineage: 5.76% roll, +8% Magic damage, a small Energy boost and a chance to evade ability attacks.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: TITLE,
    description: DESC,
    url: `${siteConfig.siteUrl}/races/vesper/`,
    datePublished: "2026-11-10T12:00:00+00:00",
    dateModified: "2026-11-10T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Races", item: `${siteConfig.siteUrl}/races/` },
      { "@type": "ListItem", position: 3, name: "Vesper", item: `${siteConfig.siteUrl}/races/vesper/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What does the Vesper race do in Pixel Lineage?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Vesper provides +8% Magic damage, increases your character's Energy pool, and grants a chance to dodge incoming enemy skill attacks.",
        },
      },
      {
        "@type": "Question",
        name: "What is the roll chance for Vesper in Pixel Lineage?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Vesper is a Rare bloodline with a 5.76% roll chance from the Goblin Merchant spin pool.",
        },
      },
      {
        "@type": "Question",
        name: "Where do you get the Vesper Heirloom and Heartblood?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The Vesper Heirloom drops in Act 6 (Withered Meadow) on Nightmare difficulty for Stage 1 Kindled. The Vesper Heartblood drops from The Tolling Bell in Act 7 (Drowned Cathedral) for Stage 2 Exalted.",
        },
      },
      {
        "@type": "Question",
        name: "Which classes pair best with the Vesper race?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Vesper fits well with spellcasters like Mage (Hexer or Cleric) and Bard, where additional energy and magic multipliers enhance spell cycling.",
        },
      },
    ],
  },
];

const faqItems = [
  {
    question: "What does the Vesper race do in Pixel Lineage?",
    answer: "Vesper grants +8% Magic damage, raises your maximum Energy pool, and provides a built-in chance to evade hostile skill attacks, giving squishy casters evasive survivability."
  },
  {
    question: "What is the roll chance for Vesper in Pixel Lineage?",
    answer: "Vesper sits at 5.76% probability in the Rare tier at the town spin vendor."
  },
  {
    question: "Where do you get the Vesper Heirloom and Heartblood?",
    answer: "The Vesper Heirloom drops in Act 6 (Withered Meadow) on Nightmare difficulty to reach Stage 1 Kindled. The Vesper Heartblood drops from The Tolling Bell boss in Act 7 (Drowned Cathedral) to reach Stage 2 Exalted."
  },
  {
    question: "Which classes pair best with the Vesper race?",
    answer: "Vesper fits well with magic-focused archetypes like Mage (Hexer, Cleric, Summoner) and spell-based Bards looking for energy capacity and spell evasion."
  },
];
---

<BaseLayout title={TITLE} description={DESC} canonical="/races/vesper/" jsonLd={jsonLd}>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
        <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
          <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
          <span class="separator" style="margin: 0 8px;">/</span>
          <a href="/races/" style="color: var(--accent); text-decoration: none;">Races</a>
          <span class="separator" style="margin: 0 8px;">/</span>
          <span class="current">Vesper</span>
        </nav>

        <header style="margin-bottom: 32px;">
          <div style="display: inline-block; background: rgba(168, 85, 247, 0.15); border: 1px solid var(--accent); color: #c084fc; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
            Rare Bloodline · 5.76% Roll · Grade B
          </div>
          <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
            Pixel Lineage Vesper Race &amp; Caster Guide
          </h1>
          <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0 0 16px;">
            The Vesper race in Pixel Lineage is tailored for arcane spellcasters, offering +8% Magic damage, higher energy pools, and evasive skill dodging.
          </p>

          <div style="background: rgba(168, 85, 247, 0.1); border-left: 4px solid var(--accent); padding: 14px 18px; border-radius: 0 8px 8px 0; margin-bottom: 24px;">
            <div style="font-size: 0.82rem; font-family: var(--font-mono); color: #c9a227; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">
              ⚡ Direct Answer
            </div>
            <p style="margin: 0; font-size: 0.94rem; color: #e8e2f2; line-height: 1.6;">
              <strong>Vesper</strong> is a <strong>5.76% Rare race</strong>. It grants <strong>+8% Magic damage</strong>, an <strong>expanded Energy pool</strong>, and a <strong>chance to dodge skill attacks</strong>. Farm the <strong>Vesper Heirloom in Act 6 (Withered Meadow) on Nightmare</strong> for Stage 1 (Kindled), and farm the <strong>Heartblood from The Tolling Bell in Act 7 (Drowned Cathedral)</strong> for Stage 2 (Exalted).
            </p>
          </div>
        </header>

        <MobileToc tocHeadings={tocHeadings} />

        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

        <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #c084fc; border-radius: 8px; padding: 22px; margin-bottom: 32px;">
          <h2 id="innate-racial-trait-ledger" style="font-size: 1.25rem; color: #c084fc; margin: 0 0 12px;">Innate Racial Trait Ledger</h2>
          <div style="overflow-x: auto;">
            <table class="responsive-card-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
              <thead>
                <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                  <th style="padding: 10px 12px;">Trait</th>
                  <th style="padding: 10px 12px;">Focus</th>
                  <th style="padding: 10px 12px;">Combat Effect</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Trait" style="padding: 10px 12px; font-weight: 700; color: #fff;">Arcane Resonance</td>
                  <td data-label="Focus" style="padding: 10px 12px; color: #c084fc;">Offense</td>
                  <td data-label="Effect" style="padding: 10px 12px; color: var(--muted);">Increases all Magic damage dealt by +8%.</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Trait" style="padding: 10px 12px; font-weight: 700; color: #fff;">Starlight Reserve</td>
                  <td data-label="Focus" style="padding: 10px 12px; color: #c084fc;">Resource</td>
                  <td data-label="Effect" style="padding: 10px 12px; color: var(--muted);">Expands the maximum Energy threshold for skill casts.</td>
                </tr>
                <tr>
                  <td data-label="Trait" style="padding: 10px 12px; font-weight: 700; color: #fff;">Ethereal Step</td>
                  <td data-label="Focus" style="padding: 10px 12px; color: #c084fc;">Defense</td>
                  <td data-label="Effect" style="padding: 10px 12px; color: var(--muted);">Grants a passive chance to completely evade incoming hostile skill attacks.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p style="color: var(--muted); font-size: 0.88rem; margin: 14px 0 0;">
            Compare with other magical races on the <a href="/races/best-races/" style="color: var(--accent); text-decoration: none;">best races meta hub</a>.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="how-to-obtain-spin-odds" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">How to Obtain — Spin Odds</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            Vesper is rolled from the Goblin Merchant spin wheel at a 5.76% Rare probability.
          </p>
          <p style="color: var(--muted); font-size: 0.88rem; margin: 0;">
            Claim extra spins with <a href="/codes/" style="color: var(--accent); text-decoration: none;">Pixel Lineage codes</a>.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #c9a227; border-radius: 8px; padding: 22px; margin-bottom: 32px;">
          <h2 id="race-evolution-heirloom-and-heartblood" style="font-size: 1.25rem; color: #c9a227; margin: 0 0 12px;">Race Evolution: Heirloom &amp; Heartblood Locations</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            Vesper follows the universal evolution chain: <strong>Heirloom for Kindled (Stage 1)</strong> and <strong>Heartblood for Exalted (Stage 2)</strong>.
          </p>
          <div style="overflow-x: auto;">
            <table class="responsive-card-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
              <thead>
                <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                  <th style="padding: 10px 12px;">Stage</th>
                  <th style="padding: 10px 12px;">Item Name</th>
                  <th style="padding: 10px 12px;">Encounter Details</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Stage" style="padding: 10px 12px; font-weight: 700; color: #f5f3ff;">Stage 1: Kindled</td>
                  <td data-label="Item" style="padding: 10px 12px; color: #c9a227;">Vesper Heirloom</td>
                  <td data-label="Location" style="padding: 10px 12px; color: var(--muted);">Act 6 (Withered Meadow) on Nightmare difficulty</td>
                </tr>
                <tr>
                  <td data-label="Stage" style="padding: 10px 12px; font-weight: 700; color: #f5f3ff;">Stage 2: Exalted</td>
                  <td data-label="Item" style="padding: 10px 12px; color: #f43f5e;">Vesper Heartblood</td>
                  <td data-label="Location" style="padding: 10px 12px; color: var(--muted);">Act 7 (Drowned Cathedral) from The Tolling Bell</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p style="color: var(--muted); font-size: 0.88rem; margin: 12px 0 0;">
            The Tolling Bell simultaneously drops Heartbloods for both Vesper and <a href="/races/tideborn/" style="color: var(--accent); text-decoration: none;">Tideborn</a>. See all drops on the <a href="/races/evolution/" style="color: var(--accent); text-decoration: none;">Race Evolution guide</a>.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="best-class-synergies" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">Best Class Synergies</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            Vesper fits well with spellcasters:
          </p>
          <ul style="color: var(--muted); font-size: 0.92rem; padding-left: 20px; margin: 0;">
            <li><strong><a href="/classes/mage/" style="color: var(--accent); text-decoration: none;">Mage</a> (Hexer / Cleric)</strong>: Gains higher skill damage and energy pools for continuous spell uptime.</li>
            <li><strong>Bard (Pianist / Siren)</strong>: Benefits from the energy boost to sustain multi-target party songs.</li>
          </ul>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="talent-and-gear-priority" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">Talent &amp; Gear Priority</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
            Prioritize spell focus staves and gear granting cooldown recovery and magic attack power to leverage the +8% damage baseline.
          </p>
        </section>

        <FaqSection items={faqItems} />

        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 24px;">
          <a href="/races/evolution/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
            Heirloom &amp; Heartblood Locations →
          </a>
          <a href="/races/best-races/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
            Best Races &amp; Spin Meta →
          </a>
        </div>

        <div class="ad-slot-footer">
          <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
          <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
        </div>
      </article>

      <DualSidebar tocHeadings={tocHeadings} currentUrl="/races/vesper/" />
    </div>
  </div>
</BaseLayout>
