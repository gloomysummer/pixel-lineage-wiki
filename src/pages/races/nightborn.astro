---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);

const TITLE = "Nightborne (Nightborn) Race: Bloodthirst";
const DESC = "Nightborne (Nightborn) in Pixel Lineage: 0.72% Mythic roll, Bloodthirst heals 15% of damage dealt, plus evolution materials and Mage builds.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Nightborne (Nightborn) Race Guide",
    description: DESC,
    url: `${siteConfig.siteUrl}/races/nightborn/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    dateModified: "2026-11-10T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Races", item: `${siteConfig.siteUrl}/races/` },
      { "@type": "ListItem", position: 3, name: "Nightborne", item: `${siteConfig.siteUrl}/races/nightborn/` },
    ],
  },
];

const mythicTier = [
  { race: "Nightborne", odds: "0.72%", kit: "Lifesteal on attack", note: "This page" },
  { race: "Seraph", odds: "0.72%", kit: "Party damage reduction + healing", note: "Support pick" },
  { race: "Dragonborn", odds: "0.72%", kit: "Fire resistance + AoE Burn", note: "Added 2026-10-20" },
  { race: "Tideborn", odds: "0.72%", kit: "Per-turn HP regeneration", note: "Sustain pick" },
  { race: "Celestine", odds: "1.44%", kit: "+6% Crit, +4% Dodge, +6% Magic", note: "Twice the odds" },
];

const faqItems = [
  {
    "question": "Is Nightborn the same race as Nightborne?",
    "answer": "Yes. The in-game spelling is Nightborne and that is what this page uses; a large share of players search and type it as Nightborn. It is one Mythic bloodline at 0.72%, not two different races — treat any guide that lists them separately as unreliable."
  },
  {
    "question": "What does the Bloodthirst passive actually do in Pixel Lineage?",
    "answer": "Bloodthirst heals you for 15% of the damage your attacks deal, with a cap of roughly 7% of your maximum HP per move. The cap is what stops a single huge critical hit from refilling your whole bar, so in practice it works best on a build that attacks often rather than one that lands one enormous hit per turn."
  },
  {
    "question": "What are the exact odds of rolling Nightborne from the Goblin Merchant?",
    "answer": "0.72%, which puts it in the Mythic band alongside Seraph, Dragonborn and Tideborn. Celestine sits slightly above at 1.44%. At 0.72% you need roughly 96 Race Spins for a coin-flip chance at any single Mythic bloodline, and there are four of them competing for that roll."
  },
  {
    "question": "Does Bloodthirst heal off spell damage or only physical attacks?",
    "answer": "Published sources describe it as healing from attacks without splitting physical from magic, so treat magic attacks as working but unconfirmed. If you are building a pure caster, verify it in a single easy dungeon before committing your Talent Spins to that plan — it is a five-minute test in Act 1."
  },
  {
    "question": "Where do you get the Nightborne Heirloom and Heartblood?",
    "answer": "The Heirloom drops in Act 9 (Hollow Sky) on Nightmare difficulty and evolves the race to Stage 1, Kindled. The Heartblood drops from the Crypt Lord in Act 2 (Dungeon) and evolves Kindled to Stage 2, Exalted. Stage 3 needs additional Heartbloods plus race-specific requirements. Both items are also tradeable in the Auction House under the Bloodline category."
  },
  {
    "question": "Is Nightborne good for melee classes or only casters?",
    "answer": "It is the rare race that works on both. On a caster the lifesteal offsets the low HP pool that normally forces potion use; on a Berserk Warrior the same lifesteal keeps you inside the low-HP window that Blood Heat scales from. That flexibility is why it is ranked S tier rather than A."
  },
  {
    "question": "Should you reroll away from Nightborne?",
    "answer": "No. It is one of the four 0.72% bloodlines and arguably the most broadly useful of them. The only defensible reason to reroll is if you specifically need Celestine's critical stats for a crit-stacking build — and even then, evolving Nightborne to Kindled or Exalted is usually the cheaper path."
  },
];
---

<BaseLayout title={TITLE} description={DESC} canonical="/races/nightborn/" jsonLd={jsonLd}>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/races/" style="color: var(--accent); text-decoration: none;">Races</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Nightborne</span>
    </nav>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">

        <header style="margin-bottom: 32px;">
          <div style="display: inline-block; background: rgba(168, 85, 247, 0.15); border: 1px solid #a855f7; color: #a855f7; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
            Mythic Bloodline · 0.72% Roll · Also searched as &quot;Nightborn&quot;
          </div>
          <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
            Pixel Lineage Nightborne (Nightborn) Race Guide
          </h1>
          <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0 0 16px;">
            Nightborne is the lifesteal bloodline: every attack returns health to you. That one clause is why it is the most broadly useful of the four 0.72% Mythic races — it fixes the survivability problem for casters and it powers the low-HP Berserk window for melee at the same time. This page covers the exact passive numbers, the roll odds, both evolution materials, and which classes actually convert it into damage.
          </p>

          <div style="background: rgba(168, 85, 247, 0.1); border-left: 4px solid var(--accent); padding: 14px 18px; border-radius: 0 8px 8px 0; margin-bottom: 24px;">
            <div style="font-size: 0.82rem; font-family: var(--font-mono); color: #c9a227; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">
              ⚡ Direct Answer
            </div>
            <p style="margin: 0; font-size: 0.94rem; color: #e8e2f2; line-height: 1.6;">
              <strong>Nightborne</strong> is a <strong>Mythic race at 0.72%</strong>. Its passive <strong>Bloodthirst</strong> heals you for <strong>15% of the damage you deal</strong>, capped at roughly <strong>7% of maximum HP per move</strong>. The Heirloom that evolves it to <strong>Kindled</strong> drops in <strong>Act 9 (Hollow Sky) on Nightmare</strong>; the <strong>Heartblood</strong> that evolves it to <strong>Exalted</strong> drops from the <strong>Crypt Lord in Act 2 (Dungeon)</strong>. It is the safest Mythic to keep and the easiest to build around.
            </p>
          </div>
        </header>

        <MobileToc tocHeadings={tocHeadings} />

        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

        <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #a855f7; border-radius: 8px; padding: 22px; margin-bottom: 32px;">
          <h2 id="nightborne-innate-racial-trait-ledger" style="font-size: 1.25rem; color: #a855f7; margin: 0 0 12px;">Innate Racial Trait Ledger</h2>
          <div style="overflow-x: auto;">
            <table class="responsive-card-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
              <thead>
                <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                  <th style="padding: 10px 12px;">Trait</th>
                  <th style="padding: 10px 12px;">Exact Effect</th>
                  <th style="padding: 10px 12px;">Why It Matters</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Trait" style="padding: 10px 12px; font-weight: 700; color: #fff;">Bloodthirst <span style="color: var(--muted); font-weight: 400;">(passive)</span></td>
                  <td data-label="Exact Effect" style="padding: 10px 12px; color: #34d399;">Heals 15% of damage dealt. Capped at roughly 7% of maximum HP per move.</td>
                  <td data-label="Why" style="padding: 10px 12px; color: var(--muted);">The per-move cap is the whole design. Many small attacks heal more total than one huge hit.</td>
                </tr>
                <tr>
                  <td data-label="Trait" style="padding: 10px 12px; font-weight: 700; color: #fff;">Roll chance</td>
                  <td data-label="Exact Effect" style="padding: 10px 12px; color: #34d399;">0.72% from the Race Spin pool</td>
                  <td data-label="Why" style="padding: 10px 12px; color: var(--muted);">Mythic band. Not a shop item, not an event purchase — only roller spins or evolution.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p style="color: var(--muted); font-size: 0.88rem; margin: 14px 0 0;">
            Two myths worth killing here, because they circulate widely and they change build decisions. First: <strong>there is no mana stat in Pixel Lineage</strong> — skills cost Energy, so no race can give you "mana regeneration". Second: <strong>Nightborne is Mythic at 0.72%, not a 2% "Legendary"</strong>. If a guide tells you either of those, its numbers are invented and the rest of it is not worth reading. Compare the real passive against <a href="/races/seraph/" style="color: var(--accent); text-decoration: none;">Seraph</a> and <a href="/races/dragonborn/" style="color: var(--accent); text-decoration: none;">Dragonborn</a>.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="how-to-obtain-nightborne-spin-odds-cost" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">How to Obtain — Spin Odds &amp; Reroll Reality</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
            Nightborne comes only from the Race Spin pool. There is no code that grants it, no shop entry, and no event stall — the only shortcut is the Auction House for its evolution items later. Here is the whole Mythic band for comparison:
          </p>
          <div style="overflow-x: auto;">
            <table class="responsive-card-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
              <thead>
                <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                  <th style="padding: 10px 12px;">Mythic Race</th>
                  <th style="padding: 10px 12px;">Roll Chance</th>
                  <th style="padding: 10px 12px;">Kit</th>
                  <th style="padding: 10px 12px;">Note</th>
                </tr>
              </thead>
              <tbody>
                {mythicTier.map((m) => (
                  <tr style="border-bottom: 1px solid var(--line);">
                    <td data-label="Race" style="padding: 10px 12px; font-weight: 700; color: {m.race === 'Nightborne' ? '#a855f7' : '#fff'};">{m.race}</td>
                    <td data-label="Roll Chance" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">{m.odds}</td>
                    <td data-label="Kit" style="padding: 10px 12px; color: var(--muted);">{m.kit}</td>
                    <td data-label="Note" style="padding: 10px 12px; color: #c9a227;">{m.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 16px 0 0;">
            At 0.72% you need roughly <strong>96 spins</strong> for a coin-flip chance at one specific Mythic — and there are four of them, so any Mythic at all is roughly a coin flip in about 24 spins. Bank free spins from <a href="/codes/" style="color: var(--accent); text-decoration: none;">active codes</a> before you spend Robux: most code rewards bundle Race and Talent Spins together, so one redemption funds both.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #c9a227; border-radius: 8px; padding: 22px; margin-bottom: 32px;">
          <h2 id="race-evolution-heirloom-heartblood-locations" style="font-size: 1.25rem; color: #c9a227; margin: 0 0 12px;">Race Evolution: Heirloom &amp; Heartblood Locations</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 14px;">
            Nightborne is worth evolving rather than rerolling, and its two materials sit at opposite ends of the act list — which surprises people. Order is fixed for every race in the game: <strong style="color: #f5f3ff;">Heirloom → Kindled (Stage 1)</strong>, then <strong style="color: #f5f3ff;">Heartblood → Exalted (Stage 2)</strong>.
          </p>
          <div style="overflow-x: auto;">
            <table class="responsive-card-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
              <thead>
                <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                  <th style="padding: 10px 12px;">Item</th>
                  <th style="padding: 10px 12px;">Result</th>
                  <th style="padding: 10px 12px;">Where</th>
                  <th style="padding: 10px 12px;">Source</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Item" style="padding: 10px 12px; font-weight: 700; color: #fff;">Nightborne Heirloom</td>
                  <td data-label="Result" style="padding: 10px 12px; color: #34d399;">Stage 1 · Kindled</td>
                  <td data-label="Where" style="padding: 10px 12px; color: var(--muted);">Act 9 (Hollow Sky)</td>
                  <td data-label="Source" style="padding: 10px 12px; color: #f43f5e; font-weight: 700;">Nightmare difficulty</td>
                </tr>
                <tr>
                  <td data-label="Item" style="padding: 10px 12px; font-weight: 700; color: #fff;">Nightborne Heartblood</td>
                  <td data-label="Result" style="padding: 10px 12px; color: #c9a227;">Stage 2 · Exalted, then Stage 3</td>
                  <td data-label="Where" style="padding: 10px 12px; color: var(--muted);">Act 2 (Dungeon)</td>
                  <td data-label="Source" style="padding: 10px 12px; color: #a855f7; font-weight: 700;">Crypt Lord</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 14px 0 0;">
            <strong style="color: #f5f3ff;">The Act 2 / Act 9 split is not a typo.</strong> Act 2 Dungeon also drops Heartbloods for other races, so confirm you are at the <em>Crypt Lord</em> specifically — Mother Blight in Cursed Forest is a different boss with different drops. As soon as either item drops, pick <em>Return Home</em> on the node map so the run banks without spending a Life, then consume it from the Gear menu.
          </p>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 10px 0 0;">
            Full Act, difficulty and boss table for all fourteen races on the <a href="/races/evolution/" style="color: var(--accent); text-decoration: none;">Heirloom &amp; Heartblood locations page</a>.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="best-class-synergies-with-nightborne" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Best Class Synergies</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 18px;">
            Bloodthirst is class-agnostic — it does not care what generated the damage. That makes the "best" class a question of which class benefits most from not having to spend turns healing. Three answer that differently:
          </p>

          <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #a855f7; border-radius: 6px; padding: 18px; margin-bottom: 16px;">
            <h3 id="1-hexer-mage-s-tier-synergy" style="margin: 0 0 6px; font-size: 1.1rem; color: #a855f7;">1. Hexer (Mage) — the damage conversion</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              Hexer opens every battle by applying <strong style="color: #f5f3ff;">Weakened</strong> to enemies (−15% damage for 2 turns), which buys exactly the two turns a low-HP caster needs to stabilise. Bloodthirst then refunds the health those turns cost. This is the pairing most players mean when they say Nightborne is a "mage race" — it is the cheapest way to make an Energy-hungry caster survive Act 2 without potion spam. See the <a href="/classes/mage/" style="color: var(--accent); text-decoration: none;">Mage class guide</a>.
            </p>
          </div>

          <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #34d399; border-radius: 6px; padding: 18px; margin-bottom: 16px;">
            <h3 id="2-cleric-mage-s-tier-synergy" style="margin: 0 0 6px; font-size: 1.1rem; color: #34d399;">2. Cleric (Mage) — the over-heal stack</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              Cleric's <strong style="color: #f5f3ff;">Quiet Grace</strong> makes you less likely to be targeted while partied, and Smite / Mending Light let you trade damage and healing on the same turn. With Bloodthirst running, the healing half mostly becomes free — which turns Cleric into a genuine damage slot instead of a pure support tax. Its Ultra Class is Seraph, which is also a race name, so do not confuse the two.
            </p>
          </div>

          <div style="background: #0d0a14; border: 1px solid var(--line); border-left: 4px solid #ea580c; border-radius: 6px; padding: 18px;">
            <h3 id="3-berserk-warrior-a-niche-but-real-synergy" style="margin: 0 0 6px; font-size: 1.1rem; color: #ea580c;">3. Berserk (Warrior) — the low-HP engine</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              Berserk's <strong style="color: #f5f3ff;">Blood Heat</strong> scales sword damage as your HP drops, up to +20%. Most races cannot hold that window without dying. Bloodthirst can: the 7%-of-max-HP-per-move cap lets you hover at low HP, healing just enough to survive the next hit while staying inside the damage band. This is the highest-ceiling Nightborne build and the easiest one to get wrong — see the <a href="/classes/warrior/" style="color: var(--accent); text-decoration: none;">Warrior class guide</a> for the Berserk skill list.
            </p>
          </div>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="talent-pairing-synergies-anti-synergies" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Talent Pairing</h2>
          <div style="overflow-x: auto;">
            <table class="responsive-card-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
              <thead>
                <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                  <th style="padding: 10px 12px;">Talent</th>
                  <th style="padding: 10px 12px;">Roll Chance</th>
                  <th style="padding: 10px 12px;">Why it fits Nightborne</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Talent" style="padding: 10px 12px; font-weight: 700; color: #fff;">Prodigy</td>
                  <td data-label="Chance" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">Mythic · 1%</td>
                  <td data-label="Why" style="padding: 10px 12px; color: var(--muted);">+5% to four stats plus +2% Crit, +10% XP and Mastery. The only talent that improves the lifesteal on both axes — more damage in, more XP out.</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Talent" style="padding: 10px 12px; font-weight: 700; color: #fff;">Arcane Spark</td>
                  <td data-label="Chance" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">Rare · 10%</td>
                  <td data-label="Why" style="padding: 10px 12px; color: var(--muted);">+1 starting Energy and +8% Magic. The realistic target for a caster build — 10% is ten times Prodigy's odds.</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Talent" style="padding: 10px 12px; font-weight: 700; color: #fff;">Iron Soul</td>
                  <td data-label="Chance" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">Uncommon · 14%</td>
                  <td data-label="Why" style="padding: 10px 12px; color: var(--muted);">+6% DEF and a 30% chance to ignore a debuff. Directly protects the Berserk low-HP window from a stun that would end the run.</td>
                </tr>
                <tr>
                  <td data-label="Talent" style="padding: 10px 12px; font-weight: 700; color: #fff;">Quick Study</td>
                  <td data-label="Chance" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">Uncommon · 18%</td>
                  <td data-label="Why" style="padding: 10px 12px; color: var(--muted);">+12% XP and +15% Class Mastery. Take it on a fresh Nightborne to reach Kindled content faster, then reroll it later.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p style="color: var(--muted); font-size: 0.88rem; margin: 12px 0 0;">
            Full roll chances and tiering for all seven talents on the <a href="/tier-list/talent-tier-list/" style="color: var(--accent); text-decoration: none;">talent tier list</a>. Note the trap: <strong>Fortune's Favor</strong> (+10% Gold, +8% loot) is a farming talent, not a combat one — do not hold it on your Nightborne main.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="should-you-reroll-it" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">Should You Reroll It?</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            <strong style="color: #34d399;">Keep it.</strong> Four of the fourteen bloodlines roll at 0.72%, and Nightborne is the one that works on both a caster and a melee build. Rerolling a 0.72% Mythic to chase a 1.44% Celestine is a bad trade in expected value — you would be spending ~96 spins to improve a build that was already fine.
          </p>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            <strong style="color: #c9a227;">The one exception:</strong> a dedicated crit-stacking build where Celestine's +6% Crit and +6% Magic compound into something Nightborne's lifesteal cannot match. Even then, evolve Nightborne first and compare before spending the spins.
          </p>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
            See where it sits against the rest on the <a href="/tier-list/race-tier-list/" style="color: var(--accent); text-decoration: none;">race tier list</a> and the <a href="/races/best-races/" style="color: var(--accent); text-decoration: none;">best races &amp; spin meta</a> page.
          </p>
        </section>

        <FaqSection items={faqItems} />

        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 24px;">
          <a href="/races/evolution/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
            Heirloom &amp; Heartblood Locations →
          </a>
          <a href="/codes/roblox-nightborn-codes/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
            Free Race Spins via Codes →
          </a>
        </div>

        <div class="ad-slot-footer">
          <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
