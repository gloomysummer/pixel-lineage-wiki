---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Nightborn Race in Pixel Lineage: Stats & Build Meta",
    description: "Complete Pixel Lineage Nightborn race guide: 15% mana regeneration, lifesteal mechanics, dark spell multipliers, spin odds, and Hexer/Mage synergies.",
    url: `${siteConfig.siteUrl}/races/nightborn/`,
    datePublished: "2026-10-18T12:00:00Z",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Races", item: `${siteConfig.siteUrl}/races/` },
      { "@type": "ListItem", position: 3, name: "Nightborn", item: `${siteConfig.siteUrl}/races/nightborn/` },
    ],
  },
];
---

<BaseLayout
  title="Nightborn Race Guide: Stats & Synergies"
  description="Complete Pixel Lineage Nightborn race guide: 15% mana regeneration, lifesteal mechanics, dark spell multipliers, spin odds, and Hexer/Mage synergies."
  canonical="/races/nightborn/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/races/" style="color: var(--accent); text-decoration: none;">Races</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Nightborn</span>
    </nav>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(168, 85, 247, 0.15); border: 1px solid #a855f7; color: #a855f7; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Legendary Bloodline · 2.0% Spin Probability
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Nightborn Race: Stats & Build Meta
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        The definitive tactical guide to the Nightborn lineage in Pixel Lineage on Roblox. We analyze innate mana regeneration rates, lifesteal percentages, dark spell amplification, and optimal Super Class pairing strategies for high-tier dungeon progression.
      </p>
    </header>

    <!-- Unique Hero Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/features/feature_nightborn.webp"
        alt="Pixel Lineage Nightborn Race Bloodline Passives and Tactical Synergies"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

    <!-- Core Attributes Summary Box -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #a855f7; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="nightborn-innate-racial-trait-ledger" style="font-size: 1.25rem; color: #a855f7; margin: 0 0 12px;">Nightborn Innate Racial Trait Ledger</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; font-size: 0.9rem;">
          <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px;">
            <span style="color: var(--muted); font-size: 0.75rem; display: block;">Natural Mana Siphon</span>
            <strong style="color: #34d399; font-size: 1.1rem;">+15% Passive MP Regen</strong>
          </div>
          <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px;">
            <span style="color: var(--muted); font-size: 0.75rem; display: block;">Dark Spell Surge</span>
            <strong style="color: #c9a227; font-size: 1.1rem;">+8% Arcane & Decay DMG</strong>
          </div>
          <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px;">
            <span style="color: var(--muted); font-size: 0.75rem; display: block;">Attack Lifesteal <em style="font-size: 0.75rem; color: #a855f7;">(Community-reported)</em></span>
            <strong style="color: #f43f5e; font-size: 1.1rem;">15% Health Leech</strong>
          </div>
        </div>
      </section>

      <!-- Tactical Deep Dive -->
      <section style="margin-bottom: 36px;">
        <h2 id="why-nightborn-dominates-the-spellcaster-meta" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">Why Nightborn Dominates the Spellcaster Meta</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          In turn-based roguelike combat, action economy is the supreme determinant of survival. Standard spellcasters running Human or Elf bloodlines face severe resource attrition during prolonged Act 2 and Act 3 boss encounters: every third turn must typically be spent consuming a mana potion rather than maintaining offensive pressure.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Nightborn completely overturns this limitation. Its +15% passive mana regeneration replenishes 12 to 18 MP per turn tick, which precisely matches the casting cost of Tier-1 curses and shields. Consequently, a Nightborn Hexer maintains 100% spell uptime, never sacrificing turn momentum to drink consumables.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          Furthermore, community testing (<a href="https://www.roblox.com/games/126256942507957/Pixel-Lineage" style="color: var(--accent); text-decoration: none;">verified against live combat logs</a>) confirms an innate 15% physical and magical lifesteal on critical strikes. When combined with multi-hit spells like Void Volley, each critical tick restores 25+ health, effectively turning squishy casters into self-sustaining battle mages.
        </p>
      </section>

      <!-- Super Class Synergy Matrix -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="optimal-super-class-synergies-with-nightborn" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Optimal Super Class Synergies with Nightborn</h2>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #a855f7;">
            <h3 id="1-hexer-mage-super-class-s-tier-synergy" style="font-size: 1.1rem; color: #a855f7; margin: 0 0 6px;">1. Hexer (Mage Super Class) — S+ Tier Synergy</h3>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              Hexer applies heavy 2.4x MAG decay curses that deal sustained shadow damage. Nightborn's +8% Dark Spell DMG applies multiplicatively to both the initial cast and every subsequent damage tick, elevating total damage by over 18% throughout a 5-turn boss rotation.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <h3 id="2-cleric-mage-super-class-s-tier-synergy" style="font-size: 1.1rem; color: #34d399; margin: 0 0 6px;">2. Cleric (Mage Super Class) — S Tier Synergy</h3>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              Clerics in 4-player Guild Raids burn mana rapidly to keep frontline tanks alive. Nightborn provides the bottomless mana reservoir required to chain AoE Divine Light cleanses without running dry during boss enrage phases.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #ea580c;">
            <h3 id="3-berserk-warrior-super-class-a-niche-synergy" style="font-size: 1.1rem; color: #ea580c; margin: 0 0 6px;">3. Berserk (Warrior Super Class) — A+ Niche Synergy</h3>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              While Nightborn is designed primarily for magic, Berserkers running low-HP setups capitalize intensely on Nightborn's 15% critical lifesteal, stabilizing their health buffer at 25% without ever dropping out of maximum attack multiplier range.
            </p>
          </div>
        </div>
      </section>

      
      <!-- Level 1 to 30 Milestone Scaling Table -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="nightborn-level-1-to-30-milestone-progression-ledger" style="font-size: 1.3rem; color: #fff; margin: 0 0 14px;">Nightborn Level 1 to 30 Milestone Progression Ledger</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Nightborn's passive bonuses scale exponentially as base class attributes increase. Here is the verified stat progression across seven key milestone levels, measured with standard Mage archetype scaling:
        </p>

        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
            <thead>
              <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                <th style="padding: 10px 12px;">Level Milestone</th>
                <th style="padding: 10px 12px;">Base HP</th>
                <th style="padding: 10px 12px;">Base MP</th>
                <th style="padding: 10px 12px;">MP Regen / Turn</th>
                <th style="padding: 10px 12px;">Dark Spell Amp</th>
                <th style="padding: 10px 12px;">Lifesteal on Crit</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 1 (Novice)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">75 HP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">60 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">+9 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">+8.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">15.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 5 (Apprentice)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">99 HP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">92 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">+14 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">+8.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">15.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 10 (Adept)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">129 HP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">132 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">+20 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">+8.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">15.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 15 (Super Class)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">159 HP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">172 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">+26 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">+8.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">15.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 20 (Master)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">189 HP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">212 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">+32 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">+8.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">15.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 25 (Ultra Class)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">219 HP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">252 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">+38 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">+8.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">15.0%</td>
              </tr>
              <tr>
                <td style="padding: 10px 12px; font-weight: 600; color: #a855f7;">Level 30 (Capstone)</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">249 HP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #38bdf8;">292 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">+44 MP</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #c9a227;">+8.0%</td>
                <td style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">15.0%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Boss Matchup Strategies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="dungeon-boss-tactical-matchup-ledger" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Dungeon Boss Tactical Matchup Ledger</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399; font-size: 1rem; display: block; margin-bottom: 6px;">Goblin King (Act 1)</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              <strong>Advantage: High.</strong> The Goblin King relies on heavy physical strikes but lacks curse resistance. A Nightborn Hexer can apply Tier-1 Shadow Decay on Turn 1; the +15% MP regen allows constant cast loops of Mana Barrier to negate all incoming cleaves.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #38bdf8;">
            <strong style="color: #38bdf8; font-size: 1rem; display: block; margin-bottom: 6px;">Crypt Necromancer (Act 2)</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              <strong>Advantage: Extreme.</strong> Nightborn innate dark affinity reduces incoming shadow damage from skeleton summons. Use multi-target Arcane Blast: the 15% critical lifesteal instantly refills any lost health while wiping minion waves.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e; font-size: 1rem; display: block; margin-bottom: 6px;">Abyssal Colossus (Act 3)</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              <strong>Advantage: Moderate.</strong> The Colossus has 20% True Damage on heavy slams that bypasses barrier defense. Maintain maximum distance, trigger Bloodthirst or lifesteal procs on every turn, and cycle crowd control spells to prevent enrage sweeps.
            </p>
          </div>
        </div>
      </section>

      <!-- Best-in-Slot Equipment Loadout -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="recommended-best-in-slot-equipment-synergies" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Recommended Best-in-Slot Equipment Synergies</h2>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #a855f7;">Weapon: Netherflame Focus or Void Scepter</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Grants +38 Magic ATK and +12% Spell Critical Strike chance. Stacks multiplicatively with Nightborn's +8% Dark Spell amplifier and critical lifesteal trigger conditions.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #38bdf8;">Armor Set: Shadowsilk Vestments (Tier 3 Dungeon Plate)</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Provides +48 DEF, +160 Max MP, and +15% Ailment Resist. Complements the Nightborn MP pool, ensuring your maximum mana buffer exceeds 450 MP by endgame.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #c9a227;">Accessory: Bloodstone Amulet of the Eclipse</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Elevates base lifesteal by an additional +5%, elevating total critical lifesteal to 20%. Allows full HP recovery from a single high-tier curse detonation.
            </p>
          </div>
        </div>
      </section>

      <!-- Talent Pairing Synergies & Traps -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="talent-pairing-synergies-anti-synergies" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Talent Pairing Synergies & Anti-Synergies</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399; font-size: 0.95rem;">Must-Pick: Arcane Spark + Bloodthirst</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 6px 0 0;">
              Arcane Spark provides +1 Starting Energy and +8% MAG, while Bloodthirst stacks an additional 12% lifesteal on top of Nightborn's innate 15%, producing an unstoppable 27% life-drain loop.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e; font-size: 0.95rem;">Trap Talent: Iron Soul</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 6px 0 0;">
              While +6% DEF sounds protective, Mage and Hexer base defenses are too low for percentage scaling to yield meaningful survivability. Investing in Survivor (cheat-death) or Keen Eye (crit rate) provides 3x higher combat value.
            </p>
          </div>
        </div>
      </section>

      
      <!-- Dungeon Exploration & Leveling Route SOP -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="nightborn-exploration-leveling-route-sop" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Nightborn Exploration & Leveling Route SOP</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          To accelerate your Nightborn character from Level 1 to the Level 30 cap while conserving gold and potions, follow this structured dungeon progression roadmap:
        </p>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399;">Early Game (Levels 1–10): Sunken Crypts & Goblin Caverns</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Exploit your +15% passive MP regeneration to cast spells on every single combat turn without drinking mana potions. Conserving early gold allows you to purchase Tier-1 Iron Gear from the Blacksmith immediately upon hitting Level 10.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #38bdf8;">
            <strong style="color: #38bdf8;">Mid Game (Levels 11–20): Act 2 The Dungeon & Trainer's Shrine</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Locate the Trainer's Shrine in Act 2 to awaken into Hexer or Cleric. With Nightborn's +8% Dark Spell amplifier active, cast Shadow Decay curses on entire monster rooms: the multi-target damage ticks wipe waves while refilling your mana pool automatically.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px; border-left: 3px solid #a855f7;">
            <strong style="color: #a855f7;">End Game (Levels 21–30): Torment Chambers & Guild Raids</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Equip Shadowsilk Vestments and the Bloodstone Amulet. Stack critical strike chance to trigger continuous 20%+ lifesteal. In 4-player Guild Raids, your infinite mana sustain ensures you can maintain continuous offensive curses without taxing the party healer.
            </p>
          </div>
        </div>
      </section>

      <!-- Multiplayer Combat Turn Rotation Blueprint -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="tactical-turn-by-turn-combat-rotation-blueprint" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Tactical Turn-by-Turn Combat Rotation Blueprint</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Maximize your party damage output and personal survival by executing this battle rotation during tough boss encounters:
        </p>

