---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);

const TITLE = "Slime Race in Pixel Lineage: Physical Resistance";
const DESC = "Slime in Pixel Lineage: 6.47% roll, resistance to physical attacks and extra healing after battle, but extra damage from Fire.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: TITLE,
    description: DESC,
    url: `${siteConfig.siteUrl}/races/slime/`,
    datePublished: "2026-11-10T12:00:00+00:00",
    dateModified: "2026-11-10T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Races", item: `${siteConfig.siteUrl}/races/` },
      { "@type": "ListItem", position: 3, name: "Slime", item: `${siteConfig.siteUrl}/races/slime/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What are the passive traits of the Slime race in Pixel Lineage?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The Slime race provides innate physical attack resistance and grants extra HP recovery after completing battles, balanced by taking increased damage from Fire attacks.",
        },
      },
      {
        "@type": "Question",
        name: "What is the roll chance for Slime in Pixel Lineage?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Slime is a Rare race with a 6.47% roll chance from the Goblin Merchant spin pool.",
        },
      },
      {
        "@type": "Question",
        name: "Where do you find the Slime Heirloom and Heartblood?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The Slime Heirloom for Stage 1 Kindled drops in Act 4 (Moonstone Rise) on Nightmare difficulty. The Slime Heartblood for Stage 2 Exalted drops in Act 10 (Heart of Blight).",
        },
      },
      {
        "@type": "Question",
        name: "Which classes pair well with the Slime race?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Slime fits well with melee frontliners like Warrior (Greatsword or Sentinel) and Fist fighters that routinely absorb physical hits during dungeon crawls.",
        },
      },
    ],
  },
];

const faqItems = [
  {
    question: "What are the passive traits of the Slime race in Pixel Lineage?",
    answer: "Slime provides innate physical damage reduction and bonus health recovery at the end of each encounter, but suffers from a vulnerability to Fire elemental damage."
  },
  {
    question: "What is the roll chance for Slime in Pixel Lineage?",
    answer: "Slime has a 6.47% drop probability in the Rare category at the town spin vendor."
  },
  {
    question: "Where do you find the Slime Heirloom and Heartblood?",
    answer: "The Slime Heirloom drops in Act 4 (Moonstone Rise) on Nightmare difficulty to reach Stage 1 Kindled. The Slime Heartblood drops in Act 10 (Heart of Blight) to reach Stage 2 Exalted."
  },
  {
    question: "Which classes pair well with the Slime race?",
    answer: "Slime fits well with tanky melee archetypes like Warrior and Fist, where physical damage resistance and post-battle health recovery minimize consumable usage."
  },
];
---

<BaseLayout title={TITLE} description={DESC} canonical="/races/slime/" jsonLd={jsonLd}>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
        <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
          <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
          <span class="separator" style="margin: 0 8px;">/</span>
          <a href="/races/" style="color: var(--accent); text-decoration: none;">Races</a>
          <span class="separator" style="margin: 0 8px;">/</span>
          <span class="current">Slime</span>
        </nav>

        <header style="margin-bottom: 32px;">
          <div style="display: inline-block; background: rgba(52, 211, 153, 0.15); border: 1px solid #34d399; color: #34d399; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
            Rare Bloodline · 6.47% Roll · Grade B
          </div>
          <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
            Pixel Lineage Slime Race &amp; Resistance Guide
          </h1>
          <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0 0 16px;">
            The Slime bloodline offers natural physical damage absorption and bonus post-battle healing, offset by a pronounced vulnerability to fire attacks.
          </p>

          <div style="background: rgba(168, 85, 247, 0.1); border-left: 4px solid var(--accent); padding: 14px 18px; border-radius: 0 8px 8px 0; margin-bottom: 24px;">
            <div style="font-size: 0.82rem; font-family: var(--font-mono); color: #c9a227; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">
              ⚡ Direct Answer
            </div>
            <p style="margin: 0; font-size: 0.94rem; color: #e8e2f2; line-height: 1.6;">
              <strong>Slime</strong> is a <strong>6.47% Rare race</strong>. It features <strong>physical damage resistance</strong> and <strong>bonus post-battle healing</strong>, but takes increased damage from Fire. Farm the <strong>Slime Heirloom in Act 4 (Moonstone Rise) on Nightmare</strong> for Stage 1 (Kindled), and the <strong>Heartblood in Act 10 (Heart of Blight)</strong> for Stage 2 (Exalted).
            </p>
          </div>
        </header>

        <MobileToc tocHeadings={tocHeadings} />

        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

        <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #34d399; border-radius: 8px; padding: 22px; margin-bottom: 32px;">
          <h2 id="innate-racial-trait-ledger" style="font-size: 1.25rem; color: #34d399; margin: 0 0 12px;">Innate Racial Trait Ledger</h2>
          <div style="overflow-x: auto;">
            <table class="responsive-card-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
              <thead>
                <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                  <th style="padding: 10px 12px;">Trait Name</th>
                  <th style="padding: 10px 12px;">Mechanic</th>
                  <th style="padding: 10px 12px;">Combat Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Trait" style="padding: 10px 12px; font-weight: 700; color: #fff;">Amorphous Body</td>
                  <td data-label="Mechanic" style="padding: 10px 12px; color: #34d399;">Physical Mitigation</td>
                  <td data-label="Description" style="padding: 10px 12px; color: var(--muted);">Reduces incoming damage from standard physical strikes and blunt attacks.</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Trait" style="padding: 10px 12px; font-weight: 700; color: #fff;">Gelatinous Recovery</td>
                  <td data-label="Mechanic" style="padding: 10px 12px; color: #34d399;">Post-Combat Sustain</td>
                  <td data-label="Description" style="padding: 10px 12px; color: var(--muted);">Restores an additional percentage of health after clearing a battle encounter.</td>
                </tr>
                <tr>
                  <td data-label="Trait" style="padding: 10px 12px; font-weight: 700; color: #f43f5e;">Flammable Core</td>
                  <td data-label="Mechanic" style="padding: 10px 12px; color: #f43f5e;">Elemental Weakness</td>
                  <td data-label="Description" style="padding: 10px 12px; color: var(--muted);">Takes increased damage from Fire attacks and Burning debuffs.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p style="color: var(--muted); font-size: 0.88rem; margin: 14px 0 0;">
            Compare defensive profiles on the <a href="/races/best-races/" style="color: var(--accent); text-decoration: none;">best races guide</a>.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="how-to-obtain-spin-odds" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">How to Obtain — Spin Odds</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            Slime is obtained through the standard Race Spin wheel at a 6.47% roll probability in the Rare tier.
          </p>
          <p style="color: var(--muted); font-size: 0.88rem; margin: 0;">
            Grab spin currency using active <a href="/codes/" style="color: var(--accent); text-decoration: none;">Pixel Lineage codes</a>.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #c9a227; border-radius: 8px; padding: 22px; margin-bottom: 32px;">
          <h2 id="race-evolution-heirloom-and-heartblood" style="font-size: 1.25rem; color: #c9a227; margin: 0 0 12px;">Race Evolution: Heirloom &amp; Heartblood Locations</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            Slime evolution requires an <strong>Heirloom for Kindled (Stage 1)</strong> and a <strong>Heartblood for Exalted (Stage 2)</strong>:
          </p>
          <div style="overflow-x: auto;">
            <table class="responsive-card-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
              <thead>
                <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                  <th style="padding: 10px 12px;">Evolution Tier</th>
                  <th style="padding: 10px 12px;">Required Drop</th>
                  <th style="padding: 10px 12px;">Target Act &amp; Difficulty</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--line);">
                  <td data-label="Tier" style="padding: 10px 12px; font-weight: 700; color: #f5f3ff;">Stage 1: Kindled</td>
                  <td data-label="Item" style="padding: 10px 12px; color: #c9a227;">Slime Heirloom</td>
                  <td data-label="Location" style="padding: 10px 12px; color: var(--muted);">Act 4 (Moonstone Rise) on Nightmare difficulty</td>
                </tr>
                <tr>
                  <td data-label="Tier" style="padding: 10px 12px; font-weight: 700; color: #f5f3ff;">Stage 2: Exalted</td>
                  <td data-label="Item" style="padding: 10px 12px; color: #f43f5e;">Slime Heartblood</td>
                  <td data-label="Location" style="padding: 10px 12px; color: var(--muted);">Act 10 (Heart of Blight)</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p style="color: var(--muted); font-size: 0.88rem; margin: 12px 0 0;">
            See all 14 bloodlines on the <a href="/races/evolution/" style="color: var(--accent); text-decoration: none;">Heirloom &amp; Heartblood locations guide</a>.
          </p>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="best-class-synergies" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">Best Class Synergies</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 12px;">
            Slime fits well with physical frontliners:
          </p>
          <ul style="color: var(--muted); font-size: 0.92rem; padding-left: 20px; margin: 0;">
            <li><strong><a href="/classes/warrior/" style="color: var(--accent); text-decoration: none;">Warrior</a> (Sentinel / Greatsword)</strong>: Stacks physical armor to shrug off regular dungeon mobs.</li>
            <li><strong>Fist (Brawler / Monk)</strong>: Sustains through close-range brawls and recovers health between rooms.</li>
          </ul>
        </section>

        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 32px;">
          <h2 id="talent-and-gear-priority" style="font-size: 1.3rem; color: #fff; margin: 0 0 12px;">Talent &amp; Gear Priority</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
            Prioritize fire resistance enchants and rings to patch the innate elemental vulnerability, alongside defense scaling.
          </p>
        </section>

        <FaqSection items={faqItems} />

        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 24px;">
          <a href="/races/evolution/" style="background: #a855f7; color: #fff; padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
            Heirloom &amp; Heartblood Locations →
          </a>
          <a href="/races/best-races/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
            Best Races &amp; Spin Meta →
          </a>
        </div>

        <div class="ad-slot-footer">
          <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
          <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
        </div>
      </article>

      <DualSidebar tocHeadings={tocHeadings} currentUrl="/races/slime/" />
    </div>
  </div>
</BaseLayout>
