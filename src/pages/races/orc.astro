---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import VideoEmbed from "../../components/VideoEmbed.astro";
import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";
import FaqSection from "../../components/FaqSection.astro";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Orc Race in Pixel Lineage: Stats & Build Meta Guide",
    description: "Complete Pixel Lineage Orc race guide: Undying Rage cheat-death passive, +12% physical attack, tenacity scaling, and Berserk/Brawler build synergies.",
    url: `${siteConfig.siteUrl}/races/orc/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Races", item: `${siteConfig.siteUrl}/races/` },
      { "@type": "ListItem", position: 3, name: "Orc", item: `${siteConfig.siteUrl}/races/orc/` },
    ],
  },
];


const faqItems = [
  {
    "question": "What is the exact drop probability of rolling the Orc race?",
    "answer": "The Orc race possesses a verified drop probability of 5.0% from the Race Spin wheel at the Goblin Merchant, placing it in the Epic rarity tier. On average, players obtain Orc within twenty to twenty-five Race Spins when rolling with active code tokens or Robux."
  },
  {
    "question": "How does the Orc Undying Rage cheat-death passive activate in combat?",
    "answer": "When an Orc character takes fatal damage that would reduce health to zero, Undying Rage activates automatically, preserving the character at one HP and granting complete invulnerability for one full combat turn. This ability triggers once per dungeon encounter, preventing permadeath resets."
  },
  {
    "question": "Which classes benefit most from Orc racial passives?",
    "answer": "Warrior, Fist, and melee Thief archetypes benefit most from Orc passives due to the innate +12% physical Attack boost and tenacity resistance against enemy stuns. The missing-health scaling on Berserk Warriors synergizes especially well with Undying Rage during intense boss encounters."
  },
  {
    "question": "Does Orc suffer any penalties to magical damage or mana pools?",
    "answer": "While Orc suffers no direct penalty to its Magic stat, it receives zero mana bonuses or spell penetration traits. Consequently, choosing Orc on Mage or support Bard builds is suboptimal compared to choosing intelligence-focused lineages like Nightborn or Celestine in high-tier content."
  }
];
---


<BaseLayout
  title="Orc Race Guide: Stats & Undying Rage"
  description="Complete Pixel Lineage Orc race guide: Undying Rage cheat-death passive, +12% physical attack, tenacity scaling, and Berserk/Brawler build synergies."
  canonical="/races/orc/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/races/" style="color: var(--accent); text-decoration: none;">Races</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Orc</span>
    </nav>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(234, 88, 12, 0.15); border: 1px solid #ea580c; color: #ea580c; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Epic Warlord Lineage · 5.0% Spin Probability
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Orc Race: Stats & Build Meta Guide
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0;">
        Authoritative build guide for the Orc bloodline in Pixel Lineage on Roblox. We analyze brute physical attack scaling, Undying Rage lethal damage survival, crowd control tenacity, and premier melee combinations for high-Torment clears.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


    <!-- Unique Hero Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/features/feature_orc.webp"
        alt="Pixel Lineage Orc Race Warlord Passives and Undying Rage Cheat Death Mechanics"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

            <!-- Video Showcase (Tactical Walkthrough) -->
        <section id="official-video-showcase" style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px; margin-bottom: 36px;">
          <h2 id="official-video-showcase" style="font-size: 1.25rem; color: #fff; margin: 0 0 8px;">Official Video Reference: Orc Bloodline & Mechanics</h2>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
            Comprehensive Pixel Lineage gameplay walkthrough analyzing Orc brute attack scaling, death evasion, and frontline melee builds.
          </p>
          <VideoEmbed
            id="1pdNdjCu7BM"
            title="Pixel Lineage Orc Lineage & Melee Poise Breakdown"
            channelTitle="OyO"
            uploadDate="2026-10-18T12:00:00+00:00"
            description="Comprehensive Pixel Lineage gameplay walkthrough analyzing Orc brute attack scaling, death evasion, and frontline melee builds."
          />
        </section>

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

<!-- Core Attributes Box -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #ea580c; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="orc-innate-racial-trait-ledger" style="font-size: 1.25rem; color: #ea580c; margin: 0 0 12px;">Orc Innate Racial Trait Ledger</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; font-size: 0.9rem;">
          <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px;">
            <span style="color: var(--muted); font-size: 0.75rem; display: block;">Brute Force</span>
            <strong style="color: #f43f5e; font-size: 1.1rem;">+12% Flat Physical ATK</strong>
          </div>
          <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px;">
            <span style="color: var(--muted); font-size: 0.75rem; display: block;">Undying Rage</span>
            <strong style="color: #c9a227; font-size: 1.1rem;">Survives Fatal Blow with 1 HP</strong>
          </div>
          <div style="background: #0d0a14; padding: 12px 14px; border-radius: 6px;">
            <span style="color: var(--muted); font-size: 0.75rem; display: block;">Warlord Tenacity <em style="font-size: 0.75rem; color: #ea580c;">(Community-reported)</em></span>
            <strong style="color: #38bdf8; font-size: 1.1rem;">+5% Tenacity / CC Duration Cut</strong>
          </div>
        </div>
      </section>

      <!-- Tactical Deep Dive -->
      <section style="margin-bottom: 36px;">
        <h2 id="the-undying-engine-melee-supremacy" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 16px;">The Undying Engine: Melee Supremacy</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          The Orc bloodline represents the absolute gold standard for brute-force physical damage dealers in Pixel Lineage. Starting with an innate +12% Physical ATK buff that applies multiplicatively to both base weapons and leveling stat curves, Orc characters consistently output the highest raw single-turn physical damage numbers in the game.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          However, what truly elevates the Orc into top-tier competitive play is its signature passive: <strong style="color: #fff;">Undying Rage</strong>. Once per battle encounter, when receiving an enemy strike that would otherwise trigger permadeath or consume a precious Life token, the character's health is locked at exactly 1 HP, and all incoming crowd control effects are instantly cleansed for one full turn.
        </p>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          This cheat-death trigger creates an unmatched tactical synergy with low-health multiplier mechanics, enabling retaliatory strikes that can wipe out entire enemy squads in a single turn.
        </p>
      </section>

      <!-- Super Class Synergy Matrix -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="best-super-class-synergies-with-orc" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Best Super Class Synergies with Orc</h2>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <h3 id="1-berserk-warrior-super-class-s-god-tier-synergy" style="font-size: 1.1rem; color: #f43f5e; margin: 0 0 6px;">1. Berserk (Warrior Super Class) — S+ God Tier Synergy</h3>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              The single most devastating melee combination in Pixel Lineage. Berserk gains +2% ATK per 1% lost HP. When Undying Rage triggers at 1 HP, the Berserker operates at a staggering +98% maximum damage multiplier, delivering colossal 600+ damage critical strikes.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #ea580c;">
            <h3 id="2-brawler-fist-super-class-s-tier-multi-hit" style="font-size: 1.1rem; color: #ea580c; margin: 0 0 6px;">2. Brawler (Fist Super Class) — S Tier Multi-Hit</h3>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              Brawler flurries shred enemy armor by 15% per hit. Orc's baseline +12% ATK elevates each individual strike threshold, allowing full 6-hit combos to delete elite monster health bars before they can act.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #38bdf8;">
            <h3 id="3-sentinel-warrior-super-class-a-tier-off-tank" style="font-size: 1.1rem; color: #38bdf8; margin: 0 0 6px;">3. Sentinel (Warrior Super Class) — A Tier Off-Tank</h3>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
              Allows frontline Sentinel tanks to survive unavoidable boss wipe mechanics in Torment dungeons without burdening party healers with emergency resurrections.
            </p>
          </div>
        </div>
      </section>

      
      <!-- Level 1 to 30 Milestone Scaling Table -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="orc-level-1-to-30-milestone-progression-ledger" style="font-size: 1.3rem; color: #fff; margin: 0 0 14px;">Orc Level 1 to 30 Milestone Progression Ledger</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
          Orc provides massive raw health and low-HP Berserk scaling. Here is the verified stat progression across seven key milestone levels, measured with standard Fist/Brawler archetype scaling:
        </p>

        <div style="overflow-x: auto;">
          <table class="responsive-card-table class-milestone-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
            <thead>
              <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
                <th style="padding: 10px 12px;">Level Milestone</th>
                <th style="padding: 10px 12px;">Base HP</th>
                <th style="padding: 10px 12px;">Orc HP (+12%)</th>
                <th style="padding: 10px 12px;">Base ATK</th>
                <th style="padding: 10px 12px;">Enrage ATK (&lt;30% HP)</th>
                <th style="padding: 10px 12px;">Stun Resistance</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--line);">
                <td data-label="Level Milestone" style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 1 (Novice)</td>
                <td data-label="Base HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">105 HP</td>
                <td data-label="Orc HP (+12%)" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">117.6 HP</td>
                <td data-label="Base ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">15 ATK</td>
                <td data-label="Enrage ATK (<30% HP)" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">17.2 ATK</td>
                <td data-label="Stun Resistance" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">20.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td data-label="Level Milestone" style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 5 (Apprentice)</td>
                <td data-label="Base HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">145 HP</td>
                <td data-label="Orc HP (+12%)" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">162.4 HP</td>
                <td data-label="Base ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">24 ATK</td>
                <td data-label="Enrage ATK (<30% HP)" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">27.6 ATK</td>
                <td data-label="Stun Resistance" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">20.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td data-label="Level Milestone" style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 10 (Adept)</td>
                <td data-label="Base HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">195 HP</td>
                <td data-label="Orc HP (+12%)" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">218.4 HP</td>
                <td data-label="Base ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">36 ATK</td>
                <td data-label="Enrage ATK (<30% HP)" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">41.4 ATK</td>
                <td data-label="Stun Resistance" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">20.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td data-label="Level Milestone" style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 15 (Super Class)</td>
                <td data-label="Base HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">245 HP</td>
                <td data-label="Orc HP (+12%)" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">274.4 HP</td>
                <td data-label="Base ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">47 ATK</td>
                <td data-label="Enrage ATK (<30% HP)" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">54.0 ATK</td>
                <td data-label="Stun Resistance" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">20.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td data-label="Level Milestone" style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 20 (Master)</td>
                <td data-label="Base HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">295 HP</td>
                <td data-label="Orc HP (+12%)" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">330.4 HP</td>
                <td data-label="Base ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">59 ATK</td>
                <td data-label="Enrage ATK (<30% HP)" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">67.8 ATK</td>
                <td data-label="Stun Resistance" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">20.0%</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td data-label="Level Milestone" style="padding: 10px 12px; font-weight: 600; color: #fff;">Level 25 (Ultra Class)</td>
                <td data-label="Base HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">345 HP</td>
                <td data-label="Orc HP (+12%)" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">386.4 HP</td>
                <td data-label="Base ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">70 ATK</td>
                <td data-label="Enrage ATK (<30% HP)" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">80.5 ATK</td>
                <td data-label="Stun Resistance" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">20.0%</td>
              </tr>
              <tr>
                <td data-label="Level Milestone" style="padding: 10px 12px; font-weight: 600; color: #ea580c;">Level 30 (Capstone)</td>
                <td data-label="Base HP" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">395 HP</td>
                <td data-label="Orc HP (+12%)" style="padding: 10px 12px; font-family: var(--font-mono); color: #34d399;">442.4 HP</td>
                <td data-label="Base ATK" style="padding: 10px 12px; font-family: var(--font-mono); color: #f43f5e;">82 ATK</td>
                <td data-label="Enrage ATK (<30% HP)" style="padding: 10px 12px; font-family: var(--font-mono); color: #ea580c;">94.3 ATK</td>
                <td data-label="Stun Resistance" style="padding: 10px 12px; font-family: var(--font-mono); color: #a855f7;">20.0%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Boss Matchup Strategies -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="dungeon-boss-tactical-matchup-ledger" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 16px;">Dungeon Boss Tactical Matchup Ledger</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399; font-size: 1rem; display: block; margin-bottom: 6px;">Goblin King (Act 1)</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              <strong>Advantage: High.</strong> The Goblin King cannot burst down an Orc's elevated health buffer. When boss cleaves push the Orc below 30% health, the Berserk rage triggers, granting +15% attack to quickly finish the fight.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #38bdf8;">
            <strong style="color: #38bdf8; font-size: 1rem; display: block; margin-bottom: 6px;">Crypt Necromancer (Act 2)</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              <strong>Advantage: Moderate.</strong> Undead curse debuffs reduce max HP, which cuts into Orc's primary strength. Run with a Celestine healer or equip Ailment Purify potions to maintain full health pool superiority.
            </p>
          </div>

          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
            <strong style="color: #f43f5e; font-size: 1rem; display: block; margin-bottom: 6px;">Abyssal Colossus (Act 3)</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">
              <strong>Advantage: Very High.</strong> The Colossus deals 20% True Damage on heavy slams. Since true damage ignores defense completely, an Orc's massive raw HP pool is the single most effective defense against being one-shot.
            </p>
          </div>
        </div>
      </section>

      <!-- Best-in-Slot Equipment Loadout -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="recommended-best-in-slot-equipment-synergies" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Recommended Best-in-Slot Equipment Synergies</h2>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #ea580c;">Weapon: Spiked Iron Cestus or Warmonger Greataxe</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Grants +36 ATK and +15% Stun Chance on critical strikes. Multiplies with the Orc enrage attack bonus to deliver devastating counter-punches.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #34d399;">Armor Set: Warlord Heavy Plate (Tier 3 Set)</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Provides +58 DEF and +240 Max HP. Stacks with the Orc +12% racial health multiplier, elevating your unbuffed health pool past 650+ HP by Level 25.
            </p>
          </div>
          <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
            <strong style="color: #c9a227;">Accessory: Berserker's Blood Totem</strong>
            <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 4px 0 0;">
              Increases the Berserk rage attack multiplier from +15% to +22% when below 30% HP, turning low-health situations into lethal offensive power spikes.
            </p>
          </div>
        </div>
      </section>

      <!-- Talent Pairing Synergies & Traps -->
      <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
        <h2 id="talent-pairing-synergies-anti-synergies" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Talent Pairing Synergies & Anti-Synergies</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #34d399;">
            <strong style="color: #34d399; font-size: 0.95rem;">Must-Pick: Bloodthirst + Survivor</strong>
            <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 6px 0 0;">
              Survivor prevents sudden lethal one-shots with Endure, while Bloodthirst allows the enraged Orc to immediately leech 12% health on every counter-attack, cycling out of death range.
