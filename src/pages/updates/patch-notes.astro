---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";

const patches = [
  {
    version: "Update 3 — Trials & Dawn Update (November 07, 2026)",
    releaseDate: "November 07, 2026",
    summary: "Official Dawn Update deployment introducing dungeon Trials, balance hotfixes, and experience rebranding to 'Pixel Lineage [Dawn Update]'.",
    highlights: [
      "Official experience updated to Pixel Lineage [Dawn Update] with active player baseline reaching 1,104 concurrent users.",
      "Total experience visits surpassed 26.79M with over 102k community favorites and 98.9% upvote rating.",
      "Dungeon Trials and encounter balancing rolled out across Act 1 and Act 2 roguelike runs.",
      "Redemption buffer verified at the Goblin Merchant with active code phrase 'OCTOBER'.",
    ],
  },
  {
    version: "Update (Spear Class + Dragon Race)",
    releaseDate: "October 20, 2026",
    summary: "Major weekly content drop updating experience title to 'Pixel Lineage [🎃Spear Class + Dragon Race]' with the 7th base archetype and Dragon lineage.",
    highlights: [
      "Added Spear class as the 7th playable base archetype alongside Warrior, Thief, Mage, Fist, Bard, and Archer.",
      "Introduced Dragon Race to the character lineage reroll table.",
      "Total experience visits surpassed 13.6M with over 102k player favorites.",
      "Mechanical stat growths and trait formulas pending live game verification.",
    ],
  },
  {
    version: "Halloween & Race Evo Update (October 13, 2026)",
    releaseDate: "October 13, 2026",
    summary: "Major seasonal update adding the Dullahan race, Halloween candy event currency, and dungeon evolution balance adjustments.",
    highlights: [
      "Added limited-time Dullahan headless race with poise immunity to the event spin pool.",
      "Introduced Halloween Candies redeemable for exclusive pumpkin vanity cosmetics and temporary race spin tokens.",
      "Buffed Berserk missing-HP scaling from +1.5% to +2.0% ATK per 1% lost health.",
      "Fixed Goblin Merchant code redemption validation caching delays.",
    ],
  },
  {
    version: "Dungeons & Guild Raids Update (October 06, 2026)",
    releaseDate: "October 06, 2026",
    summary: "Introduced 4-player cooperative Guild Raids, the Shadow Gate encounter, and Act 3 Torment difficulty scaling.",
    highlights: [
      "Launched the Guild Castle and Altar oath binding systems.",
      "Added the Ultra Sigil drop table to Torment II and Pinnacle Raid bosses.",
      "Normalized Thief dodge probability hard cap to 65.0% to prevent infinite immunity.",
      "Updated server promo code validation for seasonal event.",
    ],
  },
  {
    version: "Balance & Hotfix Update (September 30, 2026)",
    releaseDate: "September 30, 2026",
    summary: "Turn initiative timing fixes, server crash prevention, and starter class balancing.",
    highlights: [
      "Adjusted Mage base MAG scaling from +2.5 to +2.8 per level to reward glass-cannon playstyles.",
      "Resolved turn-order freezing when two players tied for exact Speed ticks.",
      "Fixed Auction House listing fees and item duplication exploits.",
    ],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Pixel Lineage Patch Notes: Weekly Updates & Changes",
    description: "Complete Pixel Lineage patch notes archive: weekly updates, Halloween race additions, class balance changes, and bug fixes directly from official logs.",
    url: `${siteConfig.siteUrl}/updates/patch-notes/`,
    datePublished: "2026-10-18T12:00:00+00:00",
    publisher: {
      "@type": "Organization",
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Updates", item: `${siteConfig.siteUrl}/updates/` },
      { "@type": "ListItem", position: 3, name: "Patch Notes", item: `${siteConfig.siteUrl}/updates/patch-notes/` },
    ],
  },
];

import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);
---


<BaseLayout
  title="Pixel Lineage Dawn Update: Patch Notes & Log"
  description="Complete Pixel Lineage Dawn Update patch notes archive: Update 3 Trials, Spear class additions, balance changes, and bug fixes from official Roblox logs."
  canonical="/updates/patch-notes/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <a href="/updates/" style="color: var(--accent); text-decoration: none;">Updates</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Patch Notes</span>
    </nav>

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(52, 211, 153, 0.15); border: 1px solid #34d399; color: #34d399; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Official Development Log & Update Archive
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Dawn Update: Patch Notes & Log
      </h1>
      <p style="color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0 0 16px;">
        Chronological archive of all balance updates, content expansions, and hotfixes for Pixel Lineage on Roblox. We track weekly developer commitments, class buff/nerf formulas, and event announcements.
      </p>

      <!-- Direct Answer Summary Box for Dawn Update -->
      <div style="background: rgba(52, 211, 153, 0.1); border-left: 4px solid #34d399; padding: 14px 18px; border-radius: 0 8px 8px 0; margin-bottom: 8px;">
        <div style="font-size: 0.82rem; font-family: var(--font-mono); color: #34d399; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">
          ⚡ Direct Answer · Dawn Update & Patch Notes Overview
        </div>
        <p style="margin: 0 0 8px; font-size: 0.94rem; color: #f0eaf4; line-height: 1.6;">
          <strong>Pixel Lineage Dawn Update (Update 3: Trials)</strong> is the latest official content release on Roblox. It introduces dungeon encounter Trials, balance adjustments for late-game acts, and server stability improvements.
        </p>
        <p style="margin: 0; font-size: 0.88rem; color: var(--muted); line-height: 1.5;">
          <strong>Live Experience Status:</strong> The experience has reached over 26.79M total visits and 1,104 concurrent players. Active codes like <em>OCTOBER</em> remain redeemable at the Goblin Merchant after liking and joining the official Roblox group.
        </p>
      </div>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />


    <!-- Unique Hero Banner -->
    <div style="margin-bottom: 36px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
      <img
        src="/images/features/feature_patches.webp"
        alt="Pixel Lineage Patch Notes Weekly Developer Updates and Balance Changes"
        width="1200"
        height="675"
        style="width: 100%; height: auto; display: block;"
        loading="eager"
      />
    </div>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">
      <!-- Summary Callout -->
      <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #34d399; border-radius: 8px; padding: 22px; margin-bottom: 36px;">
        <h2 id="developer-commitment-weekly-content-cycles" style="font-size: 1.25rem; color: #34d399; margin: 0 0 12px;">Developer Commitment: Weekly Content Cycles</h2>
        <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
          The official development team maintains an explicit commitment: <em>"Game will be updated weekly. This is a fast turn-based roguelike RPG game, it is not meant to be easy."</em> Every Tuesday evening, server restarts deploy balance adjustments and refresh active promotional code buffers.
        </p>
      </section>

      <!-- Patches Master Timeline -->
      <section style="margin-bottom: 40px;">
        <h2 id="complete-version-history-change-logs" style="font-size: 1.4rem; color: var(--ink); margin: 0 0 20px;">Complete Version History & Change Logs</h2>
        <div style="display: flex; flex-direction: column; gap: 24px;">
          {patches.map((p) => (
            <div style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 22px;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
                <h3 id="p-version" style="font-size: 1.25rem; color: #fff; margin: 0;">{p.version}</h3>
                <span style="font-size: 0.8rem; background: #0d0a14; color: #c9a227; padding: 3px 10px; border-radius: 4px; border: 1px solid var(--line);">
                  Released: {p.releaseDate}
                </span>
              </div>

              <p style="color: var(--muted); font-size: 0.92rem; line-height: 1.5; margin: 0 0 14px;">
                {p.summary}
              </p>

              <div style="background: #0d0a14; padding: 14px 16px; border-radius: 6px;">
                <strong style="color: #38bdf8; display: block; margin-bottom: 6px; font-size: 0.88rem;">Key Patch Highlights:</strong>
                <ul style="color: var(--muted); font-size: 0.86rem; line-height: 1.6; padding-left: 18px; margin: 0;">
                  {p.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            </div>

        <!-- 广告位 1（300x250）：高停留内容锚点后置投放 —— 速查/视频之后、正文之前
             对标 invokyr.wiki src/pages/guide/[slug].astro:441 -->
        <AdSlot zone="banner-300x250" label="Sponsored Intel" />
          ))}
        </div>
      </section>

      <!-- Navigation -->
      <section style="background: #0d0a14; border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
        <h3 id="explore-further-game-resources" style="font-size: 1.1rem; color: #fff; margin: 0 0 10px;">Explore Further Game Resources</h3>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="/codes/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → Active Promo Codes Ledger
          </a>
          <a href="/races/dullahan/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → Halloween Dullahan Race Guide
          </a>
          <a href="/classes/super-classes/" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
            → 18 Super Class Evolution Tree
          </a>
        </div>
      </section>
          <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/updates/patch-notes/" />
    </div>
  </div>
</BaseLayout>
