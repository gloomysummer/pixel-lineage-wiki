---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";

const updates = [
  {
    version: "Weekly Update (October 20, 2026)",
    title: "Spear Class + Dragon Race Added",
    changes: [
      "Roblox experience title updated from 'Pixel Lineage [DUNGEONS+ HOLLOWEEN+RACE EVO]' to 'Pixel Lineage [🎃Spear Class + Dragon Race]'.",
      "Confirmed via official Roblox Games API (Universe ID: 10767928510) on 2026-10-20.",
      "New 7th base archetype 'Spear' introduced to character creation selection.",
      "New playable lineage 'Dragon Race' added to character reroll pool.",
      "Full skill data for the Spear class and the Dragon race passive is not yet documented; this entry will be expanded once verified.",
    ],
  },
  {
    version: "v1.3.0 (October 13, 2026)",
    title: "DUNGEONS+ HOLLOWEEN+RACE EVO",
    changes: [
      "Added limited-time Halloween Event dungeon with Candy currency drops.",
      "Introduced Race Evolution system: enhanced passives for Nightborn and Draconic.",
      "Rebalanced Hexer Malediction DoT scaling from 60% down to 50% for boss balance.",
      "Fixed Goblin Merchant dialogue bug causing code redemption freezing on mobile.",
      "Released promo code 'OCTOBER' granting 25 Halloween Candy event tokens.",
    ],
  },
  {
    version: "v1.2.0 (October 06, 2026)",
    title: "Trainer's Shrine & Super Classes Launch",
    changes: [
      "Implemented Trainer's Shrine in Act 2 The Dungeon for 18 Super Class evolutions.",
      "Added Ultra Sigil awakening trial for Level 25+ characters.",
      "Introduced Castle restoration system with initial Great Hall rebuild goal.",
      "Performance optimizations for turn-based battle particle animations.",
    ],
  },
  {
    version: "v1.0.0 (September 25, 2026)",
    title: "Official Public Launch",
    changes: [
      "Initial launch of Pixel Lineage on Roblox with 6 base classes.",
      "Act 1 The Sunken Ruins and Act 2 The Catacombs open for exploration.",
      "Turn-based combat engine, poise breaks, and elemental magic systems live.",
    ],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Pixel Lineage Weekly Updates & Patch Notes",
    description: "Official weekly changelog, Halloween event notes, and balance patches for Pixel Lineage on Roblox.",
    url: `${siteConfig.siteUrl}/updates/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Updates", item: `${siteConfig.siteUrl}/updates/` },
    ],
  },
];

import MobileToc from "../../components/MobileToc.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import { extractTocFromAstroUrl } from "../../utils/toc";

const tocHeadings = extractTocFromAstroUrl(import.meta.url);
---


<BaseLayout
  title="Pixel Lineage Updates: Patch Notes & Events"
  description="Complete Pixel Lineage weekly update log: Halloween event notes, Race Evolution balances, dungeon expansion changelogs, and developer promises on Roblox."
  canonical="/updates/"
  jsonLd={jsonLd}
>
  <div class="container container-guide" style="margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.85rem; color: var(--muted);">
      <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
      <span class="separator" style="margin: 0 8px;">/</span>
      <span class="current">Updates</span>
    </nav>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main" style="line-height: 1.7; color: var(--ink);">

    <header style="margin-bottom: 32px;">
      <div style="display: inline-block; background: rgba(99, 102, 241, 0.15); border: 1px solid #6366f1; color: #6366f1; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 12px;">
        Developer Changelog · Weekly Cadence
      </div>
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--ink); margin: 0 0 12px;">
        Pixel Lineage Weekly Updates & Notes
      </h1>
      <p style="color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0;">
        The developers of Pixel Lineage have officially committed to a strict weekly update cycle. Track all patch notes, class adjustments, and seasonal event features here.
      </p>
    </header>

        <!-- Mobile Table of Contents (≤980px) -->
        <MobileToc tocHeadings={tocHeadings} />

        <AdSlot zone="banner-300x250" label="Sponsored Intel" />

    <!-- Developer Commitment Box -->
    <section style="background: #161022; border: 1px solid var(--line); border-left: 4px solid #6366f1; border-radius: 8px; padding: 20px; margin-bottom: 36px;">
      <h2 id="official-developer-statement" style="margin: 0 0 8px; font-size: 1.15rem; color: #c9a227;">Official Developer Statement</h2>
      <blockquote style="margin: 0; color: #e5e0f0; font-size: 0.92rem; font-style: italic; line-height: 1.6;">
        "Inspired by a lot of games, mostly terraria, but enjoy. Game will be updated weekly. This is a fast turn-based roguelike RPG game, it is not meant to be easy."
      </blockquote>
      <p style="color: var(--muted); font-size: 0.8rem; margin: 8px 0 0;">
        Source: Official Roblox experience description (Universe ID <code>10767928510</code>).
      </p>
    </section>

    <!-- Updates Timeline -->
    <div style="display: flex; flex-direction: column; gap: 28px; margin-bottom: 40px;">
      {updates.map((u) => (
        <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px;">
          <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
            <span style="font-size: 0.82rem; font-family: var(--font-mono); color: #34d399; background: rgba(52, 211, 153, 0.15); padding: 2px 8px; border-radius: 4px; font-weight: 700;">
              {u.version}
            </span>
            <h2 id="u-title" style="margin: 0; font-size: 1.25rem; color: var(--ink);">{u.title}</h2>
          </div>
          <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 0;">
            {u.changes.map((ch) => (
              <li style="margin-bottom: 6px;">{ch}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <!-- Complete Version History Ledger Table -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
      <h2 id="historical-version-patch-balance-ledger" style="font-size: 1.3rem; color: #fff; margin: 0 0 14px;">Historical Version & Patch Balance Ledger</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
        Track how combat numbers, class traits, and game systems have evolved across all server updates since launch:
      </p>

      <div style="overflow-x: auto;">
        <table class="responsive-card-table class-milestone-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
          <thead>
            <tr style="background: #0d0a14; border-bottom: 2px solid var(--line); color: #c9a227;">
              <th style="padding: 10px 12px;">Build Version</th>
              <th style="padding: 10px 12px;">Release Date</th>
              <th style="padding: 10px 12px;">Primary Theme</th>
              <th style="padding: 10px 12px;">Major System Additions</th>
              <th style="padding: 10px 12px;">Key Balance Changes</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--line);">
              <td data-label="Build Version" style="padding: 10px 12px; font-weight: 700; color: #34d399;">v1.3.0</td>
              <td data-label="Release Date" style="padding: 10px 12px; color: var(--muted);">2026-10-13</td>
              <td data-label="Primary Theme" style="padding: 10px 12px; color: #a855f7;">Halloween Event & Race Evo</td>
              <td data-label="Major System Additions" style="padding: 10px 12px; color: var(--ink);">Dullahan race, Candy currency, Pumpkin dungeon</td>
              <td data-label="Key Balance Changes" style="padding: 10px 12px; color: var(--muted);">Hexer decay reduced 60%→50%; Nightborn lifesteal buffed</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td data-label="Build Version" style="padding: 10px 12px; font-weight: 700; color: #38bdf8;">v1.2.0</td>
              <td data-label="Release Date" style="padding: 10px 12px; color: var(--muted);">2026-10-06</td>
              <td data-label="Primary Theme" style="padding: 10px 12px; color: #38bdf8;">Trainer's Shrine & Super Classes</td>
              <td data-label="Major System Additions" style="padding: 10px 12px; color: var(--ink);">18 Super Classes, Ultra Sigil awakening trial</td>
              <td data-label="Key Balance Changes" style="padding: 10px 12px; color: var(--muted);">Warrior base DEF +2; Thief starting SPD boosted to 16</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td data-label="Build Version" style="padding: 10px 12px; font-weight: 700; color: #ea580c;">v1.1.0</td>
              <td data-label="Release Date" style="padding: 10px 12px; color: var(--muted);">2026-09-30</td>
              <td data-label="Primary Theme" style="padding: 10px 12px; color: #ea580c;">Castle & Economy Expansion</td>
              <td data-label="Major System Additions" style="padding: 10px 12px; color: var(--ink);">Town Castle restoration, Auction House trading</td>
              <td data-label="Key Balance Changes" style="padding: 10px 12px; color: var(--muted);">Gold drop rates increased +20% across Act 1 and Act 2</td>
            </tr>
            <tr>
              <td data-label="Build Version" style="padding: 10px 12px; font-weight: 700; color: #c9a227;">v1.0.0</td>
              <td data-label="Release Date" style="padding: 10px 12px; color: var(--muted);">2026-09-25</td>
              <td data-label="Primary Theme" style="padding: 10px 12px; color: #c9a227;">Official Public Launch</td>
              <td data-label="Major System Additions" style="padding: 10px 12px; color: var(--ink);">6 base classes, Act 1 & 2 dungeons, turn combat</td>
              <td data-label="Key Balance Changes" style="padding: 10px 12px; color: var(--muted);">Initial launch calibration; poise break formulas enabled</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Development Roadmap & Weekly Cadence Analysis -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
      <h2 id="development-roadmap-weekly-cycle-expectations" style="font-size: 1.3rem; color: #c9a227; margin: 0 0 14px;">Development Roadmap & Weekly Cycle Expectations</h2>
      <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px;">
        Pixel Lineage updates are pushed on a weekly Tuesday cadence. Because the lead developer prioritizes fast turn-based roguelike mechanics inspired by Terraria, players should expect:
      </p>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
        <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #34d399;">
          <strong style="color: #34d399; font-size: 0.95rem;">Tuesday Maintenance Window</strong>
          <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 6px 0 0;">
            Servers restart every Tuesday around 18:00–20:00 UTC. New promo codes are distributed through the official group shout upon successful patch deployment.
          </p>
        </div>

        <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #38bdf8;">
          <strong style="color: #38bdf8; font-size: 0.95rem;">Upcoming Act 3 Abyss Expansion</strong>
          <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 6px 0 0;">
            The developer roadmap indicates Act 3: The Sunken Abyss will launch in late October, introducing Torment Raid tier IV and new Legendary equipment crafting sets.
          </p>
        </div>

        <div style="background: #0d0a14; padding: 16px; border-radius: 6px; border-left: 3px solid #f43f5e;">
          <strong style="color: #f43f5e; font-size: 0.95rem;">Balance Recalibration Policy</strong>
          <p style="color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 6px 0 0;">
            Any Super Class achieving over 55% representation in top Guild Raids receives targeted scaling adjustments to maintain viable archetype diversity.
          </p>
        </div>
      </div>
    </section>

    <!-- Frequently Asked Questions About Updates -->
    <section style="background: #161022; border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 36px;">
      <h2 id="frequently-asked-questions-updates-wipes" style="font-size: 1.3rem; color: #fff; margin: 0 0 16px;">Frequently Asked Questions: Updates & Wipes</h2>
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <div>
          <h3 id="do-weekly-updates-reset-character-levels-or-equipment" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">Do weekly updates reset character levels or equipment?</h3>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
            No. Pixel Lineage does not wipe character progression during weekly updates. All levels, unlocked Super Classes, and gear inventories persist permanently across builds.
          </p>
        </div>
        <div>
          <h3 id="what-happens-to-event-currencies-like-candy-when-an-event-ends" style="font-size: 1.05rem; color: #c9a227; margin: 0 0 6px;">What happens to event currencies like Candy when an event ends?</h3>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
            Event currencies are automatically converted into standard Gold at an exchange rate of 1 Candy = 15 Gold when event dungeons are archived.
          </p>
        </div>
      </div>
    </section>

    <!-- Navigation -->
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/codes/" style="background: #34d399; color: #0d0a14; padding: 12px 24px; border-radius: 6px; font-weight: 700; text-decoration: none;">
        Check Active Codes from Latest Patch →
      </a>
      <a href="/classes/super-classes/" style="background: #161022; border: 1px solid var(--line); color: var(--ink); padding: 12px 24px; border-radius: 6px; font-weight: 600; text-decoration: none;">
        18 Super Classes Guide →
      </a>
    </div>
  
            <!-- 页脚广告双位：桌面 728x90 / 移动 320x50，靠 .ad-slot-footer 做宽窄互斥 -->
      <div class="ad-slot-footer">
        <AdSlot zone="banner-728x90" className="ad-slot-wide" label="Sponsored Intel" />
        <AdSlot zone="banner-320x50" className="ad-slot-narrow" label="Sponsored Intel" />
      </div>

</article>

      <!-- Dual Sidebar V3 (ON THIS PAGE + EXPLORE THE WIKI) -->
      <DualSidebar tocHeadings={tocHeadings} currentUrl="/updates/" />
    </div></div>
</BaseLayout>
